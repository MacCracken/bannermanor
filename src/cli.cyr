# cli.cyr — bnrmr's command line, apart from main() itself: the flag
# table (cmdit, since 1.4.2), the parse-error diagnostics, font-name
# resolution, the --width / --pad / --align parsers, joining positionals
# under the 1 KB cap, --help, and --list-fonts.
#
# Split out of src/main.cyr at 1.4.1 so the suite can test it. main.cyr
# cannot be included by a test harness: it ends in a bare top-level
# `_agnos_entry();`, which runs at include time and exits the process.
# Until the split, nothing tested any of this, including
# build_font_path, the only containment on the CYML --font branch. The
# move was a pure move: the golden suite (scripts/golden.sh), which
# exercises every path below through the binary, is byte-identical
# across it. The one edit is that the --list-fonts printers write
# through layout's _emit / _write_spaces instead of raw
# `syscall(1, 1, ...)`.

include "src/render.cyr"
include "src/font_block.cyr"
include "src/fontpath.cyr"
include "lib/cmdit.cyr"
include "lib/fs.cyr"

# ---- the flag table ----
#
# Through 1.4.1 this was the stdlib table parser (lib/flags.cyr), built in
# main(). Since 1.4.2 it is cmdit, the same getopt-long core as a distlib
# (error codes 0..4 are flags.cyr's), built here so the suite can parse
# synthetic argv with it. What a valid or invalid command line does is
# pinned by the golden suite, which is byte-identical across the swap,
# including the grammar cases added for it (`parse-*`).
#
# What cmdit is NOT given, on purpose: validation. --width / --pad stay
# strings parsed by _parse_count_flag (cmdit_int would print `bad integer
# value` where audit B-001 pinned the `max` message), --align stays
# parse_align (cmdit_enum would reject it during the parse, ahead of
# --help / --list-fonts), and --color stays parse_color. Help is
# print_usage, never cmdit_help: that writes stderr, and --help is stdout.

# Indices of the registered flags, set by cli_flags(). cmdit registers
# --help / -h and --version itself; cmdit_parse reports those as
# CMDIT_HELP / CMDIT_VERSION, help first.
var CF_LIST = 0;
var CF_FONT = 0;
var CF_ALIGN = 0;
var CF_WIDTH = 0;
var CF_PAD = 0;
var CF_COLOR = 0;

# A fresh cmdit handle with bnrmr's flags registered, or 0 if allocation
# was refused (every cmdit call accepts 0 and reports CMDIT_ERR_NOMEM).
# One handle per parse: cmdit handles are single-parse.
fn cli_flags(): i64 {
    var fs = cmdit_new("bnrmr");
    if (fs == 0) { return 0; }
    # cmdit binds -V to --version by default. bnrmr never had -V, and the
    # freeze adds no flags (golden: parse-capital-v-is-not-version).
    cmdit_version_short(fs, 0);
    CF_LIST  = cmdit_bool(fs, 0,   "list-fonts", "list available fonts and exit");
    CF_FONT  = cmdit_str (fs, 102, "font",  0, "font name (default: embedded block)");  # 'f'
    CF_ALIGN = cmdit_str (fs, 0,   "align", 0, "left | center | right");
    CF_WIDTH = cmdit_str (fs, 119, "width", 0, "truncate at N columns (0 = unlimited)"); # 'w'
    CF_PAD   = cmdit_str (fs, 0,   "pad",   0, "N blank lines above and below");
    CF_COLOR = cmdit_str (fs, 0,   "color", 0, "name (red/cyan/...) or 'rainbow'");
    return fs;
}

# The diagnostic for a failed parse of handle `fs`, on stderr: one line,
# a blank line, the usage block. Returns 1, the exit code.
#
# 1.5.0 (issue 0016): the line names what the user typed, as cmdit's own
# cmdit_print_error does (`bnrmr: unknown flag: --bogus`). Through 1.4.2
# it said only `bnrmr: unknown flag`, on stdout. cmdit_print_error itself
# is not used: its echo escapes C0 and DEL but not C1 (0x80-0x9F), which
# bnrmr's control-byte rule covers (F-001), and its bundled-flag message
# does not mention `--`, which is what someone who typed `bnrmr -HI`
# needs. So the echo goes through _err_token: control bytes become '?',
# and anything past 64 bytes is cut with "...".
fn report_parse_error(fs): i64 {
    var code = cmdit_error(fs);
    var tok = cmdit_err_token(fs);
    var buf[512];
    var p = &buf;
    var n = _cat(p, 0, "bnrmr: ");
    if (code == CMDIT_ERR_UNKNOWN) {
        n = _cat(p, n, "unknown flag: ");
        n = _err_token(p, n, tok);
    } else {
        if (code == CMDIT_ERR_MISSING_VALUE) {
            n = _err_token(p, n, tok);
            n = _cat(p, n, ": missing value");
        } else {
            if (code == CMDIT_ERR_BAD_INT) {
                n = _err_token(p, n, tok);
                n = _cat(p, n, ": not a number");
            } else {
                if (code == CMDIT_ERR_BUNDLED) {
                    n = _err_token(p, n, tok);
                    n = _cat(p, n, ": bundled short flags are not supported");
                    n = _cat(p, n, " (write -x -y; put -- before text that starts with -)");
                } else {
                    if (code == CMDIT_ERR_UNEXPECTED_VALUE) {
                        n = _err_token(p, n, tok);
                        n = _cat(p, n, ": this flag takes no value");
                    } else {
                        if (code == CMDIT_ERR_ARGV) {
                            n = _cat(p, n, "could not read the whole command line");
                        } else {
                            if (code == CMDIT_ERR_NOMEM) {
                                n = _cat(p, n, "out of memory");
                            } else {
                                n = _cat(p, n, "argument parse error");
                            }
                        }
                    }
                }
            }
        }
    }
    store8(p + n, 10);
    store8(p + n + 1, 10);
    file_write(2, p, n + 2);            # the line and the blank line, one write
    print_usage_err();
    return 1;
}

# The stderr line for a --font NAME that did not load, by font_resolve's
# answer. Returns 1. Through 1.5.0 one line covered both cases ("failed
# to load font (missing or malformed)"); since 1.6.0 the search path makes
# the difference worth saying (ADR 0003):
#   bnrmr: font 'X' not found (searched: ./fonts, /usr/share/... (missing))
#   bnrmr: font 'X' is malformed: ./fonts/X.cyml
# The name passed font_name_ok, so it holds no control byte; the path and
# the directories are scrubbed on the way out.
fn report_font_error(name, where, path): i64 {
    var line[8192];
    var p = &line;
    var n = _cat(p, 0, "bnrmr: font '");
    n = _cat(p, n, name);
    if (where == FP_FOUND) {
        n = _cat(p, n, "' is malformed: ");
        var pl = strlen(path);
        var k = 0;
        while (k < pl && n < 8000) {
            var b = load8(path + k);
            if (_scrub_ctl(b) != b) { b = 63; }
            store8(p + n, b);
            n = n + 1;
            k = k + 1;
        }
    } else {
        n = _cat(p, n, "' not found (searched: ");
        n = fontpath_describe(p, n, 8000);
        n = _cat(p, n, ")");
    }
    store8(p + n, 0);
    _err_line(p);
    return 1;
}

# Append cstring `s` to buf at `n`; return the new length.
fn _cat(buf, n, s): i64 {
    var sl = strlen(s);
    memcpy(buf + n, s, sl);
    return n + sl;
}

# Append an argv token for a diagnostic: control bytes (C0, DEL, C1) as
# '?', at most 64 bytes, then "..." if it was longer. A 0 token appends
# "(none)".
fn _err_token(buf, n, tok): i64 {
    if (tok == 0) { return _cat(buf, n, "(none)"); }
    var i = 0;
    var b = load8(tok);
    while (b != 0 && i < 64) {
        if (_scrub_ctl(b) != b) { b = 63; }
        store8(buf + n + i, b);
        i = i + 1;
        b = load8(tok + i);
    }
    n = n + i;
    if (b != 0) { n = _cat(buf, n, "..."); }
    return n;
}

# Does `name` end in ".flf"? Used to dispatch --font to the legacy
# figlet-font adapter (src/flf.cyr) instead of the CYML loader.
# When true, the name is treated as a literal path — no path-segment
# sanitization (the user explicitly opted into a path with the .flf
# suffix; size is bounded inside flf_load_file).
fn _is_flf_path(name): i64 {
    var n = strlen(name);
    if (n < 5) { return 0; }
    return memeq(name + n - 4, ".flf", 4);
}

# The usage block, composed into one buffer and written with one write:
# to stdout for --help and a bare `bnrmr` (both exit 0), to stderr after
# a parse error (1.5.0, issue 0016: the usage that follows an error goes
# where the error went, so `bnrmr --typo > /etc/motd` leaves the file
# empty).
var _ub_buf = 0;
var _ub_len = 0;

fn _ub(s): i64 {
    var n = strlen(s);
    memcpy(_ub_buf + _ub_len, s, n);
    store8(_ub_buf + _ub_len + n, 10);
    _ub_len = _ub_len + n + 1;
    return 0;
}

fn _usage_to(fd): i64 {
    var buf[4096];
    _ub_buf = &buf;
    _ub_len = 0;
    _ub("bnrmr — figlet-equivalent ASCII-art banner generator");
    _ub("");
    _ub("Usage:");
    _ub("  bnrmr [FLAGS] TEXT...");
    _ub("");
    _ub("Flags:");
    _ub("  -f, --font NAME       NAME.cyml from $BNRMR_FONTS, ./fonts or the");
    _ub("                        install's share/bannermanor/fonts (block is");
    _ub("                        built in), or a path ending in .flf for a");
    _ub("                        legacy figlet font (default: block)");
    _ub("      --align V         left | center | right (default: left)");
    _ub("  -w, --width N         truncate at glyph boundary at N columns");
    _ub("                        (default: 0 = unlimited; if N is smaller");
    _ub("                        than one glyph, no glyphs render — the");
    _ub("                        banner comes out as blank rows)");
    _ub("      --pad N           N blank lines above and below banner (default: 0)");
    _ub("      --color NAME      colorize: black, red, green, yellow, blue,");
    _ub("                        magenta, cyan, white (or bright_<name> /");
    _ub("                        bright-<name>), or 'rainbow'");
    _ub("                        for per-row cycling. Suppressed on non-TTY stdout.");
    _ub("      --list-fonts      list the fonts --font can find, and where it");
    _ub("                        looked, and exit");
    _ub("      --version         print version and exit");
    _ub("  -h, --help            print this help and exit");
    _ub("      --                end of flags: everything after it is TEXT,");
    _ub("                        even a word starting with '-' (bnrmr -- -HI)");
    _ub("");
    _ub("Coverage: A-Z, 0-9, space, printable punctuation. Lowercase folds");
    _ub("to uppercase when the font has no lowercase glyphs. Unsupported");
    _ub("characters render as blank.");
    _ub("");
    _ub("Errors go to stderr with exit status 1, as does a failed write.");
    _ub("See bnrmr(1) for the font search path and environment.");
    if (fd == 1) { return _emit(&buf, _ub_len); }
    file_write(fd, &buf, _ub_len);
    return 0;
}

# --help, and the usage a bare `bnrmr` prints: stdout, checked.
fn print_usage(): i64 {
    return _usage_to(1);
}

# The usage after a parse error: stderr.
fn print_usage_err(): i64 {
    return _usage_to(2);
}

# Lexicographic Str compare (byte-wise). Returns <0 / 0 / >0.
fn _str_lex_cmp(a, b): i64 {
    var al = str_len(a);
    var bl = str_len(b);
    var ad = str_data(a);
    var bd = str_data(b);
    var n = al;
    if (bl < n) { n = bl; }
    var i = 0;
    while (i < n) {
        var ac = load8(ad + i);
        var bc = load8(bd + i);
        if (ac != bc) { return ac - bc; }
        i = i + 1;
    }
    return al - bl;
}

# Insertion sort vec of Str in place. Fine for 3–5 fonts.
fn _sort_paths(v): i64 {
    var n = vec_len(v);
    var i = 1;
    while (i < n) {
        var cur = vec_get(v, i);
        var j = i - 1;
        var done = 0;
        while (j >= 0 && done == 0) {
            var prev = vec_get(v, j);
            if (_str_lex_cmp(prev, cur) > 0) {
                vec_set(v, j + 1, prev);
                j = j - 1;
            } else { done = 1; }
        }
        vec_set(v, j + 1, cur);
        i = i + 1;
    }
    return 0;
}

# Write `n` bytes of `buf` to stdout with control bytes folded to
# spaces (F-012). Mirrors _scrub_ctl in src/font.cyr; used for strings
# that reach stdout without passing through the font parser.
fn _write_scrubbed(buf, n): i64 {
    # Emit maximal runs of clean bytes directly from the caller's buffer
    # and substitute a literal space for each control byte. No scratch
    # buffer, and the common all-clean case costs one write.
    var i = 0;
    var run = 0;
    while (i < n) {
        var b = load8(buf + i);
        var bad = 0;
        if (b < 32) { bad = 1; }
        if (b == 127) { bad = 1; }
        if (b >= 128 && b <= 159) { bad = 1; }
        if (bad == 1) {
            if (run > 0) { _emit(buf + i - run, run); run = 0; }
            _emit(" ", 1);
        } else {
            run = run + 1;
        }
        i = i + 1;
    }
    if (run > 0) { _emit(buf + n - run, run); }
    return 0;
}

# Print a cstring padded with trailing spaces to width `w`. If the
# cstring is already >= w bytes, prints it as-is followed by a single
# space (so adjacent columns don't collide).
fn _print_padded(cstr, w): i64 {
    var n = strlen(cstr);
    _emit(cstr, n);
    if (n >= w) {
        _emit(" ", 1);
        return 0;
    }
    _write_spaces(w - n);
    return 0;
}

# A non-negative integer in decimal, to stdout through _emit (so it is
# checked like every other stdout byte). Replaces lib/fmt.cyr's fmt_int,
# which writes on its own. darshana's tty_dec_buf formats it.
fn _emit_int(v): i64 {
    var b[24];
    var e = tty_dec_buf(&b, 0, v);
    if (e < 0) { return 0 - 1; }
    return _emit(&b, e);
}

# ---- --list-fonts (rewritten 1.6.0, ADR 0003) ----
#
# Lists exactly what `--font NAME` accepts:
#   - every directory on the search path (fontpath.cyr), read one level
#     deep with dir_list. The walk through 1.5.0 recursed 64 levels, and
#     a nested font listed under a name no spelling could load (A-12);
#   - each font by its file STEM, the spelling --font takes. Through
#     1.5.0 the listing showed the `name` field, which --font never reads
#     (A-11);
#   - checked with the full loader, so a font whose glyph body is broken
#     is reported, not listed clean;
#   - the first directory to define a stem wins, as in a lookup;
#   - the built-in block font, when no block.cyml shadows it.
# Rows are sorted by stem, the name column is one past the widest stem
# (at least 10, the old fixed width, so a listing of short names is
# unchanged), and the last line names the directories searched.
#
# A row is an alloc'd LR_SIZE record.
enum ListRow {
    LR_STEM = 0;              # cstring: the --font spelling
    LR_KIND = 8;              # LK_*
    LR_PATH = 16;             # cstring: the file, for a skipped row
    LR_W = 24;
    LR_H = 32;
    LR_GAP = 40;
    LR_DESC = 48;             # cstring, possibly empty
    LR_SIZE = 56;
}

enum ListKind {
    LK_FONT = 0;
    LK_BUILTIN = 1;
    LK_MALFORMED = 2;
    LK_UNNAMED = 3;           # a stem --font cannot spell
}

fn _lr_new(stem, kind, path): i64 {
    var r = alloc(LR_SIZE);
    if (r == 0) { return 0; }
    store64(r + LR_STEM, stem);
    store64(r + LR_KIND, kind);
    store64(r + LR_PATH, path);
    store64(r + LR_W, 0);
    store64(r + LR_H, 0);
    store64(r + LR_GAP, 0);
    store64(r + LR_DESC, "");
    return r;
}

# Copy buf[0..n) to a fresh NUL-terminated cstring.
fn _cdup(buf, n): i64 {
    var c = alloc(n + 1);
    if (c == 0) { return 0; }
    memcpy(c, buf, n);
    store8(c + n, 0);
    return c;
}

# Has `stem` been listed already?
fn _lr_seen(rows, stem): i64 {
    var i = 0;
    var n = vec_len(rows);
    while (i < n) {
        if (streq(load64(vec_get(rows, i) + LR_STEM), stem) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Insertion sort of row records by stem, bytewise.
fn _lr_sort(rows): i64 {
    var n = vec_len(rows);
    var i = 1;
    while (i < n) {
        var cur = vec_get(rows, i);
        var cs = str_from(load64(cur + LR_STEM));
        var j = i - 1;
        var done = 0;
        while (j >= 0 && done == 0) {
            var prev = vec_get(rows, j);
            if (_str_lex_cmp(str_from(load64(prev + LR_STEM)), cs) > 0) {
                vec_set(rows, j + 1, prev);
                j = j - 1;
            } else { done = 1; }
        }
        vec_set(rows, j + 1, cur);
        i = i + 1;
    }
    return 0;
}

# Add the rows for one search directory. Its entries are sorted so a
# directory holding both a.cyml and a stem collision is read in a fixed
# order. Returns 0, or -1 if the directory could not be read.
fn _lr_scan_dir(rows, dir): i64 {
    var entries = vec_new();
    if (dir_list_checked(str_from(dir), entries) < 0) { return 0 - 1; }
    _sort_paths(entries);
    var path[4200];
    var i = 0;
    var ne = vec_len(entries);
    while (i < ne) {
        var e = vec_get(entries, i);
        var el = str_len(e);
        var ed = str_data(e);
        if (el > 5 && memeq(ed + el - 5, ".cyml", 5) == 1) {
            var stem = _cdup(ed, el - 5);
            if (stem != 0 && _lr_seen(rows, stem) == 0) {
                var dl = strlen(dir);
                var pl = dl + 1 + el;
                var full = alloc(pl + 1);
                memcpy(full, dir, dl);
                store8(full + dl, 47);
                memcpy(full + dl + 1, ed, el);
                store8(full + pl, 0);
                if (font_name_ok(stem) == 0) {
                    vec_push(rows, _lr_new(stem, LK_UNNAMED, full));
                } else {
                    var f = font_load_file(full);
                    if (f == 0) {
                        vec_push(rows, _lr_new(stem, LK_MALFORMED, full));
                    } else {
                        var r = _lr_new(stem, LK_FONT, full);
                        store64(r + LR_W, font_width(f));
                        store64(r + LR_H, font_height(f));
                        store64(r + LR_GAP, font_gap(f));
                        # The full loader passed, so the header loader does
                        # too; it supplies the (scrubbed) description.
                        var h = font_header_load(full);
                        if (h != 0) { store64(r + LR_DESC, font_hdr_desc(h)); }
                        vec_push(rows, r);
                    }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

fn cmd_list_fonts(): i64 {
    if (fontpath_setup() != 0) {
        _err_line("bnrmr: BNRMR_FONTS is not a usable directory path");
        return 1;
    }
    var rows = vec_new();
    var nd = fontpath_count();
    var unreadable = vec_new();
    var di = 0;
    while (di < nd) {
        var d = fontpath_dir(di);
        var st[144];
        if (xstat(d, &st) == 0) {
            if (_lr_scan_dir(rows, d) != 0) { vec_push(unreadable, d); }
        }
        di = di + 1;
    }
    if (_lr_seen(rows, "block") == 0) {
        var b = _lr_new("block", LK_BUILTIN, 0);
        var ef = block_font_embed();
        if (b != 0 && ef != 0) {
            store64(b + LR_W, font_width(ef));
            store64(b + LR_H, font_height(ef));
            store64(b + LR_GAP, font_gap(ef));
            store64(b + LR_DESC, "built in: the default font");
            vec_push(rows, b);
        }
    }
    _lr_sort(rows);

    var col = 10;
    var nr = vec_len(rows);
    var i = 0;
    while (i < nr) {
        var sl = strlen(load64(vec_get(rows, i) + LR_STEM));
        # One column past the widest name, so it is padded like the rest
        # (_print_padded gives a name at or past the width one space).
        if (load64(vec_get(rows, i) + LR_KIND) <= LK_BUILTIN && sl + 1 > col) { col = sl + 1; }
        i = i + 1;
    }

    _emit_line("Available fonts (--font NAME):");
    _emit_line("");
    i = 0;
    while (i < nr) {
        var r = vec_get(rows, i);
        var kind = load64(r + LR_KIND);
        _emit("  ", 2);
        if (kind <= LK_BUILTIN) {
            _print_padded(load64(r + LR_STEM), col);
            _emit(" ", 1);
            _emit_int(load64(r + LR_W));
            _emit("x", 1);
            _emit_int(load64(r + LR_H));
            _emit(" gap=", 5);
            _emit_int(load64(r + LR_GAP));
            _emit("  ", 2);
            var desc = load64(r + LR_DESC);
            _emit(desc, strlen(desc));
            _emit("\n", 1);
        } else {
            # Scrub the path before echoing it (F-012): the bytes come
            # straight from the filesystem, and a file named
            # "ev<ESC>[31mil.cyml" would otherwise emit live SGR.
            var fp = load64(r + LR_PATH);
            _write_scrubbed(fp, strlen(fp));
            if (kind == LK_MALFORMED) { _emit_line("  (malformed — skipped)"); }
            else { _emit_line("  (--font cannot spell this name — skipped)"); }
        }
        i = i + 1;
    }

    var line[8192];
    var n = _cat(&line, 0, "Searched: ");
    n = fontpath_describe(&line, n, 8000);
    var nu = vec_len(unreadable);
    if (nu > 0) { n = _cat(&line, n, " (unreadable: "); }
    var u = 0;
    while (u < nu && n < 7900) {
        if (u > 0) { n = _cat(&line, n, ", "); }
        n = _err_token(&line, n, vec_get(unreadable, u));
        u = u + 1;
    }
    if (nu > 0) { n = _cat(&line, n, ")"); }
    store8(&line + n, 0);
    _emit_line("");
    _emit_line(&line);
    return 0;
}

# Map --align value cstring to AlignKind. Returns -1 if unrecognized.
fn parse_align(s): i64 {
    if (s == 0) { return ALIGN_LEFT; }
    if (streq(s, "left") == 1) { return ALIGN_LEFT; }
    if (streq(s, "L") == 1)    { return ALIGN_LEFT; }
    if (streq(s, "center") == 1) { return ALIGN_CENTER; }
    if (streq(s, "centre") == 1) { return ALIGN_CENTER; }
    if (streq(s, "C") == 1)      { return ALIGN_CENTER; }
    if (streq(s, "right") == 1) { return ALIGN_RIGHT; }
    if (streq(s, "R") == 1)     { return ALIGN_RIGHT; }
    return 0 - 1;
}

# Concatenate the parsed positionals (cmdit_positional(fs, 0..n-1)) into
# out, separated by spaces. Returns bytes written, or -1 on overflow.
fn join_positionals(out, out_cap, fs): i64 {
    var pc = cmdit_positional_count(fs);
    var n: i64 = 0;
    var i = 0;
    while (i < pc) {
        var arg = cmdit_positional(fs, i);
        var alen = strlen(arg);
        if (n > 0) {
            if (n + 1 > out_cap) { return 0 - 1; }
            store8(out + n, 32);
            n = n + 1;
        }
        if (n + alen > out_cap) { return 0 - 1; }
        memcpy(out + n, arg, alen);
        n = n + alen;
        i = i + 1;
    }
    return n;
}

# _parse_count_flag sentinels (negative, so they cannot collide with a
# parsed count). Written inline as `0 - N` per this file's existing
# convention — cyrius enum members take literals only.
#
#   0 - 2  COUNT_BAD   empty, or contains a non-digit
#   0 - 3  COUNT_NEG   a real negative (leading '-', nonzero)
#   0 - 4  COUNT_OVER  all-digit but past PARSER_INT_CAP

# Parse a --width/--pad token. Returns the value, or a COUNT_* sentinel.
#
# Absent flag -> 0 (the pre-1.1.4 default from flags_get_int).
# "-0"/"-00"  -> 0, which the stdlib's _flags_parse_int accepted before
#                1.1.4, so keep it.
# "007"       -> 7; leading zeros worked before and must keep working.
# huge digits -> COUNT_OVER so the caller still prints its `max` message
#                rather than a generic parse error (matches the
#                pre-1.1.4 behavior of `--width 1048577`).
fn _parse_count_flag(tok): i64 {
    if (tok == 0) { return 0; }
    var p = tok;
    var neg = 0;
    if (load8(p) == 45) { neg = 1; p = p + 1; }     # '-'
    var n = parse_uint(p);
    if (n < 0) {
        # Distinguish "too big" from "not a number": re-scan for digits.
        var i = 0;
        var alldigit = 1;
        var any = 0;
        var c = load8(p);
        while (c != 0) {
            if (c < 48 || c > 57) { alldigit = 0; }
            any = 1;
            i = i + 1;
            c = load8(p + i);
        }
        if (any == 1 && alldigit == 1) { return 0 - 4; }
        return 0 - 2;
    }
    if (neg == 1) {
        if (n == 0) { return 0; }                   # "-0" == 0
        return 0 - 3;
    }
    return n;
}
