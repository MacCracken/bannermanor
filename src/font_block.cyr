# font_block.cyr — embedded "block" font (5×5).
#
# Same data as `fonts/block.cyml`, built into a Font* at runtime via
# `block_font_embed()`. This is the default font used when no `--font`
# flag is passed, satisfying the CLAUDE.md self-contained rule
# ("a user can `bnrmr "hello"` with zero config files").
#
# Drift discipline: if you change either this file or fonts/block.cyml,
# update the other in the same commit. The M2 acceptance test compares
# the two side-by-side to catch drift.

include "src/font.cyr"

# Return the 5-byte row for (glyph_idx, row) using inline literals.
# Background is space (32); stroke is '#'. Lifted verbatim from the
# pre-M2 hardcoded font; the only change is that the renderer no longer
# touches this fn directly — it goes through Font* via `block_font_embed`.
fn _block_raw_row(glyph_idx, row): i64 {
    var i = glyph_idx;
    var r = row;

    # space
    if (i == 0) {
        if (r == 0) { return "     "; }
        if (r == 1) { return "     "; }
        if (r == 2) { return "     "; }
        if (r == 3) { return "     "; }
        return "     ";
    }
    # 0
    if (i == 1) {
        if (r == 0) { return " ### "; }
        if (r == 1) { return "#  ##"; }
        if (r == 2) { return "# # #"; }
        if (r == 3) { return "##  #"; }
        return " ### ";
    }
    # 1
    if (i == 2) {
        if (r == 0) { return "  #  "; }
        if (r == 1) { return " ##  "; }
        if (r == 2) { return "  #  "; }
        if (r == 3) { return "  #  "; }
        return " ### ";
    }
    # 2
    if (i == 3) {
        if (r == 0) { return " ### "; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return "   # "; }
        if (r == 3) { return "  #  "; }
        return "#####";
    }
    # 3
    if (i == 4) {
        if (r == 0) { return " ### "; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return "  ## "; }
        if (r == 3) { return "#   #"; }
        return " ### ";
    }
    # 4
    if (i == 5) {
        if (r == 0) { return "#  # "; }
        if (r == 1) { return "#  # "; }
        if (r == 2) { return "#####"; }
        if (r == 3) { return "   # "; }
        return "   # ";
    }
    # 5
    if (i == 6) {
        if (r == 0) { return "#####"; }
        if (r == 1) { return "#    "; }
        if (r == 2) { return "#### "; }
        if (r == 3) { return "    #"; }
        return "#### ";
    }
    # 6
    if (i == 7) {
        if (r == 0) { return " ### "; }
        if (r == 1) { return "#    "; }
        if (r == 2) { return "#### "; }
        if (r == 3) { return "#   #"; }
        return " ### ";
    }
    # 7
    if (i == 8) {
        if (r == 0) { return "#####"; }
        if (r == 1) { return "   # "; }
        if (r == 2) { return "  #  "; }
        if (r == 3) { return " #   "; }
        return " #   ";
    }
    # 8
    if (i == 9) {
        if (r == 0) { return " ### "; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return " ### "; }
        if (r == 3) { return "#   #"; }
        return " ### ";
    }
    # 9
    if (i == 10) {
        if (r == 0) { return " ### "; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return " ####"; }
        if (r == 3) { return "    #"; }
        return " ### ";
    }
    # A
    if (i == 11) {
        if (r == 0) { return " ### "; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return "#####"; }
        if (r == 3) { return "#   #"; }
        return "#   #";
    }
    # B
    if (i == 12) {
        if (r == 0) { return "#### "; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return "#### "; }
        if (r == 3) { return "#   #"; }
        return "#### ";
    }
    # C
    if (i == 13) {
        if (r == 0) { return " ####"; }
        if (r == 1) { return "#    "; }
        if (r == 2) { return "#    "; }
        if (r == 3) { return "#    "; }
        return " ####";
    }
    # D
    if (i == 14) {
        if (r == 0) { return "#### "; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return "#   #"; }
        if (r == 3) { return "#   #"; }
        return "#### ";
    }
    # E
    if (i == 15) {
        if (r == 0) { return "#####"; }
        if (r == 1) { return "#    "; }
        if (r == 2) { return "#### "; }
        if (r == 3) { return "#    "; }
        return "#####";
    }
    # F
    if (i == 16) {
        if (r == 0) { return "#####"; }
        if (r == 1) { return "#    "; }
        if (r == 2) { return "#### "; }
        if (r == 3) { return "#    "; }
        return "#    ";
    }
    # G
    if (i == 17) {
        if (r == 0) { return " ####"; }
        if (r == 1) { return "#    "; }
        if (r == 2) { return "#  ##"; }
        if (r == 3) { return "#   #"; }
        return " ####";
    }
    # H
    if (i == 18) {
        if (r == 0) { return "#   #"; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return "#####"; }
        if (r == 3) { return "#   #"; }
        return "#   #";
    }
    # I
    if (i == 19) {
        if (r == 0) { return "#####"; }
        if (r == 1) { return "  #  "; }
        if (r == 2) { return "  #  "; }
        if (r == 3) { return "  #  "; }
        return "#####";
    }
    # J
    if (i == 20) {
        if (r == 0) { return "#####"; }
        if (r == 1) { return "   # "; }
        if (r == 2) { return "   # "; }
        if (r == 3) { return "#  # "; }
        return " ##  ";
    }
    # K
    if (i == 21) {
        if (r == 0) { return "#   #"; }
        if (r == 1) { return "#  # "; }
        if (r == 2) { return "###  "; }
        if (r == 3) { return "#  # "; }
        return "#   #";
    }
    # L
    if (i == 22) {
        if (r == 0) { return "#    "; }
        if (r == 1) { return "#    "; }
        if (r == 2) { return "#    "; }
        if (r == 3) { return "#    "; }
        return "#####";
    }
    # M
    if (i == 23) {
        if (r == 0) { return "#   #"; }
        if (r == 1) { return "## ##"; }
        if (r == 2) { return "# # #"; }
        if (r == 3) { return "#   #"; }
        return "#   #";
    }
    # N
    if (i == 24) {
        if (r == 0) { return "#   #"; }
        if (r == 1) { return "##  #"; }
        if (r == 2) { return "# # #"; }
        if (r == 3) { return "#  ##"; }
        return "#   #";
    }
    # O
    if (i == 25) {
        if (r == 0) { return " ### "; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return "#   #"; }
        if (r == 3) { return "#   #"; }
        return " ### ";
    }
    # P
    if (i == 26) {
        if (r == 0) { return "#### "; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return "#### "; }
        if (r == 3) { return "#    "; }
        return "#    ";
    }
    # Q
    if (i == 27) {
        if (r == 0) { return " ### "; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return "#   #"; }
        if (r == 3) { return "#  # "; }
        return " ## #";
    }
    # R
    if (i == 28) {
        if (r == 0) { return "#### "; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return "#### "; }
        if (r == 3) { return "#  # "; }
        return "#   #";
    }
    # S
    if (i == 29) {
        if (r == 0) { return " ####"; }
        if (r == 1) { return "#    "; }
        if (r == 2) { return " ### "; }
        if (r == 3) { return "    #"; }
        return "#### ";
    }
    # T
    if (i == 30) {
        if (r == 0) { return "#####"; }
        if (r == 1) { return "  #  "; }
        if (r == 2) { return "  #  "; }
        if (r == 3) { return "  #  "; }
        return "  #  ";
    }
    # U
    if (i == 31) {
        if (r == 0) { return "#   #"; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return "#   #"; }
        if (r == 3) { return "#   #"; }
        return " ### ";
    }
    # V
    if (i == 32) {
        if (r == 0) { return "#   #"; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return "#   #"; }
        if (r == 3) { return " # # "; }
        return "  #  ";
    }
    # W
    if (i == 33) {
        if (r == 0) { return "#   #"; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return "# # #"; }
        if (r == 3) { return "## ##"; }
        return "#   #";
    }
    # X
    if (i == 34) {
        if (r == 0) { return "#   #"; }
        if (r == 1) { return " # # "; }
        if (r == 2) { return "  #  "; }
        if (r == 3) { return " # # "; }
        return "#   #";
    }
    # Y
    if (i == 35) {
        if (r == 0) { return "#   #"; }
        if (r == 1) { return " # # "; }
        if (r == 2) { return "  #  "; }
        if (r == 3) { return "  #  "; }
        return "  #  ";
    }
    # Z
    if (i == 36) {
        if (r == 0) { return "#####"; }
        if (r == 1) { return "   # "; }
        if (r == 2) { return "  #  "; }
        if (r == 3) { return " #   "; }
        return "#####";
    }
    return "     ";
}

# Char (ASCII byte) for glyph index in the embedded order:
# 0 = ' ', 1..10 = '0'..'9', 11..36 = 'A'..'Z'.
fn _block_glyph_char(i): i64 {
    if (i == 0) { return 32; }
    if (i <= 10) { return 47 + i; }      # '0'..'9'
    return 54 + i;                       # 'A'..'Z'
}

# Build the embedded Font* from the inline glyph data above. Cached
# so repeated calls are cheap.
var _block_font_cache = 0;

fn block_font_embed(): i64 {
    if (_block_font_cache != 0) { return _block_font_cache; }
    var f = font_new(5, 5, 1, 37);
    if (f == 0) { return 0; }
    var i = 0;
    while (i < 37) {
        font_set_char(f, i, _block_glyph_char(i));
        var r = 0;
        while (r < 5) {
            font_set_row(f, i, r, _block_raw_row(i, r));
            r = r + 1;
        }
        i = i + 1;
    }
    _block_font_cache = f;
    return f;
}
