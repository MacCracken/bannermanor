    # Q
    if (i == 27) {
        if (r == 0) { return " ### "; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return "#   #"; }
        if (r == 3) { return "#  # "; }
        return " ## #";
    }
    # R
    if (i == 28) {
        if (r == 0) { return "#### "; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return "#### "; }
        if (r == 3) { return "#  # "; }
        return "#   #";
    }
    # S
    if (i == 29) {
        if (r == 0) { return " ####"; }
        if (r == 1) { return "#    "; }
        if (r == 2) { return " ### "; }
        if (r == 3) { return "    #"; }
        return "#### ";
    }
    # T
    if (i == 30) {
        if (r == 0) { return "#####"; }
        if (r == 1) { return "  #  "; }
        if (r == 2) { return "  #  "; }
        if (r == 3) { return "  #  "; }
        return "  #  ";
