# font_block.cyr — embedded "block" font (5×5).
#
# Same data as `fonts/block.cyml`, built into a Font* at runtime via
# `block_font_embed()`. This is the default font used when no `--font`
# flag is passed, satisfying the CLAUDE.md self-contained rule
# ("a user can `bnrmr "hello"` with zero config files").
#
# Drift discipline: if you change either this file or fonts/block.cyml,
# update the other in the same commit. The M2 acceptance test compares
# the two side-by-side to catch drift.

include "src/font.cyr"

# Return the 5-byte row for (glyph_idx, row) using inline literals.
# Background is space (32); stroke is '#'. Lifted verbatim from the
# pre-M2 hardcoded font; the only change is that the renderer no longer
# touches this fn directly — it goes through Font* via `block_font_embed`.
#
# Split into two helpers: cycc caps a function at 256 returns, and 69
# glyphs × 5 rows = 345 returns would exceed that. `_block_raw_row_lo`
# covers space + 0-9 + A-Z (idx 0..36); `_block_raw_row_hi` covers the
# punctuation block (idx 37..68).
fn _block_raw_row(glyph_idx, row): i64 {
    if (glyph_idx <= 36) {
        return _block_raw_row_lo(glyph_idx, row);
    }
    return _block_raw_row_hi(glyph_idx, row);
}

fn _block_raw_row_lo(glyph_idx, row): i64 {
    var i = glyph_idx;
    var r = row;

    # space
    if (i == 0) {
        if (r == 0) { return "     "; }
        if (r == 1) { return "     "; }
        if (r == 2) { return "     "; }
        if (r == 3) { return "     "; }
        return "     ";
    }
    # 0
    if (i == 1) {
        if (r == 0) { return " ### "; }
        if (r == 1) { return "#  ##"; }
        if (r == 2) { return "# # #"; }
        if (r == 3) { return "##  #"; }
        return " ### ";
    }
    # 1
    if (i == 2) {
        if (r == 0) { return "  #  "; }
        if (r == 1) { return " ##  "; }
        if (r == 2) { return "  #  "; }
        if (r == 3) { return "  #  "; }
        return " ### ";
    }
    # 2
    if (i == 3) {
        if (r == 0) { return " ### "; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return "   # "; }
        if (r == 3) { return "  #  "; }
        return "#####";
    }
    # 3
    if (i == 4) {
        if (r == 0) { return " ### "; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return "  ## "; }
        if (r == 3) { return "#   #"; }
        return " ### ";
    }
    # 4
    if (i == 5) {
        if (r == 0) { return "#  # "; }
        if (r == 1) { return "#  # "; }
        if (r == 2) { return "#####"; }
        if (r == 3) { return "   # "; }
        return "   # ";
    }
    # 5
    if (i == 6) {
        if (r == 0) { return "#####"; }
        if (r == 1) { return "#    "; }
        if (r == 2) { return "#### "; }
        if (r == 3) { return "    #"; }
        return "#### ";
    }
    # 6
    if (i == 7) {
        if (r == 0) { return " ### "; }
        if (r == 1) { return "#    "; }
        if (r == 2) { return "#### "; }
        if (r == 3) { return "#   #"; }
        return " ### ";
    }
    # 7
    if (i == 8) {
        if (r == 0) { return "#####"; }
        if (r == 1) { return "   # "; }
        if (r == 2) { return "  #  "; }
        if (r == 3) { return " #   "; }
        return " #   ";
    }
    # 8
    if (i == 9) {
        if (r == 0) { return " ### "; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return " ### "; }
        if (r == 3) { return "#   #"; }
        return " ### ";
    }
    # 9
    if (i == 10) {
        if (r == 0) { return " ### "; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return " ####"; }
        if (r == 3) { return "    #"; }
        return " ### ";
    }
    # A
    if (i == 11) {
        if (r == 0) { return " ### "; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return "#####"; }
        if (r == 3) { return "#   #"; }
        return "#   #";
    }
    # B
    if (i == 12) {
        if (r == 0) { return "#### "; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return "#### "; }
        if (r == 3) { return "#   #"; }
        return "#### ";
    }
    # C
    if (i == 13) {
        if (r == 0) { return " ####"; }
        if (r == 1) { return "#    "; }
        if (r == 2) { return "#    "; }
        if (r == 3) { return "#    "; }
        return " ####";
    }
    # D
    if (i == 14) {
        if (r == 0) { return "#### "; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return "#   #"; }
        if (r == 3) { return "#   #"; }
        return "#### ";
    }
    # E
    if (i == 15) {
        if (r == 0) { return "#####"; }
        if (r == 1) { return "#    "; }
        if (r == 2) { return "#### "; }
        if (r == 3) { return "#    "; }
        return "#####";
    }
    # F
    if (i == 16) {
        if (r == 0) { return "#####"; }
        if (r == 1) { return "#    "; }
        if (r == 2) { return "#### "; }
        if (r == 3) { return "#    "; }
        return "#    ";
    }
    # G
    if (i == 17) {
        if (r == 0) { return " ####"; }
        if (r == 1) { return "#    "; }
        if (r == 2) { return "#  ##"; }
        if (r == 3) { return "#   #"; }
        return " ####";
