    # L
    if (i == 22) {
        if (r == 0) { return "#    "; }
        if (r == 1) { return "#    "; }
        if (r == 2) { return "#    "; }
        if (r == 3) { return "#    "; }
        return "#####";
    }
    # M
    if (i == 23) {
        if (r == 0) { return "#   #"; }
        if (r == 1) { return "## ##"; }
        if (r == 2) { return "# # #"; }
        if (r == 3) { return "#   #"; }
        return "#   #";
    }
    # N
    if (i == 24) {
        if (r == 0) { return "#   #"; }
        if (r == 1) { return "##  #"; }
        if (r == 2) { return "# # #"; }
        if (r == 3) { return "#  ##"; }
        return "#   #";
    }
    # O
    if (i == 25) {
        if (r == 0) { return " ### "; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return "#   #"; }
        if (r == 3) { return "#   #"; }
        return " ### ";
    }
    # P
    if (i == 26) {
        if (r == 0) { return "#### "; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return "#### "; }
