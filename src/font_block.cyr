    # H
    if (i == 18) {
        if (r == 0) { return "#   #"; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return "#####"; }
        if (r == 3) { return "#   #"; }
        return "#   #";
    }
    # I
    if (i == 19) {
        if (r == 0) { return "#####"; }
        if (r == 1) { return "  #  "; }
        if (r == 2) { return "  #  "; }
        if (r == 3) { return "  #  "; }
        return "#####";
    }
    # J
    if (i == 20) {
        if (r == 0) { return "#####"; }
        if (r == 1) { return "   # "; }
        if (r == 2) { return "   # "; }
        if (r == 3) { return "#  # "; }
        return " ##  ";
    }
    # K
    if (i == 21) {
        if (r == 0) { return "#   #"; }
        if (r == 1) { return "#  # "; }
        if (r == 2) { return "###  "; }
        if (r == 3) { return "#  # "; }
