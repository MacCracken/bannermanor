    # U
    if (i == 31) {
        if (r == 0) { return "#   #"; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return "#   #"; }
        if (r == 3) { return "#   #"; }
        return " ### ";
    }
    # V
    if (i == 32) {
        if (r == 0) { return "#   #"; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return "#   #"; }
        if (r == 3) { return " # # "; }
        return "  #  ";
    }
    # W
    if (i == 33) {
        if (r == 0) { return "#   #"; }
        if (r == 1) { return "#   #"; }
        if (r == 2) { return "# # #"; }
        if (r == 3) { return "## ##"; }
        return "#   #";
    }
    # X
    if (i == 34) {
        if (r == 0) { return "#   #"; }
        if (r == 1) { return " # # "; }
        if (r == 2) { return "  #  "; }
        if (r == 3) { return " # # "; }
        return "#   #";
    }
    # Y
    if (i == 35) {
        if (r == 0) { return "#   #"; }
