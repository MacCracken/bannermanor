# flf.cyr — legacy figlet (.flf) font read adapter (M6).
#
# Read-only — .flf in, Font* out (same shape as src/font.cyr's CYML
# loader). CYML remains BannerManor's canonical format; this exists so
# users with existing figlet font libraries can point --font at them.
#
# Scope simplifications (documented in CHANGELOG 0.6.0):
#   - Uniform-width fit: every glyph row is right-padded with spaces
#     to the max width observed across all 95 glyphs; gap=0. Diverges
#     from real figlet output for narrow glyphs (narrow chars get
#     trailing whitespace). Variable-width storage in Font* is a
#     post-v0.6 question.
#   - No smushing / kerning. Hardblanks render as literal spaces,
#     which is exactly what figlet does when smushing is disabled.
#   - ASCII 32..126 only. The 7 "German" required chars and any
#     code-tagged extras are skipped (not failed on). v1.0 is ASCII.
#
# Format reference: http://www.jave.de/figlet/figfont.html
# Minimum-viable header line: "flf2a$ HH BB ML OL CL [PD] [FL] [CC]"
# followed by CL comment lines, followed by 95 glyph blocks (chars
# 32..126), each HH lines long with an endmark char at the end of
# every line (doubled on the last line of each glyph).

include "src/font.cyr"
include "lib/string.cyr"
include "lib/io.cyr"

# The adapter's own envelope. FLF_MAX_WIDTH / FLF_MAX_HEIGHT are NOT
# src/font.cyr's MAX_WIDTH / MAX_HEIGHT and are not kept "in sync":
# MAX_* is CYML schema 1, frozen at v1.0; FLF_MAX_* is how big a FIGfont
# bnrmr agrees to load, which the FIGfont spec does not bound. Through
# 1.4.2 they happened to share 64 x 32, and a comment here said "match
# font.cyr", the instruction that would have changed both.
#
# 1.5.0 raised the envelope from 64 x 32 to 128 x 64 (ADR 0002 ruling 3:
# admitting input rejected only by bnrmr's own limit is additive).
# Measured over the 1,052-font reference corpus (cmatsuoka/figlet-fonts
# + xero/figlet-fonts): 64 x 32 rejected 79; 73 of those were the Obanner
# family (up to 125 x 63) and five fonts 70-77 columns wide, all inside
# 128 x 64. The other six stay rejected: five CJK fonts over the 1 MB cap,
# which the 1.0.0 adapter contract names, and one malformed 23 MB file.
# All 973 fonts that loaded before render byte-identically.
#
# FLF_MAX_WIDTH is also the scratch stride per glyph row, so the parse
# scratch is 95 x height x 128 bytes: 778 KB at the 64-row ceiling,
# freed with the process like every other bump allocation.
#
# The number 32 means two different things in this file: FLF_FIRST_CH
# (the first glyph's char code) and the space byte that hardblanks and
# control bytes become. The first is named here; the space byte stays a
# literal, commented where used.
enum FlfLimits {
    FLF_MAX_FILE = 1048576;     # 1 MB; a file of this size or more is refused
    # (frozen: CHANGELOG 1.0.0 names the cap)
    FLF_GLYPHS = 95;            # ASCII 32..126 inclusive
    FLF_FIRST_CH = 32;          # char code of glyph 0
    FLF_MAX_WIDTH = 128;        # widest glyph row, after endmarks are stripped;
    # also the scratch stride per row
    FLF_MAX_HEIGHT = 64;        # rows per glyph
    FLF_MAX_COMMENTS = 1024;    # absurd-but-finite cap on header comments
}

# ---- low-level parse helpers ----
#
# The file read itself is src/font.cyr's `_slurp`, shared with the two
# CYML readers (1.4.1); this adapter passes FLF_MAX_FILE as the cap.

# Index of the next \n at or after `pos`, or `len` if none (EOF).
fn _flf_eol(buf, len, pos): i64 {
    var i = pos;
    var found = 0 - 1;
    while (i < len && found < 0) {
        if (load8(buf + i) == 10) { found = i; }
        else { i = i + 1; }
    }
    if (found < 0) { return len; }
    return found;
}

# Skip space + tab starting at `pos`. Returns new pos.
fn _flf_skip_ws(buf, len, pos): i64 {
    var i = pos;
    var go = 1;
    while (i < len && go == 1) {
        var c = load8(buf + i);
        if (c == 32 || c == 9) { i = i + 1; }
        else { go = 0; }
    }
    return i;
}

# Parse a non-negative decimal int at `pos` within buf[0..len-1].
# Writes the ending pos (first non-digit byte) to *out_end and returns
# the value, or -1 if no digits were consumed or the value exceeded
# PARSER_INT_CAP (F-002 overflow guard).
fn _flf_take_int(buf, len, pos, out_end): i64 {
    var i = pos;
    var n = 0;
    var any = 0;
    var ovf = 0;
    var go = 1;
    while (i < len && go == 1) {
        var c = load8(buf + i);
        if (c >= 48 && c <= 57) {
            n = n * 10 + (c - 48);
            if (n > PARSER_INT_CAP) { ovf = 1; go = 0; }
            any = 1;
            i = i + 1;
        } else { go = 0; }
    }
    store64(out_end, i);
    if (any == 0) { return 0 - 1; }
    if (ovf == 1) { return 0 - 1; }
    return n;
}

# ---- public entry ----

# Load a .flf figlet font from `path`. Returns Font* on success, 0 on
# error. Errors are bounded — file size, magic, geometry, comment
# count, and glyph-block shape are all validated.
fn flf_load_file(path): i64 {
    var len_box[8];
    store64(&len_box, 0);
    var buf = _slurp(path, FLF_MAX_FILE, &len_box);
    if (buf == 0) { return 0; }
    var f = _flf_parse(buf, load64(&len_box));
    # Safe to free: every glyph row is copied into the Font (through the
    # scratch below) before _flf_parse returns.
    fl_free(buf);
    return f;
}

# Parse a .flf font held in memory (`total` bytes at `buf`) into a
# Font*, or 0. Split from flf_load_file at 1.4.1 so the read buffer is
# freed in one place and the fuzz harness can drive the parser
# directly.
fn _flf_parse(buf, total): i64 {
    if (total <= 0) { return 0; }
    if (total >= FLF_MAX_FILE) { return 0; }

    # --- header line: "flf2a$ HH BB ML OL CL [...]\n" ---
    var hdr_end = _flf_eol(buf, total, 0);
    if (hdr_end < 7) { return 0; }                # need at least flf2aX + 1
    if (memeq(buf, "flf2a", 5) != 1) { return 0; }
    var hardblank = load8(buf + 5);
    # FIGfont v2 rule: any byte may be the hardblank except NUL, LF, CR
    # and space. The previous 33..126 window was stricter than the spec
    # and rejected 17 of the 1052 fonts in the reference corpus —
    # including bubble, digital and term, three of the 18 fonts in the
    # canonical figlet distribution. Widening only ADMITS fonts, so no
    # font that loads today can change: the hardblank -> space
    # substitution below runs before the F-001 control scrub, so a DEL
    # or C1 hardblank still becomes a space and never reaches stdout.
    if (hardblank == 0)  { return 0; }
    if (hardblank == 10) { return 0; }            # LF
    if (hardblank == 13) { return 0; }            # CR
    if (hardblank == 32) { return 0; }            # space

    var p_box[8];
    store64(&p_box, 0);

    var p = 6;
    p = _flf_skip_ws(buf, hdr_end, p);
    var height = _flf_take_int(buf, hdr_end, p, &p_box);
    p = load64(&p_box);
    if (height < 1) { return 0; }
    if (height > FLF_MAX_HEIGHT) { return 0; }

    p = _flf_skip_ws(buf, hdr_end, p);
    var baseline = _flf_take_int(buf, hdr_end, p, &p_box);
    p = load64(&p_box);
    if (baseline < 0) { return 0; }

    p = _flf_skip_ws(buf, hdr_end, p);
    var max_len = _flf_take_int(buf, hdr_end, p, &p_box);
    p = load64(&p_box);
    if (max_len < 0) { return 0; }

    # old_layout can be negative (-1 = "no smushing" per spec). We
    # don't use it (no smushing in our renderer), so just consume.
    p = _flf_skip_ws(buf, hdr_end, p);
    if (p < hdr_end) {
        if (load8(buf + p) == 45) { p = p + 1; }  # leading '-' allowed
    }
    var _ol_end[8];
    store64(&_ol_end, p);
    var _ol = _flf_take_int(buf, hdr_end, p, &_ol_end);
    p = load64(&_ol_end);
    if (_ol < 0) { return 0; }                    # digits required

    p = _flf_skip_ws(buf, hdr_end, p);
    var comments = _flf_take_int(buf, hdr_end, p, &p_box);
    p = load64(&p_box);
    if (comments < 0) { return 0; }
    if (comments > FLF_MAX_COMMENTS) { return 0; }

    # --- skip CL comment lines ---
    var cursor = hdr_end + 1;
    var ci = 0;
    while (ci < comments) {
        if (cursor >= total) { return 0; }
        cursor = _flf_eol(buf, total, cursor);
        if (cursor >= total) { return 0; }        # comment line not \n-terminated
        cursor = cursor + 1;
        ci = ci + 1;
    }

    # --- scratch for 95 glyphs × HH rows, FLF_MAX_WIDTH cols each ---
    var scratch_bytes = FLF_GLYPHS * height * FLF_MAX_WIDTH;
    var rows_scratch = alloc(scratch_bytes);
    if (rows_scratch == 0) { return 0; }
    memset(rows_scratch, 32, scratch_bytes);      # default-fill with space (32)

    # --- parse 95 glyph blocks ---
    var max_width = 0;
    var gi = 0;
    while (gi < FLF_GLYPHS) {
        var endmark = 0;
        var r = 0;
        while (r < height) {
            if (cursor >= total) { return 0; }    # truncated
            var line_start = cursor;
            var line_end = _flf_eol(buf, total, cursor);

            # Issue 0003 — treat \r\n as the line terminator. CRLF .flf
            # files (common from Windows authoring tools like JavE)
            # would otherwise have \r mistaken for the endmark, leaving
            # the real endmark `#`/`@`/`$` bytes embedded in glyph rows.
            # Pure-LF files are unaffected (CR check fails harmlessly).
            # cursor still advances past line_end + 1, so byte-offset
            # bookkeeping is unchanged.
            #
            # 1.1.4 — generalised from the single-CR walk-back above to
            # figlet's actual rule. `readfontchar()` trims ALL trailing
            # whitespace first, THEN takes the last remaining byte as
            # the endmark. Trimming only CR meant a row ending in a
            # space or TAB latched endmark = ' ', so the real `@`/`#`
            # bytes survived into the rendered art. Measured against a
            # 397-font corpus: 7 fonts change, all 7 misparse today,
            # and none changes its load/reject status. The in-tree
            # fixtures contain no trailing whitespace, so tiny.flf and
            # flf_crlf.flf are unaffected.
            #
            # ISSPACE set: space, TAB, CR, VT, FF.
            var eff_end = line_end;
            var trim_done = 0;
            while (eff_end > line_start && trim_done == 0) {
                var tb = load8(buf + eff_end - 1);
                if (tb == 32 || tb == 9 || tb == 13 || tb == 11 || tb == 12) {
                    eff_end = eff_end - 1;
                } else {
                    trim_done = 1;
                }
            }
            var llen = eff_end - line_start;
            if (llen <= 0) { return 0; }          # empty line not allowed

            # Endmark = last byte of the glyph's first row, applied to
            # every row of that glyph. Note this is LESS tolerant than
            # figlet, which recomputes the endmark per LINE — a glyph
            # whose rows end in different marks parses there and not
            # here. Kept deliberately: a 376-font differential showed
            # per-line detection changes 7 fonts and corrects none of
            # them, while the whitespace trim above achieves exact
            # figlet parity across all 376.
            if (r == 0) {
                endmark = load8(buf + eff_end - 1);
            }

            # Strip every trailing byte == endmark (handles single
            # endmark on lines 1..H-1 and doubled endmark on line H).
            var strip_done = 0;
            while (llen > 0 && strip_done == 0) {
                if (load8(buf + line_start + llen - 1) != endmark) {
                    strip_done = 1;
                } else {
                    llen = llen - 1;
                }
            }

            if (llen > FLF_MAX_WIDTH) { return 0; }

            # Copy to scratch with hardblank → space substitution.
            # Control bytes (0x00–0x1F, 0x7F, 0x80–0x9F) are replaced
            # with space: a malicious .flf could otherwise smuggle an
            # ESC (0x1B) into a glyph row and emit ANSI to the user's
            # TTY when rendered (CWE-150 / category B in the 0.7.0
            # audit). Order matters: the hardblank -> space
            # substitution on the line above runs FIRST, so a font
            # whose hardblank is itself a control byte still renders
            # correctly rather than having its hardblanks scrubbed as
            # controls. Reachable since 1.1.4 widened the header's
            # hardblank guard to the FIGfont v2 rule; before that the
            # header rejected any hardblank < 33, so this path was
            # dead and the comment here claimed otherwise.
            var dst = rows_scratch + (gi * height + r) * FLF_MAX_WIDTH;
            var col = 0;
            while (col < llen) {
                var b = load8(buf + line_start + col);
                if (b == hardblank) { b = 32; }       # -> space
                if (b < 32)  { b = 32; }      # C0 controls -> space
                if (b == 127) { b = 32; }     # DEL -> space
                if (b >= 128 && b <= 159) { b = 32; }  # C1 controls -> space
                store8(dst + col, b);
                col = col + 1;
            }
            # (Per-row lengths are intentionally not retained: every glyph
            # row is stored space-padded to a fixed stride. Variable-width
            # glyph output would need them back.)
            if (llen > max_width) { max_width = llen; }

            # Advance past line. _flf_eol returns `total` if no \n found,
            # so cursor=total+1 is fine — the next iteration's
            # `cursor >= total` check catches it.
            cursor = line_end + 1;
            r = r + 1;
        }
        gi = gi + 1;
    }

    if (max_width <= 0) { return 0; }
    if (max_width > FLF_MAX_WIDTH) { return 0; }

    # --- assemble Font* ---
    var f = font_new(max_width, height, 0, FLF_GLYPHS);
    if (f == 0) { return 0; }

    var idx = 0;
    while (idx < FLF_GLYPHS) {
        var ch = FLF_FIRST_CH + idx;
        if (font_set_char(f, idx, ch) < 0) { return 0; }
        var rr = 0;
        while (rr < height) {
            var src = rows_scratch + (idx * height + rr) * FLF_MAX_WIDTH;
            var dst = font_row(f, idx, rr);
            memcpy(dst, src, max_width);
            rr = rr + 1;
        }
        idx = idx + 1;
    }

    return f;
}
