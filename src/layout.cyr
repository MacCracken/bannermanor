# layout.cyr — banner layout (alignment, width, padding).
#
# Wraps render.cyr's row-by-row writer with three M4 controls:
#
#   --align L|C|R   alignment within the "frame" (terminal width
#                   or --width); default left
#   --width N       truncate input at the glyph boundary so output
#                   never exceeds N columns; 0 = unlimited
#   --pad N         N blank lines above and below the banner
#
# The frame width is resolved as:
#   1. --width N if N > 0
#   2. the terminal width of fd 1, from darshana's tty_winsize
#      (TIOCGWINSZ on Linux; the framebuffer console grid on AGNOS)
#   3. COLUMNS env var if it parses as a positive integer
#   4. 80 (documented fallback per `--help`)
#
# Truncation is at glyph boundary — `bnrmr --width 20 "AGNOS"` with
# the 5×5 block font fits 3 glyphs (3*5 + 2*1 = 17 cols) and drops
# "OS"; it never renders a half-glyph.

include "src/font.cyr"
include "src/color.cyr"
include "lib/io.cyr"

# No TIOCGWINSZ / struct winsize offsets here: the probe below goes
# through darshana (issue 0019), which owns the ioctl request code and
# exports it into this compilation unit as a public `var`. Through 1.1.5
# this enum declared its own `TIOCGWINSZ = 0x5413` beside darshana's —
# silent only because the two values happen to agree.
enum LayoutLimits {
    MAX_INPUT = 1024;         # the 1 KB render-text cap (M1 contract,
    # kept through every release since):
    # render_layout refuses more, and
    # src/main.cyr sizes its join buffer
    # from it
    DEFAULT_FRAME = 80;       # fallback when neither --width nor TTY size known
    WS_COL_CAP   = 4096;      # F-008 — clamp terminal cols. Defense in
    # depth: nothing in bnrmr currently sizes
    # an allocation from cols, but a future
    # caller that did could be tripped by a
    # `resize -s 65535 65535` attack.
    WIDTH_CAP    = 4096;      # v1.0 M8 freeze (issue 0002) — upper cap
    # on `--width N`. Coincides with WS_COL_CAP
    # by design: a banner wider than the cap on
    # the terminal's own column count is absurd.
    # Kept as a separate named constant because
    # the *reason* differs (one clamps ioctl
    # output, the other rejects user CLI input).
    PAD_CAP      = 64;        # v1.0 M8 freeze (issue 0002) — upper cap
    # on `--pad N` (top and bottom blank lines).
    # 64 lines is taller than any reasonable
    # terminal; the user can wrap in literal
    # newlines if they want more.
}
# F-002 — shared overflow cap for hand-written integer parsers
# (parse_uint here, _font_get_int in font.cyr, _flf_take_int in
# flf.cyr) is defined in src/font.cyr's FontLimits enum, since
# layout.cyr / font.cyr / flf.cyr all transitively include font.cyr.

enum AlignKind {
    ALIGN_LEFT   = 0;
    ALIGN_CENTER = 1;
    ALIGN_RIGHT  = 2;
}

# Parse a NUL-terminated decimal cstring into a non-negative int.
# Returns -1 if the string is empty, contains a non-digit byte, or
# would exceed PARSER_INT_CAP (F-002 overflow guard). Stops at NUL.
fn parse_uint(cstr): i64 {
    if (cstr == 0) { return 0 - 1; }
    var n = 0;
    var any = 0;
    var i = 0;
    var c = load8(cstr);
    var done = 0;
    while (done == 0) {
        if (c == 0) { done = 1; }
        else {
            if (c < 48 || c > 57) { return 0 - 1; }
            n = n * 10 + (c - 48);
            if (n > PARSER_INT_CAP) { return 0 - 1; }
            any = 1;
            i = i + 1;
            c = load8(cstr + i);
        }
    }
    if (any == 0) { return 0 - 1; }
    return n;
}

# The usable column count from a `tty_winsize` answer: `rc` is its
# return, `cols` the column count it reported. 0 when the query failed
# (`rc != 0` — not a terminal, or no console) or the terminal reports 0
# columns; otherwise `cols` clamped at WS_COL_CAP (F-008: a
# `resize -s 65535 65535` attack can't propagate hostile width into
# anything downstream that sizes from cols). Only the column count
# matters — a terminal reporting 0 ROWS but real columns is still a
# terminal of that width, which is why this is not `tty_winsize_or`
# (that helper treats a 0 in either dimension as "size unknown").
# Pure, so the rule is testable on every target.
fn _usable_cols(rc, cols): i64 {
    if (rc != 0) { return 0; }
    if (cols <= 0) { return 0; }
    if (cols > WS_COL_CAP) { return WS_COL_CAP; }
    return cols;
}

# Does darshana's `tty_winsize(1, ...)` describe fd 1? 1 or 0.
#
# Linux: 1. TIOCGWINSZ is asked of fd 1 itself, so a pipe or a file
# fails the ioctl and the width probe answers 0 on its own.
#
# AGNOS: only when fd 1 IS the console. winsize#60, which darshana's
# AGNOS peer calls, reports the console grid whatever fd 1 is, so
# through 1.6.0 a redirected or piped banner was cut to the console's
# width, and color had to stay off altogether (it would have put escape
# bytes into `bnrmr --color red X > /etc/motd`). agnos 1.57.13 added
# fd_kind#111 and cyrius 6.7.11 wraps it as `sys_fd_kind`, so this asks
# the kernel what fd 1 is (ADR 0004). Only FDK_CONSOLE counts:
#   - FDK_FILE (`>`) and FDK_PIPE (`|`, agnsh's pipelines) are not
#     terminals, as on Linux.
#   - FDK_CHAN, the channel a terminal emulator hands its child, is not
#     counted either: winsize#60 would report the console's size, not
#     that window's, and darshana's planned per-fd `tty_isatty` draws
#     the same line (agnos's ABI doc: `fd_kind(fd) == 1`).
#   - -1, a kernel older than 1.57.13 (an unknown syscall) or a closed
#     fd 1, is not a terminal: no color and no width cut, never escape
#     bytes in a file.
# This is the inline gate ADR 0004 allows only where no wrapper answers
# the question; when darshana's AGNOS `tty_isatty(fd)` asks fd_kind,
# route through it instead.
fn _winsize_describes_stdout(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    if (sys_fd_kind(1) == FDK_CONSOLE) { return 1; }
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return 1;
    #endif
}

# Terminal width of stdout, or 0 if stdout is not a terminal, the query
# fails, or the terminal reports 0 columns. Routed through darshana's
# `tty_winsize(1, ...)` (issue 0019), which bridges both targets:
# TIOCGWINSZ on Linux, and on AGNOS the live framebuffer console grid
# (winsize syscall #60), asked only when fd 1 is the console (above).
# Through 1.1.5 the AGNOS arm hard-returned 0 on the premise that the
# console size "isn't queryable from userland yet", so every AGNOS
# banner fell back to $COLUMNS / 80 columns (issue 0018).
#
# The name predates the darshana route; on Linux it is still the
# TIOCGWINSZ ioctl, inside darshana.
fn term_width_ioctl(): i64 {
    if (_winsize_describes_stdout() == 0) { return 0; }
    var rows = 0;
    var cols = 0;
    var rc = tty_winsize(1, &rows, &cols);
    return _usable_cols(rc, cols);
}

# Is stdout attached to a usable TTY? Returns 1 if yes, 0 if piped /
# redirected / closed, and 0 for a terminal reporting 0 columns.
#
# Derived from the width probe on both targets, so the two cannot
# disagree (F-020) — a 0-column pty (before TIOCSWINSZ; some serial
# consoles) is "not a TTY" here, where darshana's `tty_isatty(1)` would
# answer 1 and turn color back on for exactly the wrapping-colored-
# banner case issue 0004 exists to prevent. That 0-column rule is why
# this is not a bare `tty_isatty(1)`.
#
# Through 1.6.0 the AGNOS arm returned 0, so --color never colored on
# AGNOS; since 1.7.0 the console gets color and nothing else does.
fn stdout_is_tty(): i64 {
    if (term_width_ioctl() > 0) { return 1; }
    return 0;
}

# Read the COLUMNS env var; return parsed value or 0 on miss/error.
fn term_width_env(): i64 {
    var v = getenv("COLUMNS");
    if (v == 0) { return 0; }
    var n = parse_uint(v);
    if (n <= 0) { return 0; }
    # F-013: clamp at WS_COL_CAP, matching the F-008 clamp on the
    # terminal-width leg. COLUMNS was the only frame source without a
    # ceiling — `--width` is rejected above WIDTH_CAP in main.cyr and
    # the terminal leg is clamped above, so an env var could drive the
    # frame 256x past both. On AGNOS this is the frame source when fd 1
    # is not the console (since 1.7.0, as on Linux) or the framebuffer
    # console is down; through 1.1.5 it was the only AGNOS source at all.
    if (n > WS_COL_CAP) { return WS_COL_CAP; }
    return n;
}

# Resolve the frame width. Priority: explicit --width > terminal width
# (term_width_ioctl) > COLUMNS env > DEFAULT_FRAME. Caller passes
# `requested = 0` for "no --width specified."
fn resolve_frame(requested): i64 {
    if (requested > 0) { return requested; }
    var w = term_width_ioctl();
    if (w > 0) { return w; }
    w = term_width_env();
    if (w > 0) { return w; }
    return DEFAULT_FRAME;
}

# Columns consumed by `n` glyphs of width `gw` with `gap` between
# adjacent pairs. For n=0 returns 0.
fn banner_width(n, gw, gap): i64 {
    if (n <= 0) { return 0; }
    return n * gw + (n - 1) * gap;
}

# Maximum number of glyphs that fit within `frame` columns at glyph
# width `gw` and inter-glyph gap `gap`. Frame=0 → unlimited (returns
# len). Always rounds down at the glyph boundary — never partial.
#
# If `frame` is smaller than a single glyph (`frame < gw`), returns 0.
# render_layout then draws no glyph, but it still writes `height` rows:
# each is empty, SGR-wrapped on a TTY when --color is set, plus any
# --pad lines. So the output is blank rows, not "no output". That is the
# frozen behavior (accepted risk A-05), and --help says so under
# --width. A blank row beats a half-rendered glyph or a row that
# overflows the frame. (Until 1.4.1 this comment promised "no output".)
fn fit_chars(frame, gw, gap, len): i64 {
    if (frame <= 0) { return len; }
    if (len <= 0) { return 0; }
    # Solve banner_width(n) <= frame: n*gw + (n-1)*gap <= frame
    #                                 n*(gw + gap) <= frame + gap
    #                                 n <= (frame + gap) / (gw + gap)
    var n = (frame + gap) / (gw + gap);
    if (n > len) { return len; }
    if (n < 0) { return 0; }
    return n;
}

# Compute leading-space count for alignment. align: 0=left, 1=center,
# 2=right. If the banner is wider than the frame (shouldn't happen
# post-fit) returns 0.
fn align_pad(banner, frame, align): i64 {
    if (align == ALIGN_LEFT) { return 0; }
    if (frame <= banner) { return 0; }
    var slack = frame - banner;
    if (align == ALIGN_CENTER) { return slack / 2; }
    if (align == ALIGN_RIGHT) { return slack; }
    return 0;
}

# ---- the write path ----
#
# Every byte bnrmr writes to stdout outside lib/ goes through `_emit`:
# the banner rows here, and --help, --version and --list-fonts in
# src/cli.cyr. Through 1.2.0 there were 19 inline `syscall(1, 1, ...)`
# sites instead, correct on every target only by coincidence (accepted
# risk A-10; docs/architecture/001). file_write is lib/io.cyr's
# per-target wrapper.
#
# Since 1.5.0 `_emit` checks what write(2) returns (issue 0009, ADR 0002
# ruling 2):
#   - a short write is not an error: the rest is written, as often as it
#     takes;
#   - EINTR is retried at once and EAGAIN after a 1 ms pause (a
#     non-blocking stdout inherited from a parent), each a bounded number
#     of times;
#   - anything else, and a write that makes no progress, is a failure.
#     It is recorded in `_out_err`, nothing more is written, and main()
#     exits 1 with `bnrmr: write error` on stderr (out_failed()).
# Through 1.4.2 none of this was checked, so `bnrmr hi > /dev/full`
# exited 0 having written nothing.
#
# The errno values are named here, not taken from the stdlib, because
# the AGNOS syscall table defines neither: they are the asm-generic
# numbers, the same on x86_64 and aarch64 Linux. A failed AGNOS write
# returns -1, which matches neither and is a failure.
enum WriteErrno {
    W_EINTR = 4;
    W_EAGAIN = 11;
    W_EIO = 5;
}

var _out_err = 0;       # 0, or the negative errno of the first failed write

# 1 if any write to stdout has failed this process.
fn out_failed(): i64 {
    if (_out_err != 0) { return 1; }
    return 0;
}

# The stderr line main() prints when out_failed(). Names the common
# reasons by their Linux errno; anything else (and every AGNOS failure,
# which is -1) is the bare line.
fn write_error_text(): i64 {
    var e = 0 - _out_err;
    if (e == 28)  { return "bnrmr: write error: no space left on device"; }
    if (e == 9)   { return "bnrmr: write error: stdout is not open"; }
    if (e == 5)   { return "bnrmr: write error: I/O error"; }
    if (e == 27)  { return "bnrmr: write error: file too large"; }
    if (e == 122) { return "bnrmr: write error: disk quota exceeded"; }
    return "bnrmr: write error";
}

fn _emit_nap(): i64 {
    var ts[16];
    store64(&ts, 0);
    store64(&ts + 8, 1000000);          # 1 ms
    sys_nanosleep(&ts, 0);
    return 0;
}

# Write all `n` bytes at `buf` to stdout. 0, or -1 once a write has
# failed (this one or an earlier one).
fn _emit(buf, n): i64 {
    if (_out_err != 0) { return 0 - 1; }
    var off = 0;
    var intr = 0;
    var again = 0;
    while (off < n && _out_err == 0) {
        var w = file_write(1, buf + off, n - off);
        if (w > 0) {
            off = off + w;
            intr = 0;
            again = 0;
        } else {
            var retry = 0;
            if (w == 0 - W_EINTR && intr < 100) { intr = intr + 1; retry = 1; }
            if (w == 0 - W_EAGAIN && again < 1000) { again = again + 1; _emit_nap(); retry = 1; }
            if (retry == 0) {
                _out_err = w;
                if (w == 0) { _out_err = 0 - W_EIO; }      # no progress
            }
        }
    }
    if (_out_err != 0) { return 0 - 1; }
    return 0;
}

# `s` and a newline, to stdout, in one write when it fits.
fn _emit_line(s): i64 {
    var n = strlen(s);
    var buf[256];
    if (n < 255) {
        memcpy(&buf, s, n);
        store8(&buf + n, 10);
        return _emit(&buf, n + 1);
    }
    _emit(s, n);
    return _emit("\n", 1);
}

# `s` and a newline, to stderr, in one write when it fits. Diagnostics go
# here since 1.5.0 (issue 0016). Unchecked: if stderr cannot be written
# there is nowhere left to say so, and the exit code still reports it.
fn _err_line(s): i64 {
    var n = strlen(s);
    var buf[256];
    if (n < 255) {
        memcpy(&buf, s, n);
        store8(&buf + n, 10);
        file_write(2, &buf, n + 1);
        return 0;
    }
    file_write(2, s, n);
    file_write(2, "\n", 1);
    return 0;
}

# A run of `n` copies of one byte, in as few writes as possible (issue
# 0005, Option 1, 1.4.1). Through 1.2.0, pads and gaps went out one
# write(2) per byte. Since 1.5.0 the banner rows are composed whole
# (render_layout), so this serves the --pad blocks and the --list-fonts
# name column.
#
# The run buffers are allocated on first use (bump alloc) and kept for
# the process, which is safe because nothing that renders ever calls
# alloc_reset(); the fuzz harness resets, and never renders. 4096
# spaces and 64 newlines (PAD_CAP) cover every run the CLI can ask for
# in one write; longer runs take several. If the allocation is refused,
# a one-byte loop runs instead: slow, but the same bytes.
var _run_spaces = 0;
var _run_newlines = 0;

# The run buffer for `fill` (32 or 10), allocated on first use; 0 if the
# allocation was refused. Stores its capacity at *cap_out.
fn _run_buf(fill, cap_out): i64 {
    var src = _run_spaces;
    var cap = WS_COL_CAP;
    if (fill == 10) { src = _run_newlines; cap = PAD_CAP; }
    if (src == 0) {
        src = alloc(cap);
        if (src != 0) {
            memset(src, fill, cap);
            if (fill == 10) { _run_newlines = src; } else { _run_spaces = src; }
        }
    }
    store64(cap_out, cap);
    return src;
}

fn _emit_run(fill, n): i64 {
    if (n <= 0) { return 0; }
    var cap_box[8];
    var src = _run_buf(fill, &cap_box);
    var cap = load64(&cap_box);
    if (src == 0) {
        var one[8];
        store8(&one, fill);
        var k = 0;
        while (k < n) { _emit(&one, 1); k = k + 1; }
        return 0;
    }
    var left = n;
    while (left > 0) {
        var chunk = left;
        if (chunk > cap) { chunk = cap; }
        _emit(src, chunk);
        left = left - chunk;
    }
    return 0;
}

# Emit n spaces on stdout.
fn _write_spaces(n): i64 {
    return _emit_run(32, n);
}

# Emit n newlines on stdout.
fn _write_newlines(n): i64 {
    return _emit_run(10, n);
}

# ---- the row buffer (1.5.0, issue 0005 Option 2) ----
#
# Each banner row is composed in one buffer and written with one _emit:
# the left pad, the color's SGR, every glyph row and gap, the reset, the
# newline. darshana's `_buf` composers write the same bytes `tty_sgr` /
# `tty_sgr_reset` did (those two are literally the composer plus a
# write), so colored rows are byte-identical, which the golden pty leg
# checks.
#
# Sized per render: lpad + banner width + SGR_SLACK. The banner width is
# bounded by the 1 KB input cap times (glyph width + gap), which is
# 1024 × (128 + 16) bytes for the widest font the loaders accept, so a
# row is at most a few hundred KB. The buffer grows when a render needs
# more and is kept for the process (same lifetime rule as the run
# buffers above).
enum RowLimits {
    SGR_SLACK = 16;     # ESC [ NNN m (6) + ESC [ 0 m (4) + '\n', rounded up;
                        # the composers store up to 4 bytes past their output
}

var _row_buf = 0;
var _row_cap = 0;

# Copy n bytes, eight at a time where it can. lib/string.cyr's memcpy and
# memset move one byte per loop iteration, and composing rows with them
# made a 4096-column row cost more than the write it replaced (the left
# pad alone was ~12 µs a row). Unaligned 8-byte loads and stores are fine
# on every target bnrmr builds for (x86_64, aarch64).
fn _bulk_copy(dst, src, n): i64 {
    var i = 0;
    while (i + 8 <= n) {
        store64(dst + i, load64(src + i));
        i = i + 8;
    }
    while (i < n) {
        store8(dst + i, load8(src + i));
        i = i + 1;
    }
    return 0;
}

# n spaces at dst: copied from the run buffer, or byte by byte if there is
# none or n is past it.
fn _fill_spaces(dst, n): i64 {
    if (n <= 0) { return 0; }
    var cap_box[8];
    var sp = _run_buf(32, &cap_box);
    if (sp != 0 && n <= load64(&cap_box)) { return _bulk_copy(dst, sp, n); }
    memset(dst, 32, n);
    return 0;
}

# A row buffer of at least `need` bytes, or 0 if allocation was refused.
fn _row_buffer(need): i64 {
    if (need <= _row_cap) { return _row_buf; }
    var b = alloc(need);
    if (b == 0) { return 0; }
    _row_buf = b;
    _row_cap = need;
    return b;
}

# Render `text[0..len-1]` with `font` honoring layout opts:
#
#   width  — requested frame width; 0 = unlimited (no truncation, no
#            frame resolution for alignment)
#   align  — AlignKind value
#   pad    — blank lines above and below the banner
#   color  — COLOR_NONE / COLOR_RAINBOW / a 30..97 SGR code from
#            color.cyr. When stdout isn't a TTY, color is suppressed
#            silently — `bnrmr --color cyan | cat` writes plain bytes.
#
# Returns 0 on success, -1 on bad input (mirrors render() in render.cyr),
# -2 for a null font, -3 if the row buffer could not be allocated, and
# -4 if a write to stdout failed (main() reports that one through
# out_failed(), as for every other stdout write).
#
# Behavior:
#   - With width=0 and align=ALIGN_LEFT, pad=0, color=COLOR_NONE this
#     is byte-identical to render(font, text, len) — preserves the
#     M1 contract.
#   - With align != LEFT, the frame is resolved even if width=0 so
#     center/right-align always has something to center inside.
#   - With width > 0, input is truncated at glyph boundary first,
#     then aligned within the requested frame.
#   - With color != COLOR_NONE and stdout is a TTY, every banner row
#     is wrapped: SGR-set ... row bytes ... SGR-reset. Newline goes
#     after the reset so the next line's prompt isn't tinted.
fn render_layout(font, text, len, width, align, pad, color): i64 {
    if (len < 0) { return 0 - 1; }
    if (len > MAX_INPUT) { return 0 - 1; }
    if (font == 0) { return 0 - 2; }

    var w = font_width(font);
    var h = font_height(font);
    var g = font_gap(font);

    # Effective truncation width.
    #   - Explicit `--width N`  → use N (M4 contract).
    #   - No `--width`, TTY out → clamp to the terminal's cols so
    #                             the banner doesn't wrap into itself
    #                             on narrow terminals (issue 0004).
    #   - No `--width`, pipe out → `term_width_ioctl` returns 0,
    #                             `fit_chars(0, ...)` returns `len`
    #                             unchanged — preserves the M1
    #                             byte-identity contract for
    #                             `bnrmr ... | cat` and the test suite.
    #                             (On AGNOS too since 1.7.0; through
    #                             1.6.0 a pipe there was cut to the
    #                             console's width.)
    var clamp_w = width;
    if (clamp_w == 0) { clamp_w = term_width_ioctl(); }
    var draw_len = fit_chars(clamp_w, w, g, len);

    # Frame width for alignment. Left-align with width=0 means we
    # never resolve a frame at all (preserves M1 byte-identity).
    var frame = 0;
    if (align != ALIGN_LEFT) {
        frame = resolve_frame(width);
    } else {
        if (width > 0) { frame = width; }
    }

    var bw = banner_width(draw_len, w, g);
    var lpad = align_pad(bw, frame, align);

    var space_idx = font_glyph_index(font, 32);
    if (space_idx < 0) { space_idx = 0; }

    # Suppress color when stdout isn't a TTY — matches the M5
    # acceptance "renders colored on TTY, plain on pipe."
    var emit_color = 0;
    if (color != COLOR_NONE) {
        if (stdout_is_tty() == 1) { emit_color = 1; }
    }

    # One buffer holds a whole row; see "the row buffer" above.
    var row = _row_buffer(lpad + bw + SGR_SLACK);
    if (row == 0) { return 0 - 3; }

    _write_newlines(pad);

    var r = 0;
    while (r < h) {
        var pos = 0;
        if (lpad > 0) {
            _fill_spaces(row, lpad);
            pos = lpad;
        }

        if (emit_color == 1) {
            var c = color;
            if (color == COLOR_RAINBOW) { c = rainbow_color_for_row(r); }
            var sp = tty_sgr_buf(row, pos, c);
            if (sp > 0) { pos = sp; }
        }

        var i = 0;
        while (i < draw_len) {
            var ch = load8(text + i);
            var gi = font_glyph_index(font, ch);
            if (gi < 0) { gi = space_idx; }
            _bulk_copy(row + pos, font_row(font, gi, r), w);
            pos = pos + w;
            if (i + 1 < draw_len && g > 0) {
                _fill_spaces(row + pos, g);
                pos = pos + g;
            }
            i = i + 1;
        }

        if (emit_color == 1) { pos = tty_sgr_reset_buf(row, pos); }
        store8(row + pos, 10);
        _emit(row, pos + 1);
        r = r + 1;
    }

    _write_newlines(pad);
    if (out_failed() == 1) { return 0 - 4; }
    return 0;
}
