# render.cyr — M1 banner composer.
#
# Renders one input string with the hardcoded "block" font:
#   for each row 0..H-1:
#     for each input char:
#       look up glyph row-string, write 5 bytes
#       write GAP spaces between glyphs
#     write '\n'
#
# Unsupported characters fall through to the space glyph rather than
# erroring — keeps `bnrmr "hi!"` rendering "hi " instead of refusing.
# When we ship --strict in a later milestone we can promote this to
# an error path.

include "lib/string.cyr"
include "src/font_block.cyr"

# Max input bytes accepted by the renderer.
enum RenderLimits {
    MAX_INPUT = 1024;       # M1 acceptance criterion
}

# Render the first `len` bytes of `text` as a block-font banner on
# stdout. Returns 0 on success, -1 if input is over the cap.
fn render_block(text, len): i64 {
    if (len < 0) { return 0 - 1; }
    if (len > 1024) { return 0 - 1; }

    var h = 5;
    var w = 5;

    var r = 0;
    while (r < h) {
        var i = 0;
        while (i < len) {
            var c = load8(text + i);
            var gi = block_glyph_index(c);
            if (gi < 0) { gi = 0; }     # unsupported -> space glyph
            var row_ptr = block_row(gi, r);
            syscall(1, 1, row_ptr, w);
            if (i + 1 < len) {
                syscall(1, 1, " ", 1);  # GAP = 1 space between glyphs
            }
            i = i + 1;
        }
        syscall(1, 1, "\n", 1);
        r = r + 1;
    }
    return 0;
}
