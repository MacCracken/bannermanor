# render.cyr — banner composer.
#
# Reads font geometry + glyph rows from a Font* (see src/font.cyr).
# Same code path serves the embedded default and any --font-loaded file.
#
# M1+M2 contract: render(font, text, len) writes the banner row-by-
# row to stdout, default-left-aligned, no width cap, no padding. M4
# (layout flags) extends this through render_layout in src/layout.cyr;
# render() now delegates to render_layout with neutral options so its
# byte-for-byte behavior is preserved.

include "src/layout.cyr"

enum RenderLimits {
    MAX_INPUT = 1024;       # M1 contract; kept through M2/M3/M4
}

# Render `text[0..len-1]` with `font` to stdout. Returns 0 on success,
# -1 if input is over the 1 KB cap or len is negative, -2 if font is null.
fn render(font, text, len): i64 {
    return render_layout(font, text, len, 0, ALIGN_LEFT, 0, COLOR_NONE);
}
