# render.cyr — banner composer.
#
# Reads font geometry + glyph rows from a Font* (see src/font.cyr).
# Same code path serves the embedded default and any --font-loaded file.
#
# Algorithm:
#   for each row 0..H-1:
#     for each input char:
#       look up glyph index (lowercase folds; unsupported -> space)
#       write font_row(font, idx, row), `width` bytes
#       write `gap` spaces between adjacent glyphs
#     write '\n'

include "src/font.cyr"

enum RenderLimits {
    MAX_INPUT = 1024;       # M1 contract; kept through M2
}

# Render `text[0..len-1]` with `font` to stdout. Returns 0 on success,
# -1 if input is over the 1 KB cap or len is negative, -2 if font is null.
fn render(font, text, len): i64 {
    if (len < 0) { return 0 - 1; }
    if (len > 1024) { return 0 - 1; }
    if (font == 0) { return 0 - 2; }

    var w = font_width(font);
    var h = font_height(font);
    var g = font_gap(font);
    # Glyph index for ' ' — used as the fall-through for unsupported chars.
    var space_idx = font_glyph_index(font, 32);
    if (space_idx < 0) { space_idx = 0; }

    var r = 0;
    while (r < h) {
        var i = 0;
        while (i < len) {
            var c = load8(text + i);
            var gi = font_glyph_index(font, c);
            if (gi < 0) { gi = space_idx; }
            syscall(1, 1, font_row(font, gi, r), w);
            if (i + 1 < len) {
                # gap spaces between glyphs
                var gn = 0;
                while (gn < g) {
                    syscall(1, 1, " ", 1);
                    gn = gn + 1;
                }
            }
            i = i + 1;
        }
        syscall(1, 1, "\n", 1);
        r = r + 1;
    }
    return 0;
}
