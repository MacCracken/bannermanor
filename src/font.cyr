# font.cyr — Font struct + CYML font loader.
#
# Used by render.cyr; both the embedded default (src/font_block.cyr)
# and on-disk fonts (fonts/<name>.cyml) produce the same Font* shape.
#
# Schema: docs/adr/0001-cyml-font-format.md.
# Multi-entry CYML: file-level [font] header (TOML), one entry per glyph
# with `char = "X"` in the entry's TOML header and a body of HEIGHT
# rows × WIDTH bytes using `.` (background) and `#` (stroke).

# The CYML parser: bayan's CYML-only sublib (issue 0013). It ships in
# bayan's dist/ beside the full bundle and is pinned in cyrius.cyml
# [deps.bayan]. Through 1.2.0 this included the whole bundle from the
# stdlib (JSON, YAML, TOML, PDF, bigint, dtoa) to reach nine functions,
# which was about two thirds of the binary. The parser code is the same
# bytes: bayan 1.5.13's bayan-cyml.cyr carries the bundle's cyml.cyr
# section unchanged. The sublib has no unprefixed `cyml_*` names (those
# are the bundle's deprecated compat shims), so calls use `bayan_cyml_*`.
#
# Never call bayan_cyml_expand_value (or its old name cyml_expand_value)
# from a font loader: `${file:}` / `${env:}` expansion is for package
# metadata only, and a font is untrusted input (F-004; ADR 0001).
include "lib/bayan-cyml.cyr"
include "lib/string.cyr"
include "lib/io.cyr"
# fl_alloc / fl_free: the font readers' file buffers are transient, so
# they are freed after the parse instead of left in the bump heap
# (issue 0014). Everything that outlives the load stays on alloc().
include "lib/freelist.cyr"

# Font struct layout (48 bytes):
#    0: width      (i64) cols per glyph
#    8: height     (i64) rows per glyph
#   16: gap        (i64) spaces between adjacent glyphs
#   24: count      (i64) number of glyphs in this font
#   32: rows_ptr   (i64) flat row buffer, count*height*width bytes
#   40: charmap    (i64) 128-byte table: charmap[c] = glyph_idx+1, 0 = unsupported

enum FontField {
    F_WIDTH = 0;
    F_HEIGHT = 8;
    F_GAP = 16;
    F_COUNT = 24;
    F_ROWS = 32;
    F_CHARMAP = 40;
    F_SIZE = 48;
}

# The CYML schema-1 limits (ADR 0001). MAX_WIDTH / MAX_HEIGHT / MAX_GAP
# are part of the frozen v1.0 format, NOT tunables: src/flf.cyr's
# FLF_MAX_WIDTH / FLF_MAX_HEIGHT happen to share their values and are
# the ones a future change may raise (ADR 0002 ruling 3).
enum FontLimits {
    MAX_FILE_BYTES = 65536;     # a file of this size or more is refused
    # (`total >= MAX_FILE_BYTES`), so the
    # largest loadable font is 65535 bytes
    MAX_WIDTH = 64;             # schema 1: 1..64 columns per glyph
    MAX_HEIGHT = 32;            # schema 1: 1..32 rows per glyph
    MAX_GAP = 16;               # schema 1: 0..16 columns between glyphs
    MAX_GLYPHS = 256;           # bnrmr policy cap on entries, enforced
    # at the `count > MAX_GLYPHS` guard below.
    # Previously documented as the CYML
    # parser's own limit; that rationale is
    # stale twice over — lib/cyml.cyr folded
    # into bayan, and bayan then replaced its
    # fixed 256-entry scan with a counted heap
    # alloc. NOT the binding limit: CHARMAP_SIZE
    # is, since every entry needs a distinct
    # char below 128.
    CHARMAP_SIZE = 128;         # chars 0..127; the charmap is a byte per char
    SUPPORTED_SCHEMA = 1;
    HDR_NAME_CAP = 64;          # font name buffer (NUL-terminated, so a
    # name of 63 bytes or fewer)
    HDR_DESC_CAP = 256;         # description buffer (NUL-terminated, so
    # 255 bytes or fewer)
    PARSER_INT_CAP = 1048576;   # F-002 — shared cap for hand-written
    # integer parsers (parse_uint in
    # layout.cyr, _font_get_int here,
    # _flf_take_int in flf.cyr). Above
    # this, return -1 rather than risk
    # silent i64 wrap. Downstream bounds
    # (width≤64 etc.) are already tighter;
    # this is belt-and-suspenders for a
    # future relaxation.
}

# FontHeader struct (40 bytes) — just enough to print a --list-fonts line
# without paying for full glyph decode. Layout:
#    0: width
#    8: height
#   16: gap
#   24: name_buf (alloc'd, NUL-terminated, ≤ HDR_NAME_CAP bytes)
#   32: desc_buf (alloc'd, NUL-terminated, ≤ HDR_DESC_CAP bytes)
enum FontHdrField {
    H_WIDTH = 0;
    H_HEIGHT = 8;
    H_GAP = 16;
    H_NAME = 24;
    H_DESC = 32;
    H_SIZE = 40;
}

fn font_hdr_width(h): i64  { return load64(h + H_WIDTH); }
fn font_hdr_height(h): i64 { return load64(h + H_HEIGHT); }
fn font_hdr_gap(h): i64    { return load64(h + H_GAP); }
fn font_hdr_name(h): i64   { return load64(h + H_NAME); }   # cstring
fn font_hdr_desc(h): i64   { return load64(h + H_DESC); }   # cstring

# ---- accessors ----

fn font_width(f): i64  { return load64(f + F_WIDTH); }
fn font_height(f): i64 { return load64(f + F_HEIGHT); }
fn font_gap(f): i64    { return load64(f + F_GAP); }
fn font_count(f): i64  { return load64(f + F_COUNT); }

# Return glyph_idx for char c, or -1.
#
# Lowercase ASCII folds to uppercase ONLY when the font has no
# lowercase glyph registered (fallback fold). A font that ships both
# cases — typical for tall fonts where lowercase descenders are
# legible — gets distinct glyphs honored. block.cyml ships uppercase
# only, so 'a' falls back to 'A' on that font.
fn font_glyph_index(f, c): i64 {
    if (c < 0) { return 0 - 1; }
    if (c >= CHARMAP_SIZE) { return 0 - 1; }
    var charmap = load64(f + F_CHARMAP);
    var v = load8(charmap + c);
    if (v != 0) { return v - 1; }
    # Fallback: lowercase ASCII tries the uppercase slot.
    if (c >= 97) {
        if (c <= 122) {
            v = load8(charmap + (c - 32));
            if (v != 0) { return v - 1; }
        }
    }
    return 0 - 1;
}

# Pointer to the `width` bytes for (glyph_idx, row).
fn font_row(f, idx, row): i64 {
    var w = load64(f + F_WIDTH);
    var h = load64(f + F_HEIGHT);
    return load64(f + F_ROWS) + (idx * h + row) * w;
}

# ---- font construction (used by both file loader and embedded path) ----

# Allocate a zero-filled Font with reserved rows + charmap storage.
# Returns Font* or 0 on OOM.
fn font_new(width, height, gap, count): i64 {
    var f = alloc(F_SIZE);
    if (f == 0) { return 0; }
    var rows_bytes = count * height * width;
    var rows = alloc(rows_bytes);
    if (rows == 0) { return 0; }
    var charmap = alloc(CHARMAP_SIZE);
    if (charmap == 0) { return 0; }
    memset(rows, 32, rows_bytes);               # 32: background is a space
    memset(charmap, 0, CHARMAP_SIZE);
    store64(f + F_WIDTH, width);
    store64(f + F_HEIGHT, height);
    store64(f + F_GAP, gap);
    store64(f + F_COUNT, count);
    store64(f + F_ROWS, rows);
    store64(f + F_CHARMAP, charmap);
    return f;
}

# Register glyph idx for char c. Returns 0 on success, -1 if c is out
# of range (0..127) or already mapped to another glyph.
fn font_set_char(f, idx, c): i64 {
    if (c < 0) { return 0 - 1; }
    if (c >= CHARMAP_SIZE) { return 0 - 1; }
    var charmap = load64(f + F_CHARMAP);
    if (load8(charmap + c) != 0) { return 0 - 1; }   # duplicate
    store8(charmap + c, idx + 1);
    return 0;
}

# Write a single row of `width` bytes into glyph idx. Returns 0.
fn font_set_row(f, idx, row, src): i64 {
    var w = load64(f + F_WIDTH);
    var dst = font_row(f, idx, row);
    memcpy(dst, src, w);
    return 0;
}

# ---- reading a font file ----

# Read the whole of `path` into a fresh fl_alloc'd buffer of `cap`
# bytes. Returns the buffer and stores the byte count at *out_len, or
# returns 0 when the path is not a regular file, cannot be opened or
# read, is empty, or holds `cap` bytes or more. The caller owns the
# buffer and must fl_free it.
#
# All three font readers go through here (font_load_file and
# font_header_load with MAX_FILE_BYTES, flf_load_file with
# FLF_MAX_FILE). Until 1.4.1 each carried its own copy of this block,
# and 1.1.4's regular-file gate had to be pasted into all three.
#
# The regular-file gate (1.1.4) runs before any open: a character
# device (`--font /dev/zero.flf`) would otherwise be read up to the
# cap, and open(2) on a FIFO blocks until a writer appears. STAT_MODE,
# not a hardcoded 24, because st_mode's offset differs per arch: 24 on
# x86_64-Linux, 16 on aarch64-Linux. S_IFMT 0xF000, S_IFREG 0x8000.
# `&` binds tighter than `!=` in cyrius, so the test reads as written.
#
# Open, read and close go through lib/io.cyr (file_open / file_read /
# file_close), never raw syscall numbers: the raw x86_64 numbers are
# other calls on AGNOS (1.1.4). A read error ends the loop like EOF
# does, so a file that fails on its first read is "empty" (rejected),
# and one that fails later is a truncated buffer, which every parser
# here rejects unless the cut falls exactly on an entry boundary (see
# the 1.1.4 audit, refuted finding 3).
fn _slurp(path, cap, out_len): i64 {
    var st[144];
    if (xstat(path, &st) != 0) { return 0; }
    var mode = load32(&st + STAT_MODE);
    if (mode & 0xF000 != 0x8000) { return 0; }
    var fd = file_open(path, 0, 0);
    if (fd < 0) { return 0; }
    var buf = fl_alloc(cap);
    if (buf == 0) { file_close(fd); return 0; }
    var total = 0;
    var rgo = 1;
    while (rgo == 1) {
        var n = file_read(fd, buf + total, cap - total);
        if (n <= 0) { rgo = 0; }
        else {
            total = total + n;
            if (total >= cap) { rgo = 0; }
        }
    }
    file_close(fd);
    if (total <= 0) { fl_free(buf); return 0; }
    if (total >= cap) { fl_free(buf); return 0; }   # at or over the cap
    store64(out_len, total);
    return buf;
}

# ---- CYML loader ----

# Walk a TOML-style header buffer line by line looking for `key = N`.
# Returns N or -1 if not found / not an integer.
fn _font_get_int(hdr, hlen, key, key_len): i64 {
    var i = 0;
    var found = 0 - 1;
    while (i < hlen && found < 0) {
        # skip leading ws on this line
        var ls = 1;
        while (i < hlen && ls == 1) {
            var c = load8(hdr + i);
            if (c == 32) { i = i + 1; }
            else { if (c == 9) { i = i + 1; }
                else { ls = 0; } }
        }
        # try key match
        if (i + key_len < hlen) {
            if (memeq(hdr + i, key, key_len) == 1) {
                # next char should be ws or '='
                var nc = load8(hdr + i + key_len);
                if (nc == 32 || nc == 9 || nc == 61) {
                    var p = i + key_len;
                    var sk = 1;
                    while (p < hlen && sk == 1) {
                        var c = load8(hdr + p);
                        if (c == 32) { p = p + 1; }
                        else { if (c == 9) { p = p + 1; }
                            else { sk = 0; } }
                    }
                    if (p < hlen) {
                        if (load8(hdr + p) == 61) {
                            p = p + 1;
                            var sk2 = 1;
                            while (p < hlen && sk2 == 1) {
                                var c = load8(hdr + p);
                                if (c == 32) { p = p + 1; }
                                else { if (c == 9) { p = p + 1; }
                                    else { sk2 = 0; } }
                            }
                            var n = 0;
                            var any = 0;
                            var ovf = 0;
                            var d = 1;
                            while (p < hlen && d == 1) {
                                var c = load8(hdr + p);
                                if (c >= 48) {
                                    if (c <= 57) {
                                        n = n * 10 + (c - 48);
                                        if (n > PARSER_INT_CAP) { ovf = 1; d = 0; }
                                        any = 1;
                                        p = p + 1;
                                    } else { d = 0; }
                                } else { d = 0; }
                            }
                            # F-002 — reject overflow rather than wrap.
                            if (any == 1 && ovf == 0) { found = n; }
                        }
                    }
                }
            }
        }
        # advance to next line
        var le = 1;
        while (i < hlen && le == 1) {
            var c = load8(hdr + i);
            i = i + 1;
            if (c == 10) { le = 0; }
        }
    }
    return found;
}

# Find `char = "X"` in an entry header, return X (0..127) or -1.
fn _font_get_char(hdr, hlen): i64 {
    var i = 0;
    var found = 0 - 1;
    while (i < hlen && found < 0) {
        # skip leading ws
        var ls = 1;
        while (i < hlen && ls == 1) {
            var c = load8(hdr + i);
            if (c == 32) { i = i + 1; }
            else { if (c == 9) { i = i + 1; }
                else { ls = 0; } }
        }
        # match "char"
        if (i + 4 < hlen) {
            if (memeq(hdr + i, "char", 4) == 1) {
                var nc = load8(hdr + i + 4);
                if (nc == 32 || nc == 9 || nc == 61) {
                    var p = i + 4;
                    var sk = 1;
                    while (p < hlen && sk == 1) {
                        var c = load8(hdr + p);
                        if (c == 32) { p = p + 1; }
                        else { if (c == 9) { p = p + 1; }
                            else { sk = 0; } }
                    }
                    if (p < hlen) {
                        if (load8(hdr + p) == 61) {
                            p = p + 1;
                            var sk2 = 1;
                            while (p < hlen && sk2 == 1) {
                                var c = load8(hdr + p);
                                if (c == 32) { p = p + 1; }
                                else { if (c == 9) { p = p + 1; }
                                    else { sk2 = 0; } }
                            }
                            # expect "X" or "\X" (two escapes supported:
                            # \" -> 0x22, \\ -> 0x5C — needed for chars
                            # that would otherwise terminate the string).
                            if (p + 2 < hlen) {
                                if (load8(hdr + p) == 34) {
                                    var ch = load8(hdr + p + 1);
                                    var close_at = p + 2;
                                    if (ch == 92) {
                                        # escape: \" or \\
                                        if (p + 3 < hlen) {
                                            var esc = load8(hdr + p + 2);
                                            if (esc == 34) { ch = 34; close_at = p + 3; }
                                            else { if (esc == 92) { ch = 92; close_at = p + 3; }
                                                else { ch = 0 - 1; } }
                                        } else { ch = 0 - 1; }
                                    }
                                    if (ch >= 0) {
                                        if (close_at < hlen) {
                                            if (load8(hdr + close_at) == 34) {
                                                if (ch < CHARMAP_SIZE) { found = ch; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        # advance line
        var le = 1;
        while (i < hlen && le == 1) {
            var c = load8(hdr + i);
            i = i + 1;
            if (c == 10) { le = 0; }
        }
    }
    return found;
}

# Decode an entry body (after _cyml_trim) into row bytes.
# Expected shape: height rows of exactly width chars, each '.' or '#',
# separated by \n. '.' maps to space (32), '#' stays #.
# Writes into `dst` (height*width bytes). Returns 0 on success, -1 on shape error.
fn _font_decode_body(body, blen, width, height, dst): i64 {
    var pos = 0;
    var row = 0;
    while (row < height) {
        if (pos + width > blen) { return 0 - 1; }
        var col = 0;
        while (col < width) {
            var c = load8(body + pos + col);
            if (c == 46) {              # '.'
                store8(dst + row * width + col, 32);
            } else {
                if (c == 35) {          # '#'
                    store8(dst + row * width + col, 35);
                } else {
                    return 0 - 1;
                }
            }
            col = col + 1;
        }
        pos = pos + width;
        if (row + 1 < height) {
            if (pos >= blen) { return 0 - 1; }
            if (load8(body + pos) != 10) { return 0 - 1; }
            pos = pos + 1;
        } else {
            # Last row. The body must end here: only newlines may follow
            # (bayan's trim normally leaves none). Through 1.4.2 the
            # decoder checked one byte and ignored the rest, so a glyph
            # with more rows than `height` loaded with its surplus rows
            # silently dropped (issue 0008). Since 1.5.0 that is a load
            # failure: the format says "exactly height rows", and ADR 0002
            # ruling 3 does not protect a font that breaks a structural
            # rule.
            while (pos < blen) {
                if (load8(body + pos) != 10) { return 0 - 1; }
                pos = pos + 1;
            }
        }
        row = row + 1;
    }
    return 0;
}

# Load a font from a CYML file path. Returns Font* on success, 0 on error.
# Errors are bounded — file size, schema, geometry, body shape are all validated.
fn font_load_file(path): i64 {
    var len_box[8];
    store64(&len_box, 0);
    var buf = _slurp(path, MAX_FILE_BYTES, &len_box);
    if (buf == 0) { return 0; }
    var f = _font_parse(buf, load64(&len_box));
    # Safe to free: the Font copies its rows and charmap out of the
    # buffer, and the cyml doc pointing into it is dropped here.
    fl_free(buf);
    return f;
}

# Parse a CYML font held in memory (`total` bytes at `buf`) into a
# Font*, or 0. The whole of font_load_file after the read, split out so
# the read buffer can be freed in one place and so the fuzz harness
# (tests/bannermanor.fcyr) can drive the parser without a file.
fn _font_parse(buf, total): i64 {
    if (total <= 0) { return 0; }
    if (total >= MAX_FILE_BYTES) { return 0; }
    # Parse via lib/bayan-cyml.cyr
    var doc = bayan_cyml_parse(buf, total);
    if (doc == 0) { return 0; }

    # File header: schema, width, height, gap
    var fhdr = bayan_cyml_doc_header(doc);
    var fhlen = bayan_cyml_doc_header_len(doc);
    var schema = _font_get_int(fhdr, fhlen, "schema", 6);
    var width = _font_get_int(fhdr, fhlen, "width", 5);
    var height = _font_get_int(fhdr, fhlen, "height", 6);
    var gap = _font_get_int(fhdr, fhlen, "gap", 3);
    if (schema != SUPPORTED_SCHEMA) { return 0; }
    if (width <= 0) { return 0; }
    if (width > MAX_WIDTH) { return 0; }
    if (height <= 0) { return 0; }
    if (height > MAX_HEIGHT) { return 0; }
    if (gap < 0) { return 0; }
    if (gap > MAX_GAP) { return 0; }

    var count = bayan_cyml_doc_entry_count(doc);
    if (count <= 0) { return 0; }
    # MAX_GLYPHS. bayan used to stop its own scan at 256 entries (silent
    # truncation) so this could not fire; it no longer caps. No observable
    # change for bnrmr — the shipped fonts carry 69 entries, and a
    # >256-entry file is still rejected here rather than loading short.
    if (count > MAX_GLYPHS) { return 0; }

    var f = font_new(width, height, gap, count);
    if (f == 0) { return 0; }

    var ei = 0;
    var err = 0;
    while (ei < count && err == 0) {
        var e = bayan_cyml_doc_entry(doc, ei);
        var ehdr = bayan_cyml_entry_header(e);
        var ehlen = bayan_cyml_entry_header_len(e);
        var ebody = bayan_cyml_entry_body(e);
        var eblen = bayan_cyml_entry_body_len(e);

        var ch = _font_get_char(ehdr, ehlen);
        if (ch < 0) { err = 1; }
        else {
            if (font_set_char(f, ei, ch) < 0) { err = 1; }
            else {
                var dst = font_row(f, ei, 0);
                if (_font_decode_body(ebody, eblen, width, height, dst) < 0) {
                    err = 1;
                }
            }
        }
        ei = ei + 1;
    }
    if (err == 1) { return 0; }
    return f;
}

# Find `key = "value"` in a TOML-style header buffer and copy `value`
# bytes into dst (NUL-terminated). Returns the copied length, or -1 if
# the key is not found. A value that does not fit dst_cap is shortened
# to dst_cap - 4 bytes followed by "..." (1.6.0; it used to be -1).
# Used by font_header_load for `name = "..."` and `description = "..."`.
# Map a control byte to a space. Same predicate as the .flf glyph-row
# scrub in src/flf.cyr (F-001): C0 (0x00-0x1F), DEL (0x7F) and C1
# (0x80-0x9F). Applied to any font-supplied string that reaches stdout.
#
# The C1 arm means a UTF-8 continuation byte in this range becomes a
# space. That is deliberate: the CYML font schema is ASCII-only through
# v1.0 (ADR 0001), and a Latin-1 terminal would read those bytes as
# control codes.
#
# Not darshana's `tty_sanitize_buf`: its TTY_SANITIZE_LATIN1 mode
# neutralizes exactly this byte set (it was modeled on this rule) but
# replaces with '?', and darshana's ADR 0004 records that the space was
# deliberately not reproduced. A '?' would move frozen `.flf` glyph-row
# bytes, so bnrmr keeps its own loop. tests/bannermanor.tcyr pins the
# two byte sets equal (t_scrub_matches_darshana_latin1).
fn _scrub_ctl(b): i64 {
    if (b < 32) { return 32; }
    if (b == 127) { return 32; }
    if (b >= 128 && b <= 159) { return 32; }
    return b;
}

fn _font_get_str(hdr, hlen, key, key_len, dst, dst_cap): i64 {
    var i = 0;
    var found_len = 0 - 1;
    while (i < hlen && found_len < 0) {
        # skip leading ws
        var ls = 1;
        while (i < hlen && ls == 1) {
            var c = load8(hdr + i);
            if (c == 32) { i = i + 1; }
            else { if (c == 9) { i = i + 1; }
                else { ls = 0; } }
        }
        if (i + key_len < hlen) {
            if (memeq(hdr + i, key, key_len) == 1) {
                var nc = load8(hdr + i + key_len);
                if (nc == 32 || nc == 9 || nc == 61) {
                    var p = i + key_len;
                    var sk = 1;
                    while (p < hlen && sk == 1) {
                        var c = load8(hdr + p);
                        if (c == 32) { p = p + 1; }
                        else { if (c == 9) { p = p + 1; }
                            else { sk = 0; } }
                    }
                    if (p < hlen) {
                        if (load8(hdr + p) == 61) {
                            p = p + 1;
                            var sk2 = 1;
                            while (p < hlen && sk2 == 1) {
                                var c = load8(hdr + p);
                                if (c == 32) { p = p + 1; }
                                else { if (c == 9) { p = p + 1; }
                                    else { sk2 = 0; } }
                            }
                            # expect opening quote
                            if (p < hlen) {
                                if (load8(hdr + p) == 34) {
                                    p = p + 1;
                                    var start = p;
                                    var sc = 1;
                                    while (p < hlen && sc == 1) {
                                        var c = load8(hdr + p);
                                        if (c == 34) { sc = 0; }
                                        else { if (c == 10) { sc = 0; }
                                            else { p = p + 1; } }
                                    }
                                    if (p < hlen) {
                                        if (load8(hdr + p) == 34) {
                                            var vlen = p - start;
                                            # 1.6.0: a value too long for dst is
                                            # shortened to dst_cap - 4 bytes and
                                            # "..." (it used to be dropped:
                                            # found_len stayed -1).
                                            var cut = 0;
                                            if (vlen >= dst_cap && dst_cap > 4) {
                                                vlen = dst_cap - 4;
                                                cut = 1;
                                            }
                                            if (vlen < dst_cap) {
                                                # Scrub control bytes on the way
                                                # out (F-011). These strings are
                                                # printed verbatim by
                                                # --list-fonts, so an ESC here
                                                # is an ANSI-injection vector
                                                # exactly like the .flf glyph
                                                # rows F-001 closed. Copy byte by
                                                # byte instead of memcpy so the
                                                # filter cannot be bypassed.
                                                # Length-preserving, so column
                                                # alignment is unaffected.
                                                var ci = 0;
                                                while (ci < vlen) {
                                                    var vb = load8(hdr + start + ci);
                                                    store8(dst + ci, _scrub_ctl(vb));
                                                    ci = ci + 1;
                                                }
                                                if (cut == 1) {
                                                    memcpy(dst + vlen, "...", 3);
                                                    vlen = vlen + 3;
                                                }
                                                store8(dst + vlen, 0);
                                                found_len = vlen;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        # advance to next line
        var le = 1;
        while (i < hlen && le == 1) {
            var c = load8(hdr + i);
            i = i + 1;
            if (c == 10) { le = 0; }
        }
    }
    return found_len;
}

# Load only the [font] file header from a CYML font file. Cheaper than
# font_load_file: no glyph decode, no rows allocation. Used by
# --list-fonts. Returns FontHeader* on success, 0 on error.
#
# Validates the same header gates as font_load_file (schema, geometry)
# so a header loaded here is "trustworthy enough to print". It never
# decodes an entry, so a font with a bad body lists clean, and it
# requires `name`, which font_load_file never reads: the two loaders
# can disagree in both directions. Missing optional fields
# (description) become empty strings.
#
# --list-fonts calls this once per font file. Through 1.2.0 each call
# left its 64 KB read buffer in the bump heap (accepted risk A-09);
# since 1.4.1 it is freed before returning (issue 0014), so the
# listing's memory no longer grows with the number of fonts.
fn font_header_load(path): i64 {
    var len_box[8];
    store64(&len_box, 0);
    var buf = _slurp(path, MAX_FILE_BYTES, &len_box);
    if (buf == 0) { return 0; }
    var h = _font_header_parse(buf, load64(&len_box));
    fl_free(buf);       # the FontHeader holds copies, never pointers into buf
    return h;
}

# The header half of font_header_load, over an in-memory buffer.
fn _font_header_parse(buf, total): i64 {
    if (total <= 0) { return 0; }
    if (total >= MAX_FILE_BYTES) { return 0; }
    var doc = bayan_cyml_parse(buf, total);
    if (doc == 0) { return 0; }

    var fhdr = bayan_cyml_doc_header(doc);
    var fhlen = bayan_cyml_doc_header_len(doc);
    var schema = _font_get_int(fhdr, fhlen, "schema", 6);
    var width  = _font_get_int(fhdr, fhlen, "width", 5);
    var height = _font_get_int(fhdr, fhlen, "height", 6);
    var gap    = _font_get_int(fhdr, fhlen, "gap", 3);
    if (schema != SUPPORTED_SCHEMA) { return 0; }
    if (width <= 0)  { return 0; }
    if (width > MAX_WIDTH)  { return 0; }
    if (height <= 0) { return 0; }
    if (height > MAX_HEIGHT) { return 0; }
    if (gap < 0)     { return 0; }
    if (gap > MAX_GAP)    { return 0; }

    var h = alloc(H_SIZE);
    if (h == 0) { return 0; }
    var name_buf = alloc(HDR_NAME_CAP);
    if (name_buf == 0) { return 0; }
    var desc_buf = alloc(HDR_DESC_CAP);
    if (desc_buf == 0) { return 0; }
    store8(name_buf, 0);
    store8(desc_buf, 0);

    # Both strings are optional since 1.6.0, and one too long for its
    # buffer is shortened with "..." (_font_get_str). Through 1.5.0 the
    # listing needed `name`, so this loader rejected a font without one
    # (or with one over 63 bytes) although the font rendered. The listing
    # now shows file stems (ADR 0003) and validates with font_load_file,
    # so `name` is metadata here, as everywhere else.
    _font_get_str(fhdr, fhlen, "name", 4, name_buf, HDR_NAME_CAP);
    _font_get_str(fhdr, fhlen, "description", 11, desc_buf, HDR_DESC_CAP);

    store64(h + H_WIDTH, width);
    store64(h + H_HEIGHT, height);
    store64(h + H_GAP, gap);
    store64(h + H_NAME, name_buf);
    store64(h + H_DESC, desc_buf);
    return h;
}
