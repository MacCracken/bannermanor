# bannermanor / bnrmr — main entry point.
#
# M2: argv parsing supports `--font NAME` (resolves to fonts/NAME.cyml
# relative to cwd). With no flag, the embedded block font is used so
# `bnrmr "hello"` works with zero config files on disk.
#
# Full flag surface (--align, --width, --pad, --color, --list-fonts)
# lands in M4 / M5; this milestone just adds --font.
#
# Stdlib (string, args, alloc, io, cyml) auto-included via cyrius.cyml.

include "src/render.cyr"
include "src/font_block.cyr"
include "lib/fs.cyr"
include "lib/fmt.cyr"

enum MainLimits {
    BUF_CAP = 1024;
    FONT_NAME_CAP = 64;
}

fn streq_lit(s, lit): i64 {
    var sl = strlen(s);
    var ll = strlen(lit);
    if (sl != ll) { return 0; }
    return memeq(s, lit, sl);
}

# Build "fonts/<name>.cyml" into out, null-terminated. Returns 0 if
# the name is empty, too long, or contains a byte that we won't allow
# (path separators, dots, control chars — keeps --font scoped to
# `fonts/` regardless of caller intent).
fn build_font_path(out, out_cap, name): i64 {
    var nlen = strlen(name);
    if (nlen <= 0) { return 0; }
    if (nlen > 64) { return 0; }
    var i = 0;
    while (i < nlen) {
        var c = load8(name + i);
        if (c == 47)  { return 0; }   # '/'
        if (c == 92)  { return 0; }   # '\'
        if (c == 46)  { return 0; }   # '.'
        if (c < 32)   { return 0; }
        if (c == 127) { return 0; }
        i = i + 1;
    }
    # "fonts/" + name + ".cyml" + NUL = 6 + nlen + 5 + 1
    var need = 12 + nlen;
    if (need > out_cap) { return 0; }
    memcpy(out + 0, "fonts/", 6);
    memcpy(out + 6, name, nlen);
    memcpy(out + 6 + nlen, ".cyml", 5);
    store8(out + 11 + nlen, 0);
    return 11 + nlen;
}

fn print_usage(): i64 {
    println("bnrmr — figlet-equivalent ASCII-art banner generator");
    println("");
    println("Usage:");
    println("  bnrmr TEXT...           render TEXT with the default font");
    println("  bnrmr --font NAME TEXT  render TEXT with fonts/NAME.cyml");
    println("  bnrmr --list-fonts      list available fonts in ./fonts");
    println("  bnrmr --version         print version and exit");
    println("  bnrmr --help            print this help and exit");
    println("");
    println("Coverage (M2): A-Z, 0-9, space. Lowercase is upcased.");
    println("Other characters render as blank glyphs.");
    return 0;
}

# Lexicographic Str compare (byte-wise). Returns <0 / 0 / >0.
fn _str_lex_cmp(a, b): i64 {
    var al = str_len(a);
    var bl = str_len(b);
    var ad = str_data(a);
    var bd = str_data(b);
    var n = al;
    if (bl < n) { n = bl; }
    var i = 0;
    while (i < n) {
        var ac = load8(ad + i);
        var bc = load8(bd + i);
        if (ac != bc) { return ac - bc; }
        i = i + 1;
    }
    return al - bl;
}

# Insertion sort vec of Str in place. Fine for 3–5 fonts.
fn _sort_paths(v): i64 {
    var n = vec_len(v);
    var i = 1;
    while (i < n) {
        var cur = vec_get(v, i);
        var j = i - 1;
        var done = 0;
        while (j >= 0 && done == 0) {
            var prev = vec_get(v, j);
            if (_str_lex_cmp(prev, cur) > 0) {
                vec_set(v, j + 1, prev);
                j = j - 1;
            } else { done = 1; }
        }
        vec_set(v, j + 1, cur);
        i = i + 1;
    }
    return 0;
}

# Print a cstring padded with trailing spaces to width `w`. If the
# cstring is already >= w bytes, prints it as-is followed by a single
# space (so adjacent columns don't collide).
fn _print_padded(cstr, w): i64 {
    var n = strlen(cstr);
    syscall(1, 1, cstr, n);
    if (n >= w) {
        syscall(1, 1, " ", 1);
        return 0;
    }
    var pad = w - n;
    while (pad > 0) {
        syscall(1, 1, " ", 1);
        pad = pad - 1;
    }
    return 0;
}

# --list-fonts handler. Walks ./fonts, sorts alphabetically, prints
# one line per font: "  NAME  WxH gap=N  DESCRIPTION".
# Returns 0 on success (incl. empty fonts/ dir), 1 on internal error.
fn cmd_list_fonts(): i64 {
    var dir = str_from("fonts");
    var ext = str_from(".cyml");
    var files = find_files(dir, ext);
    _sort_paths(files);

    println("Available fonts (fonts/):");
    println("");

    var nf = vec_len(files);
    if (nf == 0) {
        println("  (none found — try running from the project root)");
        return 0;
    }

    var i = 0;
    while (i < nf) {
        var path_str = vec_get(files, i);
        var path_cstr = str_cstr(path_str);
        var h = font_header_load(path_cstr);
        if (h == 0) {
            # Malformed font — surface the path but skip.
            syscall(1, 1, "  ", 2);
            syscall(1, 1, str_data(path_str), str_len(path_str));
            println("  (malformed — skipped)");
        } else {
            syscall(1, 1, "  ", 2);
            _print_padded(font_hdr_name(h), 10);
            syscall(1, 1, " ", 1);
            fmt_int(font_hdr_width(h));
            syscall(1, 1, "x", 1);
            fmt_int(font_hdr_height(h));
            syscall(1, 1, " gap=", 5);
            fmt_int(font_hdr_gap(h));
            syscall(1, 1, "  ", 2);
            var desc = font_hdr_desc(h);
            syscall(1, 1, desc, strlen(desc));
            syscall(1, 1, "\n", 1);
        }
        i = i + 1;
    }
    return 0;
}

# Concatenate argv[start..argc-1] into out, separated by single spaces.
# Returns total bytes written, or -1 if it would overflow out_cap.
fn join_argv_from(out, out_cap, start): i64 {
    var ac = argc();
    var n: i64 = 0;
    var i = start;
    while (i < ac) {
        var arg = argv(i);
        var alen = strlen(arg);
        if (n > 0) {
            if (n + 1 > out_cap) { return 0 - 1; }
            store8(out + n, 32);
            n = n + 1;
        }
        if (n + alen > out_cap) { return 0 - 1; }
        memcpy(out + n, arg, alen);
        n = n + alen;
        i = i + 1;
    }
    return n;
}

fn main(): i64 {
    alloc_init();
    args_init();

    var ac = argc();
    if (ac <= 1) {
        print_usage();
        return 0;
    }

    var first = argv(1);
    if (streq_lit(first, "--version") == 1) {
        println("bnrmr 0.3.0");
        return 0;
    }
    if (streq_lit(first, "--help") == 1) {
        print_usage();
        return 0;
    }
    if (streq_lit(first, "--list-fonts") == 1) {
        return cmd_list_fonts();
    }

    # Resolve font: default to embedded, or load via --font NAME.
    var font = 0;
    var text_start = 1;
    if (streq_lit(first, "--font") == 1) {
        if (ac < 3) {
            println("bnrmr: --font requires a font name");
            return 1;
        }
        var fname = argv(2);
        var pathbuf[80];
        var plen = build_font_path(&pathbuf, 80, fname);
        if (plen <= 0) {
            println("bnrmr: invalid font name");
            return 1;
        }
        font = font_load_file(&pathbuf);
        if (font == 0) {
            println("bnrmr: failed to load font (missing or malformed)");
            return 1;
        }
        text_start = 3;
    } else {
        font = block_font_embed();
        if (font == 0) {
            println("bnrmr: failed to build embedded font");
            return 1;
        }
    }

    if (text_start >= ac) {
        print_usage();
        return 0;
    }

    var buf[1024];
    var n = join_argv_from(&buf, 1024, text_start);
    if (n < 0) {
        println("bnrmr: input too long (max 1024 bytes)");
        return 1;
    }
    if (n == 0) {
        print_usage();
        return 0;
    }

    render(font, &buf, n);
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
