# bannermanor / bnrmr — main entry point.
#
# Flag surface (M2 + M3 + M4):
#   --version              print version and exit
#   --help            -h   print help and exit
#   --font NAME       -f   load fonts/NAME.cyml (default: embedded block)
#   --list-fonts           list available fonts in ./fonts and exit
#   --align V              left | center | right (default: left)
#   --width N         -w   truncate at glyph boundary so no row >N cols
#                          (default: 0 = unlimited)
#   --pad N                blank lines above and below banner
#                          (default: 0)
#
# Long flags accept both `--name value` and `--name=value` (handled by
# lib/flags.cyr). Positional args are concatenated with spaces into the
# render text, subject to a 1 KB cap.

include "src/render.cyr"
include "src/font_block.cyr"
include "lib/flags.cyr"
include "lib/fs.cyr"
include "lib/fmt.cyr"

enum MainLimits {
    BUF_CAP = 1024;
    FONT_NAME_CAP = 64;
}

# Build "fonts/<name>.cyml" into out, null-terminated. Returns 0 if
# the name is empty, too long, or contains a byte that we won't allow
# (path separators, dots, control chars — keeps --font scoped to
# `fonts/` regardless of caller intent).
fn build_font_path(out, out_cap, name): i64 {
    var nlen = strlen(name);
    if (nlen <= 0) { return 0; }
    if (nlen > 64) { return 0; }
    var i = 0;
    while (i < nlen) {
        var c = load8(name + i);
        if (c == 47)  { return 0; }   # '/'
        if (c == 92)  { return 0; }   # '\'
        if (c == 46)  { return 0; }   # '.'
        if (c < 32)   { return 0; }
        if (c == 127) { return 0; }
        i = i + 1;
    }
    var need = 12 + nlen;
    if (need > out_cap) { return 0; }
    memcpy(out + 0, "fonts/", 6);
    memcpy(out + 6, name, nlen);
    memcpy(out + 6 + nlen, ".cyml", 5);
    store8(out + 11 + nlen, 0);
    return 11 + nlen;
}

fn print_usage(): i64 {
    println("bnrmr — figlet-equivalent ASCII-art banner generator");
    println("");
    println("Usage:");
    println("  bnrmr [FLAGS] TEXT...");
    println("");
    println("Flags:");
    println("  -f, --font NAME       load fonts/NAME.cyml (default: embedded block)");
    println("      --align V         left | center | right (default: left)");
    println("  -w, --width N         truncate at glyph boundary at N columns");
    println("                        (default: 0 = unlimited; if N is smaller");
    println("                        than one glyph, nothing renders)");
    println("      --pad N           N blank lines above and below banner (default: 0)");
    println("      --list-fonts      list available fonts and exit");
    println("      --version         print version and exit");
    println("  -h, --help            print this help and exit");
    println("");
    println("Coverage: A-Z, 0-9, space, printable punctuation. Lowercase folds");
    println("to uppercase when the font has no lowercase glyphs. Unsupported");
    println("characters render as blank.");
    return 0;
}

# Lexicographic Str compare (byte-wise). Returns <0 / 0 / >0.
fn _str_lex_cmp(a, b): i64 {
    var al = str_len(a);
    var bl = str_len(b);
    var ad = str_data(a);
    var bd = str_data(b);
    var n = al;
    if (bl < n) { n = bl; }
    var i = 0;
    while (i < n) {
        var ac = load8(ad + i);
        var bc = load8(bd + i);
        if (ac != bc) { return ac - bc; }
        i = i + 1;
    }
    return al - bl;
}

# Insertion sort vec of Str in place. Fine for 3–5 fonts.
fn _sort_paths(v): i64 {
    var n = vec_len(v);
    var i = 1;
    while (i < n) {
        var cur = vec_get(v, i);
        var j = i - 1;
        var done = 0;
        while (j >= 0 && done == 0) {
            var prev = vec_get(v, j);
            if (_str_lex_cmp(prev, cur) > 0) {
                vec_set(v, j + 1, prev);
                j = j - 1;
            } else { done = 1; }
        }
        vec_set(v, j + 1, cur);
        i = i + 1;
    }
    return 0;
}

# Print a cstring padded with trailing spaces to width `w`. If the
# cstring is already >= w bytes, prints it as-is followed by a single
# space (so adjacent columns don't collide).
fn _print_padded(cstr, w): i64 {
    var n = strlen(cstr);
    syscall(1, 1, cstr, n);
    if (n >= w) {
        syscall(1, 1, " ", 1);
        return 0;
    }
    var pad = w - n;
    while (pad > 0) {
        syscall(1, 1, " ", 1);
        pad = pad - 1;
    }
    return 0;
}

# --list-fonts handler. Walks ./fonts, sorts alphabetically, prints
# one line per font: "  NAME  WxH gap=N  DESCRIPTION".
fn cmd_list_fonts(): i64 {
    var dir = str_from("fonts");
    var ext = str_from(".cyml");
    var files = find_files(dir, ext);
    _sort_paths(files);

    println("Available fonts (fonts/):");
    println("");

    var nf = vec_len(files);
    if (nf == 0) {
        println("  (none found — try running from the project root)");
        return 0;
    }

    var i = 0;
    while (i < nf) {
        var path_str = vec_get(files, i);
        var path_cstr = str_cstr(path_str);
        var h = font_header_load(path_cstr);
        if (h == 0) {
            syscall(1, 1, "  ", 2);
            syscall(1, 1, str_data(path_str), str_len(path_str));
            println("  (malformed — skipped)");
        } else {
            syscall(1, 1, "  ", 2);
            _print_padded(font_hdr_name(h), 10);
            syscall(1, 1, " ", 1);
            fmt_int(font_hdr_width(h));
            syscall(1, 1, "x", 1);
            fmt_int(font_hdr_height(h));
            syscall(1, 1, " gap=", 5);
            fmt_int(font_hdr_gap(h));
            syscall(1, 1, "  ", 2);
            var desc = font_hdr_desc(h);
            syscall(1, 1, desc, strlen(desc));
            syscall(1, 1, "\n", 1);
        }
        i = i + 1;
    }
    return 0;
}

# Map --align value cstring to AlignKind. Returns -1 if unrecognized.
fn parse_align(s): i64 {
    if (s == 0) { return ALIGN_LEFT; }
    if (streq(s, "left") == 1) { return ALIGN_LEFT; }
    if (streq(s, "L") == 1)    { return ALIGN_LEFT; }
    if (streq(s, "center") == 1) { return ALIGN_CENTER; }
    if (streq(s, "centre") == 1) { return ALIGN_CENTER; }
    if (streq(s, "C") == 1)      { return ALIGN_CENTER; }
    if (streq(s, "right") == 1) { return ALIGN_RIGHT; }
    if (streq(s, "R") == 1)     { return ALIGN_RIGHT; }
    return 0 - 1;
}

# Concatenate flags_positional(fs, 0..n-1) into out separated by spaces.
# Returns bytes written, or -1 on overflow.
fn join_positionals(out, out_cap, fs): i64 {
    var pc = flags_positional_count(fs);
    var n: i64 = 0;
    var i = 0;
    while (i < pc) {
        var arg = flags_positional(fs, i);
        var alen = strlen(arg);
        if (n > 0) {
            if (n + 1 > out_cap) { return 0 - 1; }
            store8(out + n, 32);
            n = n + 1;
        }
        if (n + alen > out_cap) { return 0 - 1; }
        memcpy(out + n, arg, alen);
        n = n + alen;
        i = i + 1;
    }
    return n;
}

# Pack argc()/argv(i) into a contiguous cstr* array on the stack.
# Required because flags_parse takes a raw pointer-array, not the
# `argv(n)` function.
fn build_argv_array(arr): i64 {
    var ac = argc();
    var i = 0;
    while (i < ac) {
        store64(arr + i * 8, argv(i));
        i = i + 1;
    }
    return ac;
}

fn main(): i64 {
    alloc_init();
    args_init();

    var ac = argc();
    if (ac <= 1) {
        print_usage();
        return 0;
    }
    if (ac > 256) {
        println("bnrmr: too many arguments");
        return 1;
    }

    var argv_arr[2048];                  # 256 slots × 8 bytes
    build_argv_array(&argv_arr);

    var fs = flags_new();
    var f_version    = flags_add_bool(fs, 0,   "version",    0, "print version and exit");
    var f_help       = flags_add_bool(fs, 104, "help",       0, "print help and exit");          # 'h'
    var f_list       = flags_add_bool(fs, 0,   "list-fonts", 0, "list available fonts and exit");
    var f_font       = flags_add_str (fs, 102, "font",       0, "font name (default: embedded block)");  # 'f'
    var f_align      = flags_add_str (fs, 0,   "align",      0, "left | center | right");
    var f_width      = flags_add_int (fs, 119, "width",      0, "truncate at N columns (0 = unlimited)"); # 'w'
    var f_pad        = flags_add_int (fs, 0,   "pad",        0, "N blank lines above and below");

    if (flags_parse(fs, ac, &argv_arr) != 0) {
        var err = flags_error(fs);
        if (err == FLAG_ERR_UNKNOWN) { println("bnrmr: unknown flag"); }
        else { if (err == FLAG_ERR_MISSING_VALUE) { println("bnrmr: flag missing value"); }
        else { if (err == FLAG_ERR_BAD_INT) { println("bnrmr: bad integer value"); }
        else { if (err == FLAG_ERR_BUNDLED) { println("bnrmr: bundled short flags not supported"); }
        else { println("bnrmr: argument parse error"); } } } }
        println("");
        print_usage();
        return 1;
    }

    if (flags_get_bool(fs, f_help) == 1) {
        print_usage();
        return 0;
    }
    if (flags_get_bool(fs, f_version) == 1) {
        println("bnrmr 0.4.0");
        return 0;
    }
    if (flags_get_bool(fs, f_list) == 1) {
        return cmd_list_fonts();
    }

    # Resolve --align (validate before doing real work)
    var align_str = flags_get_str(fs, f_align);
    var align = parse_align(align_str);
    if (align < 0) {
        println("bnrmr: --align must be left, center, or right");
        return 1;
    }

    var width = flags_get_int(fs, f_width);
    if (width < 0) {
        println("bnrmr: --width must be non-negative");
        return 1;
    }
    var pad = flags_get_int(fs, f_pad);
    if (pad < 0) {
        println("bnrmr: --pad must be non-negative");
        return 1;
    }

    # Resolve font: default to embedded, or load via --font NAME.
    var font = 0;
    var font_name = flags_get_str(fs, f_font);
    if (font_name != 0) {
        var pathbuf[80];
        var plen = build_font_path(&pathbuf, 80, font_name);
        if (plen <= 0) {
            println("bnrmr: invalid font name");
            return 1;
        }
        font = font_load_file(&pathbuf);
        if (font == 0) {
            println("bnrmr: failed to load font (missing or malformed)");
            return 1;
        }
    } else {
        font = block_font_embed();
        if (font == 0) {
            println("bnrmr: failed to build embedded font");
            return 1;
        }
    }

    var pc = flags_positional_count(fs);
    if (pc == 0) {
        print_usage();
        return 0;
    }

    var buf[1024];
    var n = join_positionals(&buf, 1024, fs);
    if (n < 0) {
        println("bnrmr: input too long (max 1024 bytes)");
        return 1;
    }
    if (n == 0) {
        print_usage();
        return 0;
    }

    render_layout(font, &buf, n, width, align, pad);
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
