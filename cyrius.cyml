[package]
name = "bannermanor"
version = "${file:VERSION}"
description = "BannerManor — figlet-equivalent ASCII-art banner generator for MOTDs, script intros, splash text. Heraldic welcome ceremony at the gate of your digital manor. Binary: bnrmr."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.7.9"

[build]
entry = "src/main.cyr"
test = "tests/bannermanor.tcyr"
output = "bnrmr"

[deps]
stdlib = ["string", "fmt", "alloc", "atomic", "io", "vec", "str", "syscalls", "assert", "bench", "args", "result", "flags", "fs", "fnptr", "freelist", "mmap"]

[deps.darshana]
# What bnrmr consumes, all inside darshana's frozen v1.0 surface
# (its ADR 0003 — names, arity, return contract and emitted bytes
# cannot move without a major bump):
#   tty_sgr, tty_sgr_reset, TTY_FG_*   --color (src/color.cyr, layout.cyr)
#   tty_winsize                        the stdout width / TTY probes
#                                      (src/layout.cyr, since 1.2.0 —
#                                      TIOCGWINSZ on Linux, the console
#                                      grid on AGNOS)
# The test suite also uses tty_has_ctl + TTY_SANITIZE_LATIN1, tty_raw /
# tty_cooked and tty_dec_buf.
# 1.3.0 (bumped from 1.0.0 at 1.2.0) declares private constants with
# `const`, so it needs cyrius >= 6.7.2; [package].cyrius is 6.7.9.
# Not adopted, deliberately: tty_sanitize_buf (replaces with '?';
# bnrmr's frozen rule replaces with a space), tty_winsize_or (treats
# 0 rows as unknown; bnrmr reads columns only), and the `_buf` SGR
# composers (one write per row — roadmap, with issue 0005).
git = "https://github.com/MacCracken/darshana.git"
tag = "1.3.0"
modules = ["dist/darshana.cyr"]

[deps.bayan]
# The CYML-only sublib, not the stdlib's full bayan bundle (issue 0013).
# What bnrmr consumes: bayan_cyml_parse, bayan_cyml_doc_header{,_len},
# bayan_cyml_doc_entry{,_count}, bayan_cyml_entry_header{,_len} and
# bayan_cyml_entry_body{,_len} (src/font.cyr). 1.5.13 is the bayan the
# cyrius 6.7.9 stdlib bundles, so the parser is byte-for-byte what 1.2.0
# ran; its cyml.cyr section is identical to the bundle's.
# The sublib's own stdlib needs (dist/bayan-cyml.deps: alloc, io, str,
# string, result, syscalls) are all in [deps].stdlib above.
git = "https://github.com/MacCracken/bayan.git"
tag = "1.5.13"
modules = ["dist/bayan-cyml.cyr"]
