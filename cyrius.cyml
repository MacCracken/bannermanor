[package]
name = "bannermanor"
version = "${file:VERSION}"
description = "BannerManor — figlet-equivalent ASCII-art banner generator for MOTDs, script intros, splash text. Heraldic welcome ceremony at the gate of your digital manor. Binary: bnrmr."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
test = "tests/bannermanor.tcyr"
output = "bnrmr"

[deps]
stdlib = ["string", "fmt", "alloc", "atomic", "io", "vec", "str", "syscalls", "assert", "bench", "args", "result", "fs", "fnptr", "freelist", "mmap"]

[deps.darshana]
# What bnrmr consumes, all inside darshana's frozen v1.0 surface
# (its ADR 0003 — names, arity, return contract and emitted bytes
# cannot move without a major bump):
#   tty_sgr_buf, tty_sgr_reset_buf,    --color, composed into each banner
#   TTY_FG_*                           row (src/layout.cyr, since 1.5.0;
#                                      through 1.4.2 the writing forms
#                                      tty_sgr / tty_sgr_reset, which are
#                                      these plus a write: same bytes)
#   tty_dec_buf                        --list-fonts geometry digits
#                                      (src/cli.cyr, since 1.5.0)
#   tty_winsize                        the stdout width / TTY probes
#                                      (src/layout.cyr, since 1.2.0 —
#                                      TIOCGWINSZ on Linux, the console
#                                      grid on AGNOS)
# The test suite also uses tty_has_ctl + TTY_SANITIZE_LATIN1 and tty_raw /
# tty_cooked.
# 1.7.0 (bumped from 1.3.0 at 1.8.2) pins cyrius 6.7.18, as bnrmr does.
# 1.3.1..1.7.0 add functions bnrmr does not call (tty_sgr_len,
# tty_sgr_strip_buf, tty_isatty_is_per_fd, tty_winsize_px) and change
# three AGNOS peers it does not call either (tty_isatty, tty_echo_off,
# tty_flush_input). Every function bnrmr calls has 1.3.0's body
# (tty_cooked, test-only, changed only on AGNOS), and the 19 digests
# darshana froze through 1.3.0 are unchanged (1.4.0 added a 20th). Its
# AGNOS arm needs cyrius >= 6.7.11; [package].cyrius is 6.7.18.
# Not adopted, deliberately: tty_sanitize_buf (replaces with '?';
# bnrmr's frozen rule replaces with a space), tty_winsize_or (treats
# 0 rows as unknown; bnrmr reads columns only), and the per-fd AGNOS
# tty_isatty (1.5.0; it counts FDK_CHAN, which bnrmr does not: ADR
# 0004, roadmap 1.9.0).
git = "https://github.com/MacCracken/darshana.git"
tag = "1.7.0"
modules = ["dist/darshana.cyr"]

[deps.bayan]
# The CYML-only sublib, not the stdlib's full bayan bundle (issue 0013).
# What bnrmr consumes: bayan_cyml_parse, bayan_cyml_doc_header{,_len},
# bayan_cyml_doc_entry{,_count}, bayan_cyml_entry_header{,_len} and
# bayan_cyml_entry_body{,_len} (src/font.cyr). 1.11.1 is the bayan the
# cyrius 6.7.18 stdlib bundles (1.5.14 with 6.7.11, through 1.8.1), so
# the sublib's cyml.cyr section is the bundle's. It carries bayan 1.6.0's
# marker-to-marker scan (the fix for issue 0006, filed by 1.8.1) and
# 1.6.1's line-to-line `---` search, plus two reading changes that no
# shipped font meets (golden unchanged): 1.7.0 makes markers and `---`
# whole lines wherever they fall, so two adjacent [[entries]] lines open
# an empty entry and that font no longer loads; 1.8.0 lets a CR LF end
# one, so a one-row CR LF font now loads (CHANGELOG [1.8.2]).
# The sublib's own stdlib needs (dist/bayan-cyml.deps: alloc, io, str,
# string, result, syscalls) are all in [deps].stdlib above.
git = "https://github.com/MacCracken/bayan.git"
tag = "1.11.1"
modules = ["dist/bayan-cyml.cyr"]

[deps.cmdit]
# The CLI parser (1.4.2), replacing the stdlib's `flags` module. cmdit is
# lib/flags.cyr productized as a distlib: same getopt-long core and error
# codes 0..4, plus the argv bridge (cmdit_argv) that replaced bnrmr's own
# build_argv_array. What bnrmr uses: cmdit_new, cmdit_version_short (to
# drop the auto -V: the freeze adds no flags), cmdit_bool, cmdit_str,
# cmdit_argv, cmdit_parse, cmdit_parse_argv (tests), cmdit_error,
# cmdit_get_bool, cmdit_get_str, cmdit_positional{,_count}. Help text, the
# --version literal and every value check stay bnrmr's own (src/cli.cyr).
# 1.5.0 (bumped from 1.4.0 at 1.8.2) pins cyrius 6.7.18, as bnrmr does.
# What moved for bnrmr: cmdit_argv refuses only a command line of exactly
# 2 MiB (1.4.2), since stdlib args_init reads past 2 MiB from 6.7.12; the
# rest is completion-script text bnrmr never emits. Its stdlib needs
# (dist/cmdit.deps: args, alloc, string, io) are all in [deps].stdlib
# above.
git = "https://github.com/MacCracken/cmdit.git"
tag = "1.5.0"
modules = ["dist/cmdit.cyr"]
