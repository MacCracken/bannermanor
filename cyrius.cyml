[package]
name = "bannermanor"
version = "${file:VERSION}"
description = "BannerManor — figlet-equivalent ASCII-art banner generator for MOTDs, script intros, splash text. Heraldic welcome ceremony at the gate of your digital manor. Binary: bnrmr."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.2.24"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "bnrmr"

[deps]
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "syscalls", "assert", "bench", "args", "bayan", "result", "flags"]

[deps.darshana]
# SGR primitives (tty_sgr, tty_sgr_reset, TTY_FG_*) for --color.
# Bumped to 0.7.1 (2026-06-19). The `tty_sgr` / `tty_sgr_reset`
# / `TTY_FG_*` symbols bannermanor consumes remain present and
# byte-stable; the `_buf` family (tty_sgr_buf, tty_fg_rgb_buf, ...)
# is still unused here — adopting it is a future bite if bnrmr ever
# wants single-write frame emission for piped output.
git = "https://github.com/MacCracken/darshana.git"
tag = "0.7.1"
modules = ["dist/darshana.cyr"]
