[package]
name = "bannermanor"
version = "${file:VERSION}"
description = "BannerManor — figlet-equivalent ASCII-art banner generator for MOTDs, script intros, splash text. Heraldic welcome ceremony at the gate of your digital manor. Binary: bnrmr."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.0.1"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "bnrmr"

[deps]
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "syscalls", "assert", "bench", "args", "cyml", "result", "flags"]

[deps.darshana]
# Path-based during development so we can iterate on darshana 0.3.5
# (SGR helpers) in the same session. Switch to git+tag at release-cut
# time once 0.3.5 is pushed:
#   git = "https://github.com/MacCracken/darshana.git"
#   tag = "0.3.5"
path = "../darshana"
modules = ["dist/darshana.cyr"]
