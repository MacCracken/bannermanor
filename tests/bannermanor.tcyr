# bannermanor test suite — M1 + M2 coverage.
#
# Covers:
#   - block_font_embed builds a Font with the expected geometry
#   - font_glyph_index covers space, digits, upper, lowercase folding,
#     and rejects unsupported chars
#   - every glyph row is exactly `width` bytes containing only space/'#'
#   - render rejects oversized input
#   - font_load_file parses fonts/block.cyml and matches the embedded
#     font byte-for-byte (M2 acceptance)
#   - font_load_file rejects malformed fixtures (bad schema, bad body
#     byte, wrong row count) and missing files

include "src/render.cyr"
include "src/font_block.cyr"
include "src/flf.cyr"

# ---- smoke ----

fn t_smoke() {
    test_group("smoke");
    assert(1, "true is true");
    assert_eq(1 + 1, 2, "math works");
}

# ---- embedded font geometry ----

fn t_embedded_geometry() {
    test_group("block_font_embed / geometry");
    var f = block_font_embed();
    assert(f != 0, "embedded font built");
    assert_eq(font_width(f),  5,  "width = 5");
    assert_eq(font_height(f), 5,  "height = 5");
    assert_eq(font_gap(f),    1,  "gap = 1");
    assert_eq(font_count(f),  69, "count = 69");
}

# ---- glyph index coverage ----

fn t_glyph_space() {
    test_group("font_glyph_index / space");
    var f = block_font_embed();
    assert(font_glyph_index(f, 32) >= 0, "space resolves to a glyph");
}

fn t_glyph_digits() {
    test_group("font_glyph_index / digits");
    var f = block_font_embed();
    var c = 48;
    while (c <= 57) {
        assert(font_glyph_index(f, c) >= 0, "digit resolves");
        c = c + 1;
    }
}

fn t_glyph_upper() {
    test_group("font_glyph_index / upper");
    var f = block_font_embed();
    var c = 65;
    while (c <= 90) {
        assert(font_glyph_index(f, c) >= 0, "upper resolves");
        c = c + 1;
    }
}

fn t_glyph_lower_folds() {
    test_group("font_glyph_index / lowercase folds to upper");
    var f = block_font_embed();
    var c = 97;
    var u = 65;
    while (c <= 122) {
        assert_eq(font_glyph_index(f, c), font_glyph_index(f, u), "fold");
        c = c + 1;
        u = u + 1;
    }
}

fn t_glyph_unsupported() {
    test_group("font_glyph_index / unsupported");
    var f = block_font_embed();
    # After M3, block covers all printable ASCII (32..126), so the
    # unsupported set is now NUL, control chars, DEL, and >127.
    assert_eq(font_glyph_index(f, 0),   0 - 1, "NUL -> -1");
    assert_eq(font_glyph_index(f, 1),   0 - 1, "SOH -> -1");
    assert_eq(font_glyph_index(f, 7),   0 - 1, "BEL -> -1");
    assert_eq(font_glyph_index(f, 9),   0 - 1, "TAB -> -1");
    assert_eq(font_glyph_index(f, 10),  0 - 1, "LF -> -1");
    assert_eq(font_glyph_index(f, 31),  0 - 1, "US (last C0) -> -1");
    assert_eq(font_glyph_index(f, 127), 0 - 1, "DEL -> -1");
    assert_eq(font_glyph_index(f, 200), 0 - 1, "high byte -> -1");
}

fn t_glyph_punctuation() {
    test_group("font_glyph_index / punctuation (M3)");
    var f = block_font_embed();
    # Every printable-ASCII punctuation char should resolve.
    assert(font_glyph_index(f, 33)  >= 0, "'!' resolves");
    assert(font_glyph_index(f, 34)  >= 0, "'\"' resolves");
    assert(font_glyph_index(f, 35)  >= 0, "'#' resolves");
    assert(font_glyph_index(f, 36)  >= 0, "'$' resolves");
    assert(font_glyph_index(f, 37)  >= 0, "'%' resolves");
    assert(font_glyph_index(f, 38)  >= 0, "'&' resolves");
    assert(font_glyph_index(f, 39)  >= 0, "''' resolves");
    assert(font_glyph_index(f, 40)  >= 0, "'(' resolves");
    assert(font_glyph_index(f, 41)  >= 0, "')' resolves");
    assert(font_glyph_index(f, 42)  >= 0, "'*' resolves");
    assert(font_glyph_index(f, 43)  >= 0, "'+' resolves");
    assert(font_glyph_index(f, 44)  >= 0, "',' resolves");
    assert(font_glyph_index(f, 45)  >= 0, "'-' resolves");
    assert(font_glyph_index(f, 46)  >= 0, "'.' resolves");
    assert(font_glyph_index(f, 47)  >= 0, "'/' resolves");
    assert(font_glyph_index(f, 58)  >= 0, "':' resolves");
    assert(font_glyph_index(f, 59)  >= 0, "';' resolves");
    assert(font_glyph_index(f, 60)  >= 0, "'<' resolves");
    assert(font_glyph_index(f, 61)  >= 0, "'=' resolves");
    assert(font_glyph_index(f, 62)  >= 0, "'>' resolves");
    assert(font_glyph_index(f, 63)  >= 0, "'?' resolves");
    assert(font_glyph_index(f, 64)  >= 0, "'@' resolves");
    assert(font_glyph_index(f, 91)  >= 0, "'[' resolves");
    assert(font_glyph_index(f, 92)  >= 0, "'\\' resolves");
    assert(font_glyph_index(f, 93)  >= 0, "']' resolves");
    assert(font_glyph_index(f, 94)  >= 0, "'^' resolves");
    assert(font_glyph_index(f, 95)  >= 0, "'_' resolves");
    assert(font_glyph_index(f, 96)  >= 0, "'`' resolves");
    assert(font_glyph_index(f, 123) >= 0, "'{' resolves");
    assert(font_glyph_index(f, 124) >= 0, "'|' resolves");
    assert(font_glyph_index(f, 125) >= 0, "'}' resolves");
    assert(font_glyph_index(f, 126) >= 0, "'~' resolves");
}

fn t_glyph_fold_is_fallback() {
    test_group("font_glyph_index / lowercase fold is fallback");
    var f = block_font_embed();
    # block.cyml ships uppercase only, so lowercase must fall back.
    var c = 97;
    var u = 65;
    while (c <= 122) {
        assert_eq(font_glyph_index(f, c), font_glyph_index(f, u),
                  "lowercase falls back to uppercase when no lowercase glyph");
        c = c + 1;
        u = u + 1;
    }
}

# ---- row shape ----

fn t_row_shape() {
    test_group("font_row / shape");
    var f = block_font_embed();
    var w = font_width(f);
    var h = font_height(f);
    var count = font_count(f);
    var i = 0;
    while (i < count) {
        var r = 0;
        while (r < h) {
            var p = font_row(f, i, r);
            var col = 0;
            while (col < w) {
                var c = load8(p + col);
                # Each byte must be space (32) or '#' (35).
                var ok = 0;
                if (c == 32) { ok = 1; }
                if (c == 35) { ok = 1; }
                assert_eq(ok, 1, "row byte is space or '#'");
                col = col + 1;
            }
            r = r + 1;
        }
        i = i + 1;
    }
}

# ---- render bounds ----

fn t_render_bounds() {
    test_group("render / bounds");
    var f = block_font_embed();
    var big[1];
    assert_eq(render(f, &big, 0 - 1),  0 - 1, "negative len -> -1");
    assert_eq(render(f, &big, 1025),   0 - 1, "over-cap -> -1");
    assert_eq(render(f, &big, 9999),   0 - 1, "way-over-cap -> -1");
    assert_eq(render(0, &big, 5),      0 - 2, "null font -> -2");
}

# ---- CYML loader (M2) ----

fn t_load_block_cyml() {
    test_group("font_load_file / fonts/block.cyml");
    var f = font_load_file("fonts/block.cyml");
    assert(f != 0, "loaded");
    assert_eq(font_width(f),  5,  "width");
    assert_eq(font_height(f), 5,  "height");
    assert_eq(font_gap(f),    1,  "gap");
    assert_eq(font_count(f),  69, "count");
}

# M2 acceptance: the loaded font must agree with the embedded font on
# every char's glyph index AND every glyph's row bytes — i.e. the file
# and the in-source data are interchangeable.
fn t_loaded_matches_embedded() {
    test_group("M2 acceptance / loaded == embedded");
    var emb = block_font_embed();
    var ldr = font_load_file("fonts/block.cyml");
    assert(ldr != 0, "loaded");
    assert_eq(font_width(ldr),  font_width(emb),  "width matches");
    assert_eq(font_height(ldr), font_height(emb), "height matches");
    assert_eq(font_gap(ldr),    font_gap(emb),    "gap matches");
    assert_eq(font_count(ldr),  font_count(emb),  "count matches");

    # Every ASCII char must map to the same glyph index in both fonts.
    var c = 0;
    while (c < 128) {
        assert_eq(font_glyph_index(ldr, c), font_glyph_index(emb, c),
                  "glyph index per char matches");
        c = c + 1;
    }

    # Every glyph's rows must be byte-identical.
    var w = font_width(emb);
    var h = font_height(emb);
    var idx = 0;
    while (idx < 69) {
        var r = 0;
        while (r < h) {
            var ep = font_row(emb, idx, r);
            var lp = font_row(ldr, idx, r);
            assert_eq(memeq(ep, lp, w), 1, "row bytes match");
            r = r + 1;
        }
        idx = idx + 1;
    }
}

fn t_load_missing() {
    test_group("font_load_file / missing");
    assert_eq(font_load_file("fonts/__does_not_exist__.cyml"), 0, "missing -> 0");
}

fn t_load_malformed() {
    test_group("font_load_file / malformed");
    assert_eq(font_load_file("tests/fixtures/bad_schema.cyml"),     0, "bad schema -> 0");
    assert_eq(font_load_file("tests/fixtures/bad_body_byte.cyml"),  0, "bad body byte -> 0");
    assert_eq(font_load_file("tests/fixtures/wrong_row_count.cyml"), 0, "wrong row count -> 0");
}

# ---- header loader (M3, --list-fonts) ----

fn t_header_load_block() {
    test_group("font_header_load / fonts/block.cyml");
    var h = font_header_load("fonts/block.cyml");
    assert(h != 0, "header loaded");
    assert_eq(font_hdr_width(h),  5, "header width = 5");
    assert_eq(font_hdr_height(h), 5, "header height = 5");
    assert_eq(font_hdr_gap(h),    1, "header gap = 1");
    var name = font_hdr_name(h);
    assert_eq(strlen(name), 5, "name length = 5");
    assert_eq(memeq(name, "block", 5), 1, "name = block");
    var desc = font_hdr_desc(h);
    assert(strlen(desc) > 0, "description present");
}

fn t_header_load_missing() {
    test_group("font_header_load / missing");
    assert_eq(font_header_load("fonts/__nope__.cyml"), 0, "missing -> 0");
}

fn t_load_big_cyml() {
    test_group("font_load_file / fonts/big.cyml");
    var f = font_load_file("fonts/big.cyml");
    assert(f != 0, "loaded");
    assert_eq(font_width(f),  7,  "big width = 7");
    assert_eq(font_height(f), 7,  "big height = 7");
    assert_eq(font_gap(f),    1,  "big gap = 1");
    assert_eq(font_count(f),  69, "big count = 69 (full printable ASCII)");

    # Every printable-ASCII char resolves.
    var c = 32;
    while (c <= 126) {
        assert(font_glyph_index(f, c) >= 0, "printable char resolves");
        c = c + 1;
    }

    # AGNOS acceptance.
    assert(font_glyph_index(f, 65) >= 0, "A resolves");
    assert(font_glyph_index(f, 71) >= 0, "G resolves");
    assert(font_glyph_index(f, 78) >= 0, "N resolves");
    assert(font_glyph_index(f, 79) >= 0, "O resolves");
    assert(font_glyph_index(f, 83) >= 0, "S resolves");

    # Fold-fallback: 'a' must resolve to 'A''s glyph.
    assert_eq(font_glyph_index(f, 97), font_glyph_index(f, 65),
              "'a' folds to 'A' on big");
}

fn t_load_slim_cyml() {
    test_group("font_load_file / fonts/slim.cyml");
    var f = font_load_file("fonts/slim.cyml");
    assert(f != 0, "loaded");
    assert_eq(font_width(f),  4,  "slim width = 4");
    assert_eq(font_height(f), 5,  "slim height = 5");
    assert_eq(font_gap(f),    1,  "slim gap = 1");
    assert_eq(font_count(f),  69, "slim count = 69 (full printable ASCII)");

    # Every printable-ASCII char must resolve.
    var c = 32;
    while (c <= 126) {
        assert(font_glyph_index(f, c) >= 0, "printable char resolves");
        c = c + 1;
    }

    # AGNOS — the M3 acceptance bar for every shipped font.
    assert(font_glyph_index(f, 65) >= 0, "A resolves");
    assert(font_glyph_index(f, 71) >= 0, "G resolves");
    assert(font_glyph_index(f, 78) >= 0, "N resolves");
    assert(font_glyph_index(f, 79) >= 0, "O resolves");
    assert(font_glyph_index(f, 83) >= 0, "S resolves");

    # Fold-fallback should still kick in: slim has no lowercase glyphs,
    # so 'a' must resolve to the same index as 'A'.
    assert_eq(font_glyph_index(f, 97), font_glyph_index(f, 65),
              "'a' folds to 'A' on slim");
}

# ---- M4 layout ----

fn t_layout_banner_width() {
    test_group("layout / banner_width");
    # 1 glyph: just width
    assert_eq(banner_width(1, 5, 1), 5,  "1 glyph @ 5w gap=1 -> 5");
    # 2 glyphs: w + gap + w
    assert_eq(banner_width(2, 5, 1), 11, "2 glyphs @ 5w gap=1 -> 11");
    # 5 glyphs at block: 5*5 + 4*1 = 29
    assert_eq(banner_width(5, 5, 1), 29, "AGNOS-shape banner -> 29 cols");
    # n=0 -> 0 (no glyphs, no gaps)
    assert_eq(banner_width(0, 5, 1), 0,  "0 glyphs -> 0");
    # gap=0 means flush glyphs
    assert_eq(banner_width(3, 4, 0), 12, "3 glyphs @ 4w gap=0 -> 12");
}

fn t_layout_fit_chars() {
    test_group("layout / fit_chars");
    # frame=0 (unlimited): pass through len untouched
    assert_eq(fit_chars(0, 5, 1, 10), 10, "frame=0 unlimited");
    assert_eq(fit_chars(0, 5, 1, 0),  0,  "frame=0 + len=0");
    # exact fits at block geometry (w=5, gap=1)
    assert_eq(fit_chars(5,  5, 1, 10), 1, "frame=5  -> 1 glyph fits");
    assert_eq(fit_chars(11, 5, 1, 10), 2, "frame=11 -> 2 glyphs fit");
    assert_eq(fit_chars(17, 5, 1, 10), 3, "frame=17 -> 3 glyphs fit");
    # one byte short of a 4th glyph — still 3
    assert_eq(fit_chars(22, 5, 1, 10), 3, "frame=22 -> still 3 glyphs (4th needs 23)");
    assert_eq(fit_chars(23, 5, 1, 10), 4, "frame=23 -> 4 glyphs fit");
    # frame wider than text: capped by len
    assert_eq(fit_chars(80, 5, 1, 5),  5, "frame=80 + 5-char text -> 5");
    # frame=20 + AGNOSTIC (8 chars): 3 glyphs fit (17 cols), 4th needs 23
    assert_eq(fit_chars(20, 5, 1, 8),  3, "frame=20 AGNOSTIC -> AGN (3 glyphs)");
    # roadmap acceptance: --width 80 + "hi"
    assert_eq(fit_chars(80, 5, 1, 2),  2, "frame=80 'hi' -> both glyphs (no truncation)");
    # frame too small for even one glyph (< gw): 0
    assert_eq(fit_chars(3, 5, 1, 10), 0, "frame=3 < width=5 -> 0 glyphs");
}

fn t_layout_align_pad() {
    test_group("layout / align_pad");
    # left always 0 regardless of frame
    assert_eq(align_pad(10, 80, ALIGN_LEFT),   0, "left -> 0 pad");
    assert_eq(align_pad(10, 0,  ALIGN_LEFT),   0, "left + frame=0 -> 0");
    # center: (frame - banner) / 2
    assert_eq(align_pad(10, 80, ALIGN_CENTER), 35, "center 10 in 80 -> 35");
    assert_eq(align_pad(11, 80, ALIGN_CENTER), 34, "center 11 in 80 -> 34 (hi acceptance)");
    # right: frame - banner
    assert_eq(align_pad(10, 80, ALIGN_RIGHT),  70, "right 10 in 80 -> 70");
    assert_eq(align_pad(11, 80, ALIGN_RIGHT),  69, "right 11 in 80 -> 69");
    # banner wider than frame -> 0 (caller is expected to truncate first)
    assert_eq(align_pad(100, 80, ALIGN_CENTER), 0, "banner > frame -> 0");
    assert_eq(align_pad(100, 80, ALIGN_RIGHT),  0, "banner > frame -> 0");
    # exactly fits -> 0
    assert_eq(align_pad(80, 80, ALIGN_CENTER), 0, "banner == frame -> 0");
}

fn t_layout_parse_uint() {
    test_group("layout / parse_uint");
    var buf[16];
    # "0"
    store8(&buf, 48);  store8(&buf + 1, 0);
    assert_eq(parse_uint(&buf), 0, "0");
    # "42"
    store8(&buf, 52);  store8(&buf + 1, 50);  store8(&buf + 2, 0);
    assert_eq(parse_uint(&buf), 42, "42");
    # "80"
    store8(&buf, 56);  store8(&buf + 1, 48);  store8(&buf + 2, 0);
    assert_eq(parse_uint(&buf), 80, "80");
    # empty -> -1
    store8(&buf, 0);
    assert_eq(parse_uint(&buf), 0 - 1, "empty -> -1");
    # "12x" non-digit -> -1
    store8(&buf, 49); store8(&buf + 1, 50); store8(&buf + 2, 120); store8(&buf + 3, 0);
    assert_eq(parse_uint(&buf), 0 - 1, "trailing non-digit -> -1");
    # NULL ptr -> -1
    assert_eq(parse_uint(0), 0 - 1, "null -> -1");
}

fn t_layout_render_layout_default_matches_render() {
    test_group("layout / render_layout(width=0,LEFT,pad=0) matches render");
    # No assertions beyond "doesn't crash" — render writes to stdout
    # and we'd need to capture to compare. The wrapper in render.cyr
    # already delegates and the build links — covered structurally.
    var f = block_font_embed();
    assert(f != 0, "font built");
    # Smoke: rejects oversized like render does. Pass COLOR_NONE
    # explicitly so the bounds-rejection path returns before color
    # logic, but the test signature still matches the M5 fn surface.
    var big[1];
    assert_eq(render_layout(f, &big, 1025,   0, ALIGN_LEFT, 0, COLOR_NONE), 0 - 1, "over-cap -> -1");
    assert_eq(render_layout(f, &big, 0 - 1,  0, ALIGN_LEFT, 0, COLOR_NONE), 0 - 1, "negative len -> -1");
    assert_eq(render_layout(0, &big, 5,      0, ALIGN_LEFT, 0, COLOR_NONE), 0 - 2, "null font -> -2");
}

# ---- M5 color ----

fn t_color_parse_names() {
    test_group("color / parse_color named colors");
    # 8 base
    assert_eq(parse_color("black"),   TTY_FG_BLACK,   "black");
    assert_eq(parse_color("red"),     TTY_FG_RED,     "red");
    assert_eq(parse_color("green"),   TTY_FG_GREEN,   "green");
    assert_eq(parse_color("yellow"),  TTY_FG_YELLOW,  "yellow");
    assert_eq(parse_color("blue"),    TTY_FG_BLUE,    "blue");
    assert_eq(parse_color("magenta"), TTY_FG_MAGENTA, "magenta");
    assert_eq(parse_color("cyan"),    TTY_FG_CYAN,    "cyan");
    assert_eq(parse_color("white"),   TTY_FG_WHITE,   "white");
    # 8 bright (underscore form)
    assert_eq(parse_color("bright_red"),     TTY_FG_BRIGHT_RED,     "bright_red");
    assert_eq(parse_color("bright_cyan"),    TTY_FG_BRIGHT_CYAN,    "bright_cyan");
    assert_eq(parse_color("bright_white"),   TTY_FG_BRIGHT_WHITE,   "bright_white");
    # 8 bright (dash form)
    assert_eq(parse_color("bright-magenta"), TTY_FG_BRIGHT_MAGENTA, "bright-magenta");
    assert_eq(parse_color("bright-yellow"),  TTY_FG_BRIGHT_YELLOW,  "bright-yellow");
}

fn t_color_parse_special() {
    test_group("color / parse_color special values");
    # Sentinel for "no --color"
    assert_eq(parse_color(0),  COLOR_NONE, "null -> COLOR_NONE");
    assert_eq(parse_color(""), COLOR_NONE, "empty -> COLOR_NONE");
    # Rainbow mode
    assert_eq(parse_color("rainbow"), COLOR_RAINBOW, "rainbow -> COLOR_RAINBOW");
}

fn t_color_parse_unknown() {
    test_group("color / parse_color unknown names");
    assert_eq(parse_color("purple"),  0 - 3, "purple (not in 8/16 ANSI)");
    assert_eq(parse_color("CYAN"),    0 - 3, "CYAN (uppercase not accepted)");
    assert_eq(parse_color("cyann"),   0 - 3, "cyann (typo)");
    assert_eq(parse_color("12"),      0 - 3, "numeric string not accepted");
    assert_eq(parse_color("red green"), 0 - 3, "multi-word rejected");
}

fn t_color_rainbow_cycle() {
    test_group("color / rainbow_color_for_row cycle");
    assert_eq(rainbow_color_for_row(0), TTY_FG_RED,     "row 0 = red");
    assert_eq(rainbow_color_for_row(1), TTY_FG_YELLOW,  "row 1 = yellow");
    assert_eq(rainbow_color_for_row(2), TTY_FG_GREEN,   "row 2 = green");
    assert_eq(rainbow_color_for_row(3), TTY_FG_CYAN,    "row 3 = cyan");
    assert_eq(rainbow_color_for_row(4), TTY_FG_BLUE,    "row 4 = blue");
    assert_eq(rainbow_color_for_row(5), TTY_FG_MAGENTA, "row 5 = magenta");
    # Wraps at 6
    assert_eq(rainbow_color_for_row(6),  TTY_FG_RED,    "row 6 wraps to red");
    assert_eq(rainbow_color_for_row(13), TTY_FG_YELLOW, "row 13 -> idx 1 = yellow");
}

fn t_color_constants_are_distinct() {
    test_group("color / sentinel values don't collide with SGR codes");
    # All SGR codes are >= 30; sentinels are negative. No collision.
    assert(COLOR_NONE    < 0,  "COLOR_NONE is negative");
    assert(COLOR_RAINBOW < 0,  "COLOR_RAINBOW is negative");
    assert(COLOR_NONE != COLOR_RAINBOW, "sentinels distinct");
    assert(TTY_FG_BLACK >= 30, "first real SGR code >= 30");
}

# ---- M6: .flf legacy adapter ----

fn t_load_tiny_flf() {
    test_group("flf_load_file / tests/fixtures/tiny.flf");
    var f = flf_load_file("tests/fixtures/tiny.flf");
    assert(f != 0, "loaded");
    assert_eq(font_width(f),  1,  "tiny.flf width = 1");
    assert_eq(font_height(f), 1,  "tiny.flf height = 1");
    assert_eq(font_gap(f),    0,  "tiny.flf gap = 0");
    assert_eq(font_count(f),  95, "tiny.flf count = 95 (ASCII 32..126)");

    # Every ASCII char in 32..126 must resolve.
    var c = 32;
    while (c <= 126) {
        assert(font_glyph_index(f, c) >= 0, "ASCII char resolves");
        c = c + 1;
    }

    # Charmap mapping: ASCII 'A' (65) maps to glyph idx 65-32 = 33.
    assert_eq(font_glyph_index(f, 65), 33, "'A' -> idx 33");
    assert_eq(font_glyph_index(f, 32), 0,  "space -> idx 0");
    assert_eq(font_glyph_index(f, 126), 94, "'~' -> idx 94");

    # The fixture's glyph for 'A' (65) is the literal byte 'A'.
    # font_row gives the row pointer; row is 1 byte wide.
    assert_eq(load8(font_row(f, 33, 0)), 65, "'A' glyph row[0] = 'A'");

    # The fixture uses '$' as hardblank; the '$' glyph body is literally
    # '$', which gets substituted to space. Proves substitution works.
    # ASCII '$' is 36; idx = 36 - 32 = 4.
    assert_eq(load8(font_row(f, 4, 0)), 32, "'$' glyph row[0] = space (hardblank substituted)");

    # And the '@' glyph (ASCII 64, idx 32): the fixture uses '$' as its
    # body (avoiding endmark collision), so it too renders as space.
    assert_eq(load8(font_row(f, 32, 0)), 32, "'@' glyph row[0] = space (hardblank-bodied in fixture)");
}

fn t_load_flf_missing() {
    test_group("flf_load_file / missing");
    assert_eq(flf_load_file("tests/fixtures/__nope__.flf"), 0, "missing -> 0");
}

fn t_load_flf_malformed() {
    test_group("flf_load_file / malformed");
    assert_eq(flf_load_file("tests/fixtures/flf_bad_magic.flf"),  0, "bad magic -> 0");
    assert_eq(flf_load_file("tests/fixtures/flf_bad_height.flf"), 0, "bad height -> 0");
    assert_eq(flf_load_file("tests/fixtures/flf_truncated.flf"),  0, "truncated -> 0");
}

# 0.7.0 audit F-001 — a .flf whose glyph rows contain control bytes
# (e.g. ESC 0x1B) must NOT pass those bytes through to the rendered
# row. The loader sanitizes C0/C1/DEL → space, defeating the ANSI
# injection vector documented in docs/audit/2026-05-20-audit.md.
fn t_flf_strips_control_bytes() {
    test_group("flf_load_file / strips control bytes");
    var f = flf_load_file("tests/fixtures/flf_esc_glyph.flf");
    assert(f != 0, "loaded");
    # The space glyph (idx 0) was authored with a literal ESC (0x1B)
    # in its row. After load, that row byte must be the safe space (32).
    assert_eq(load8(font_row(f, 0, 0)), 32, "ESC in space-glyph row -> space");
    # A normal glyph ('A' at idx 33) survives unchanged.
    assert_eq(load8(font_row(f, 33, 0)), 65, "non-control byte ('A') preserved");
}

# Issue 0003 — CRLF-line .flf files must load with the same glyph row
# bytes as their LF counterparts. The fixture is tests/fixtures/tiny.flf
# byte-for-byte with every \n replaced by \r\n. Pre-fix, \r was
# mistaken for the endmark and the real endmark `@` bytes survived in
# the row data; post-fix the loader trims trailing \r before endmark
# detection so glyph row bytes match the LF fixture exactly.
fn t_flf_crlf_endmarks_stripped() {
    test_group("flf_load_file / CRLF endmark handling");
    var f = flf_load_file("tests/fixtures/flf_crlf.flf");
    assert(f != 0, "loaded CRLF fixture");
    assert_eq(font_width(f),  1,  "crlf width = 1");
    assert_eq(font_height(f), 1,  "crlf height = 1");
    assert_eq(font_count(f),  95, "crlf count = 95");

    # 'A' glyph (idx 33): the fixture stores literal 'A' (0x41). If
    # endmark detection had picked up '\r', the strip loop would have
    # left the '@' endmarks in place and the row byte would be '@'.
    assert_eq(load8(font_row(f, 33, 0)), 65, "'A' row[0] = 'A' (not '@')");
    # Cross-check a different glyph location for the same property.
    assert_eq(load8(font_row(f, 17, 0)), 49, "'1' row[0] = '1' (not '@')");

    # Byte-identical to the LF fixture: pure-LF behavior unchanged,
    # CRLF behavior now matches it.
    var lf = flf_load_file("tests/fixtures/tiny.flf");
    assert(lf != 0, "LF fixture still loads");
    var i = 0;
    var same = 1;
    while (i < 95) {
        if (load8(font_row(f, i, 0)) != load8(font_row(lf, i, 0))) {
            same = 0;
            i = 95;
        } else {
            i = i + 1;
        }
    }
    assert_eq(same, 1, "CRLF and LF fixtures produce identical glyph rows");
}

# ---- 1.1.4 P(-1) hardening regressions ----

fn t_header_strings_scrubbed() {
    test_group("font_header_load / control bytes scrubbed (F-011)");
    # `--list-fonts` prints `name` and `description` verbatim, so an ESC
    # in either is an ANSI-injection vector — the same CWE-150 class
    # F-001 closed for .flf glyph rows, on the CYML metadata path the
    # 0.7.0 audit did not cover.
    var h = font_header_load("tests/fixtures/ctl_header.cyml");
    assert(h != 0, "control-byte header fixture still loads");

    var nm = font_hdr_name(h);
    var i = 0;
    var n = strlen(nm);
    var clean = 1;
    while (i < n) {
        var b = load8(nm + i);
        if (b < 32) { clean = 0; }
        if (b == 127) { clean = 0; }
        if (b >= 128 && b <= 159) { clean = 0; }
        i = i + 1;
    }
    assert_eq(clean, 1, "name carries no control bytes");
    # Length-preserving: column alignment in --list-fonts is unaffected.
    assert_eq(n, 10, "name length preserved (ESC folded to space, not dropped)");

    var d = font_hdr_desc(h);
    var j = 0;
    var dn = strlen(d);
    var dclean = 1;
    while (j < dn) {
        var db = load8(d + j);
        if (db < 32) { dclean = 0; }
        if (db == 127) { dclean = 0; }
        if (db >= 128 && db <= 159) { dclean = 0; }
        j = j + 1;
    }
    assert_eq(dclean, 1, "description carries no control bytes");
}

fn t_columns_env_clamped() {
    test_group("layout / COLUMNS clamped at WS_COL_CAP (F-013)");
    # COLUMNS was the only frame-width source without a ceiling:
    # --width is rejected above WIDTH_CAP and TIOCGWINSZ is clamped by
    # F-008, but the env leg could drive the frame 256x past both.
    # On AGNOS this is the only frame source at all.
    assert(WS_COL_CAP == 4096, "WS_COL_CAP is 4096");
    # parse_uint still rejects past PARSER_INT_CAP, so the clamp only
    # has to cover the band between the cap and PARSER_INT_CAP.
    assert_eq(parse_uint("1048577"), 0 - 1, "past PARSER_INT_CAP still rejected");
    assert_eq(parse_uint("5000"), 5000, "in-band value parses");
}

fn t_flf_control_hardblank() {
    test_group("flf_load_file / control-byte hardblank (F-014)");
    # FIGfont v2 allows any hardblank except NUL/LF/CR/space. The old
    # 33..126 window rejected 17 of 1052 reference fonts, including
    # three shipped with figlet itself. Widening only admits fonts.
    var f = flf_load_file("tests/fixtures/flf_c1_hardblank.flf");
    assert(f != 0, "C1 hardblank (0x85) font now loads");

    # And it must still be safe: the hardblank -> space substitution
    # runs before the F-001 scrub, so no control byte survives.
    var h = font_height(f);
    var c = font_count(f);
    var gi = 0;
    var clean = 1;
    while (gi < c) {
        var r = 0;
        while (r < h) {
            var row = font_row(f, gi, r);
            var k = 0;
            while (k < font_width(f)) {
                var b = load8(row + k);
                if (b < 32) { clean = 0; }
                if (b == 127) { clean = 0; }
                if (b >= 128 && b <= 159) { clean = 0; }
                k = k + 1;
            }
            r = r + 1;
        }
        gi = gi + 1;
    }
    assert_eq(clean, 1, "no control byte survives into any glyph row");
}

fn t_flf_space_hardblank_rejected() {
    test_group("flf_load_file / hardblank exclusions still hold");
    # The four bytes the spec forbids must still be rejected. tiny.flf
    # with byte 5 rewritten to a space is the canonical case.
    assert_eq(flf_load_file("tests/fixtures/flf_space_hardblank.flf"), 0,
              "space hardblank rejected");
}

fn t_header_load_malformed() {
    test_group("font_header_load / malformed");
    # The header loader validates schema + geometry — same gates as the
    # full loader — so the bad_schema fixture should be rejected. The
    # body-shape fixtures (bad_body_byte, wrong_row_count) only fail at
    # glyph decode, which the header loader skips, so they should pass
    # — that's by design (header preview shouldn't require body-shape
    # validity). Just cover the bad_schema rejection here.
    assert_eq(font_header_load("tests/fixtures/bad_schema.cyml"), 0, "bad schema -> 0");
}

# ---- reader I/O portability (io.cyr wrappers) ----
#
# All three font readers open + read + close through lib/io.cyr's
# `file_open` / `file_read` / `file_close` rather than raw syscall
# numbers (which were x86_64-Linux-only and mis-dispatched on agnos).
# A directory path is the one case that separates the two guards: the
# open SUCCEEDS (so the `fd < 0` early-out does not fire) and the
# read then fails, which must land on the `total <= 0` return. Covers
# the `file_read` error passthrough that the missing-file tests miss.

fn t_reader_dir_path() {
    test_group("readers / directory path (open ok, read fails)");
    assert_eq(font_load_file("fonts"),   0, "font_load_file(dir) -> 0");
    assert_eq(font_header_load("fonts"), 0, "font_header_load(dir) -> 0");
    assert_eq(flf_load_file("fonts"),    0, "flf_load_file(dir) -> 0");
}

