# bannermanor test suite — M1 + M2 coverage.
#
# Covers:
#   - block_font_embed builds a Font with the expected geometry
#   - font_glyph_index covers space, digits, upper, lowercase folding,
#     and rejects unsupported chars
#   - every glyph row is exactly `width` bytes containing only space/'#'
#   - render rejects oversized input
#   - font_load_file parses fonts/block.cyml and matches the embedded
#     font byte-for-byte (M2 acceptance)
#   - font_load_file rejects malformed fixtures (bad schema, bad body
#     byte, wrong row count) and missing files

include "src/render.cyr"
include "src/font_block.cyr"
include "src/flf.cyr"
include "src/cli.cyr"

# ---- smoke ----

fn t_smoke() {
    test_group("smoke");
    assert(1, "true is true");
    assert_eq(1 + 1, 2, "math works");
}

# ---- embedded font geometry ----

fn t_embedded_geometry() {
    test_group("block_font_embed / geometry");
    var f = block_font_embed();
    assert(f != 0, "embedded font built");
    assert_eq(font_width(f),  5,  "width = 5");
    assert_eq(font_height(f), 5,  "height = 5");
    assert_eq(font_gap(f),    1,  "gap = 1");
    assert_eq(font_count(f),  69, "count = 69");
}

# ---- glyph index coverage ----

fn t_glyph_space() {
    test_group("font_glyph_index / space");
    var f = block_font_embed();
    assert(font_glyph_index(f, 32) >= 0, "space resolves to a glyph");
}

fn t_glyph_digits() {
    test_group("font_glyph_index / digits");
    var f = block_font_embed();
    var c = 48;
    while (c <= 57) {
        assert(font_glyph_index(f, c) >= 0, "digit resolves");
        c = c + 1;
    }
}

fn t_glyph_upper() {
    test_group("font_glyph_index / upper");
    var f = block_font_embed();
    var c = 65;
    while (c <= 90) {
        assert(font_glyph_index(f, c) >= 0, "upper resolves");
        c = c + 1;
    }
}

fn t_glyph_lower_folds() {
    test_group("font_glyph_index / lowercase folds to upper");
    var f = block_font_embed();
    var c = 97;
    var u = 65;
    while (c <= 122) {
        assert_eq(font_glyph_index(f, c), font_glyph_index(f, u), "fold");
        c = c + 1;
        u = u + 1;
    }
}

fn t_glyph_unsupported() {
    test_group("font_glyph_index / unsupported");
    var f = block_font_embed();
    # After M3, block covers all printable ASCII (32..126), so the
    # unsupported set is now NUL, control chars, DEL, and >127.
    assert_eq(font_glyph_index(f, 0),   0 - 1, "NUL -> -1");
    assert_eq(font_glyph_index(f, 1),   0 - 1, "SOH -> -1");
    assert_eq(font_glyph_index(f, 7),   0 - 1, "BEL -> -1");
    assert_eq(font_glyph_index(f, 9),   0 - 1, "TAB -> -1");
    assert_eq(font_glyph_index(f, 10),  0 - 1, "LF -> -1");
    assert_eq(font_glyph_index(f, 31),  0 - 1, "US (last C0) -> -1");
    assert_eq(font_glyph_index(f, 127), 0 - 1, "DEL -> -1");
    assert_eq(font_glyph_index(f, 200), 0 - 1, "high byte -> -1");
}

fn t_glyph_punctuation() {
    test_group("font_glyph_index / punctuation (M3)");
    var f = block_font_embed();
    # Every printable-ASCII punctuation char should resolve.
    assert(font_glyph_index(f, 33)  >= 0, "'!' resolves");
    assert(font_glyph_index(f, 34)  >= 0, "'\"' resolves");
    assert(font_glyph_index(f, 35)  >= 0, "'#' resolves");
    assert(font_glyph_index(f, 36)  >= 0, "'$' resolves");
    assert(font_glyph_index(f, 37)  >= 0, "'%' resolves");
    assert(font_glyph_index(f, 38)  >= 0, "'&' resolves");
    assert(font_glyph_index(f, 39)  >= 0, "''' resolves");
    assert(font_glyph_index(f, 40)  >= 0, "'(' resolves");
    assert(font_glyph_index(f, 41)  >= 0, "')' resolves");
    assert(font_glyph_index(f, 42)  >= 0, "'*' resolves");
    assert(font_glyph_index(f, 43)  >= 0, "'+' resolves");
    assert(font_glyph_index(f, 44)  >= 0, "',' resolves");
    assert(font_glyph_index(f, 45)  >= 0, "'-' resolves");
    assert(font_glyph_index(f, 46)  >= 0, "'.' resolves");
    assert(font_glyph_index(f, 47)  >= 0, "'/' resolves");
    assert(font_glyph_index(f, 58)  >= 0, "':' resolves");
    assert(font_glyph_index(f, 59)  >= 0, "';' resolves");
    assert(font_glyph_index(f, 60)  >= 0, "'<' resolves");
    assert(font_glyph_index(f, 61)  >= 0, "'=' resolves");
    assert(font_glyph_index(f, 62)  >= 0, "'>' resolves");
    assert(font_glyph_index(f, 63)  >= 0, "'?' resolves");
    assert(font_glyph_index(f, 64)  >= 0, "'@' resolves");
    assert(font_glyph_index(f, 91)  >= 0, "'[' resolves");
    assert(font_glyph_index(f, 92)  >= 0, "'\\' resolves");
    assert(font_glyph_index(f, 93)  >= 0, "']' resolves");
    assert(font_glyph_index(f, 94)  >= 0, "'^' resolves");
    assert(font_glyph_index(f, 95)  >= 0, "'_' resolves");
    assert(font_glyph_index(f, 96)  >= 0, "'`' resolves");
    assert(font_glyph_index(f, 123) >= 0, "'{' resolves");
    assert(font_glyph_index(f, 124) >= 0, "'|' resolves");
    assert(font_glyph_index(f, 125) >= 0, "'}' resolves");
    assert(font_glyph_index(f, 126) >= 0, "'~' resolves");
}

fn t_glyph_fold_is_fallback() {
    test_group("font_glyph_index / lowercase fold is fallback");
    var f = block_font_embed();
    # block.cyml ships uppercase only, so lowercase must fall back.
    var c = 97;
    var u = 65;
    while (c <= 122) {
        assert_eq(font_glyph_index(f, c), font_glyph_index(f, u),
          "lowercase falls back to uppercase when no lowercase glyph");
        c = c + 1;
        u = u + 1;
    }
}

# ---- row shape ----

fn t_row_shape() {
    test_group("font_row / shape");
    var f = block_font_embed();
    var w = font_width(f);
    var h = font_height(f);
    var count = font_count(f);
    var i = 0;
    while (i < count) {
        var r = 0;
        while (r < h) {
            var p = font_row(f, i, r);
            var col = 0;
            while (col < w) {
                var c = load8(p + col);
                # Each byte must be space (32) or '#' (35).
                var ok = 0;
                if (c == 32) { ok = 1; }
                if (c == 35) { ok = 1; }
                assert_eq(ok, 1, "row byte is space or '#'");
                col = col + 1;
            }
            r = r + 1;
        }
        i = i + 1;
    }
}

# ---- render bounds ----

fn t_render_bounds() {
    test_group("render / bounds");
    var f = block_font_embed();
    var big[1];
    assert_eq(render(f, &big, 0 - 1),  0 - 1, "negative len -> -1");
    assert_eq(render(f, &big, 1025),   0 - 1, "over-cap -> -1");
    assert_eq(render(f, &big, 9999),   0 - 1, "way-over-cap -> -1");
    assert_eq(render(0, &big, 5),      0 - 2, "null font -> -2");
}

# ---- CYML loader (M2) ----

fn t_load_block_cyml() {
    test_group("font_load_file / fonts/block.cyml");
    var f = font_load_file("fonts/block.cyml");
    assert(f != 0, "loaded");
    assert_eq(font_width(f),  5,  "width");
    assert_eq(font_height(f), 5,  "height");
    assert_eq(font_gap(f),    1,  "gap");
    assert_eq(font_count(f),  69, "count");
}

# M2 acceptance: the loaded font must agree with the embedded font on
# every char's glyph index AND every glyph's row bytes — i.e. the file
# and the in-source data are interchangeable.
fn t_loaded_matches_embedded() {
    test_group("M2 acceptance / loaded == embedded");
    var emb = block_font_embed();
    var ldr = font_load_file("fonts/block.cyml");
    assert(ldr != 0, "loaded");
    assert_eq(font_width(ldr),  font_width(emb),  "width matches");
    assert_eq(font_height(ldr), font_height(emb), "height matches");
    assert_eq(font_gap(ldr),    font_gap(emb),    "gap matches");
    assert_eq(font_count(ldr),  font_count(emb),  "count matches");

    # Every ASCII char must map to the same glyph index in both fonts.
    var c = 0;
    while (c < 128) {
        assert_eq(font_glyph_index(ldr, c), font_glyph_index(emb, c),
          "glyph index per char matches");
        c = c + 1;
    }

    # Every glyph's rows must be byte-identical.
    var w = font_width(emb);
    var h = font_height(emb);
    var idx = 0;
    while (idx < 69) {
        var r = 0;
        while (r < h) {
            var ep = font_row(emb, idx, r);
            var lp = font_row(ldr, idx, r);
            assert_eq(memeq(ep, lp, w), 1, "row bytes match");
            r = r + 1;
        }
        idx = idx + 1;
    }
}

fn t_load_missing() {
    test_group("font_load_file / missing");
    assert_eq(font_load_file("fonts/__does_not_exist__.cyml"), 0, "missing -> 0");
}

fn t_load_malformed() {
    test_group("font_load_file / malformed");
    assert_eq(font_load_file("tests/fixtures/bad_schema.cyml"),     0, "bad schema -> 0");
    assert_eq(font_load_file("tests/fixtures/bad_body_byte.cyml"),  0, "bad body byte -> 0");
    assert_eq(font_load_file("tests/fixtures/wrong_row_count.cyml"), 0, "wrong row count -> 0");
}

# ---- header loader (M3, --list-fonts) ----

fn t_header_load_block() {
    test_group("font_header_load / fonts/block.cyml");
    var h = font_header_load("fonts/block.cyml");
    assert(h != 0, "header loaded");
    assert_eq(font_hdr_width(h),  5, "header width = 5");
    assert_eq(font_hdr_height(h), 5, "header height = 5");
    assert_eq(font_hdr_gap(h),    1, "header gap = 1");
    var name = font_hdr_name(h);
    assert_eq(strlen(name), 5, "name length = 5");
    assert_eq(memeq(name, "block", 5), 1, "name = block");
    var desc = font_hdr_desc(h);
    assert(strlen(desc) > 0, "description present");
}

fn t_header_load_missing() {
    test_group("font_header_load / missing");
    assert_eq(font_header_load("fonts/__nope__.cyml"), 0, "missing -> 0");
}

fn t_load_big_cyml() {
    test_group("font_load_file / fonts/big.cyml");
    var f = font_load_file("fonts/big.cyml");
    assert(f != 0, "loaded");
    assert_eq(font_width(f),  7,  "big width = 7");
    assert_eq(font_height(f), 7,  "big height = 7");
    assert_eq(font_gap(f),    1,  "big gap = 1");
    assert_eq(font_count(f),  69, "big count = 69 (full printable ASCII)");

    # Every printable-ASCII char resolves.
    var c = 32;
    while (c <= 126) {
        assert(font_glyph_index(f, c) >= 0, "printable char resolves");
        c = c + 1;
    }

    # AGNOS acceptance.
    assert(font_glyph_index(f, 65) >= 0, "A resolves");
    assert(font_glyph_index(f, 71) >= 0, "G resolves");
    assert(font_glyph_index(f, 78) >= 0, "N resolves");
    assert(font_glyph_index(f, 79) >= 0, "O resolves");
    assert(font_glyph_index(f, 83) >= 0, "S resolves");

    # Fold-fallback: 'a' must resolve to 'A''s glyph.
    assert_eq(font_glyph_index(f, 97), font_glyph_index(f, 65),
      "'a' folds to 'A' on big");
}

fn t_load_slim_cyml() {
    test_group("font_load_file / fonts/slim.cyml");
    var f = font_load_file("fonts/slim.cyml");
    assert(f != 0, "loaded");
    assert_eq(font_width(f),  4,  "slim width = 4");
    assert_eq(font_height(f), 5,  "slim height = 5");
    assert_eq(font_gap(f),    1,  "slim gap = 1");
    assert_eq(font_count(f),  69, "slim count = 69 (full printable ASCII)");

    # Every printable-ASCII char must resolve.
    var c = 32;
    while (c <= 126) {
        assert(font_glyph_index(f, c) >= 0, "printable char resolves");
        c = c + 1;
    }

    # AGNOS — the M3 acceptance bar for every shipped font.
    assert(font_glyph_index(f, 65) >= 0, "A resolves");
    assert(font_glyph_index(f, 71) >= 0, "G resolves");
    assert(font_glyph_index(f, 78) >= 0, "N resolves");
    assert(font_glyph_index(f, 79) >= 0, "O resolves");
    assert(font_glyph_index(f, 83) >= 0, "S resolves");

    # Fold-fallback should still kick in: slim has no lowercase glyphs,
    # so 'a' must resolve to the same index as 'A'.
    assert_eq(font_glyph_index(f, 97), font_glyph_index(f, 65),
      "'a' folds to 'A' on slim");
}

# ---- M4 layout ----

fn t_layout_banner_width() {
    test_group("layout / banner_width");
    # 1 glyph: just width
    assert_eq(banner_width(1, 5, 1), 5,  "1 glyph @ 5w gap=1 -> 5");
    # 2 glyphs: w + gap + w
    assert_eq(banner_width(2, 5, 1), 11, "2 glyphs @ 5w gap=1 -> 11");
    # 5 glyphs at block: 5*5 + 4*1 = 29
    assert_eq(banner_width(5, 5, 1), 29, "AGNOS-shape banner -> 29 cols");
    # n=0 -> 0 (no glyphs, no gaps)
    assert_eq(banner_width(0, 5, 1), 0,  "0 glyphs -> 0");
    # gap=0 means flush glyphs
    assert_eq(banner_width(3, 4, 0), 12, "3 glyphs @ 4w gap=0 -> 12");
}

fn t_layout_fit_chars() {
    test_group("layout / fit_chars");
    # frame=0 (unlimited): pass through len untouched
    assert_eq(fit_chars(0, 5, 1, 10), 10, "frame=0 unlimited");
    assert_eq(fit_chars(0, 5, 1, 0),  0,  "frame=0 + len=0");
    # exact fits at block geometry (w=5, gap=1)
    assert_eq(fit_chars(5,  5, 1, 10), 1, "frame=5  -> 1 glyph fits");
    assert_eq(fit_chars(11, 5, 1, 10), 2, "frame=11 -> 2 glyphs fit");
    assert_eq(fit_chars(17, 5, 1, 10), 3, "frame=17 -> 3 glyphs fit");
    # one byte short of a 4th glyph — still 3
    assert_eq(fit_chars(22, 5, 1, 10), 3, "frame=22 -> still 3 glyphs (4th needs 23)");
    assert_eq(fit_chars(23, 5, 1, 10), 4, "frame=23 -> 4 glyphs fit");
    # frame wider than text: capped by len
    assert_eq(fit_chars(80, 5, 1, 5),  5, "frame=80 + 5-char text -> 5");
    # frame=20 + AGNOSTIC (8 chars): 3 glyphs fit (17 cols), 4th needs 23
    assert_eq(fit_chars(20, 5, 1, 8),  3, "frame=20 AGNOSTIC -> AGN (3 glyphs)");
    # roadmap acceptance: --width 80 + "hi"
    assert_eq(fit_chars(80, 5, 1, 2),  2, "frame=80 'hi' -> both glyphs (no truncation)");
    # frame too small for even one glyph (< gw): 0
    assert_eq(fit_chars(3, 5, 1, 10), 0, "frame=3 < width=5 -> 0 glyphs");
}

fn t_layout_align_pad() {
    test_group("layout / align_pad");
    # left always 0 regardless of frame
    assert_eq(align_pad(10, 80, ALIGN_LEFT),   0, "left -> 0 pad");
    assert_eq(align_pad(10, 0,  ALIGN_LEFT),   0, "left + frame=0 -> 0");
    # center: (frame - banner) / 2
    assert_eq(align_pad(10, 80, ALIGN_CENTER), 35, "center 10 in 80 -> 35");
    assert_eq(align_pad(11, 80, ALIGN_CENTER), 34, "center 11 in 80 -> 34 (hi acceptance)");
    # right: frame - banner
    assert_eq(align_pad(10, 80, ALIGN_RIGHT),  70, "right 10 in 80 -> 70");
    assert_eq(align_pad(11, 80, ALIGN_RIGHT),  69, "right 11 in 80 -> 69");
    # banner wider than frame -> 0 (caller is expected to truncate first)
    assert_eq(align_pad(100, 80, ALIGN_CENTER), 0, "banner > frame -> 0");
    assert_eq(align_pad(100, 80, ALIGN_RIGHT),  0, "banner > frame -> 0");
    # exactly fits -> 0
    assert_eq(align_pad(80, 80, ALIGN_CENTER), 0, "banner == frame -> 0");
}

fn t_layout_parse_uint() {
    test_group("layout / parse_uint");
    var buf[16];
    # "0"
    store8(&buf, 48);  store8(&buf + 1, 0);
    assert_eq(parse_uint(&buf), 0, "0");
    # "42"
    store8(&buf, 52);  store8(&buf + 1, 50);  store8(&buf + 2, 0);
    assert_eq(parse_uint(&buf), 42, "42");
    # "80"
    store8(&buf, 56);  store8(&buf + 1, 48);  store8(&buf + 2, 0);
    assert_eq(parse_uint(&buf), 80, "80");
    # empty -> -1
    store8(&buf, 0);
    assert_eq(parse_uint(&buf), 0 - 1, "empty -> -1");
    # "12x" non-digit -> -1
    store8(&buf, 49); store8(&buf + 1, 50); store8(&buf + 2, 120); store8(&buf + 3, 0);
    assert_eq(parse_uint(&buf), 0 - 1, "trailing non-digit -> -1");
    # NULL ptr -> -1
    assert_eq(parse_uint(0), 0 - 1, "null -> -1");
}

fn t_layout_render_layout_default_matches_render() {
    test_group("layout / render_layout(width=0,LEFT,pad=0) matches render");
    # No assertions beyond "doesn't crash" — render writes to stdout
    # and we'd need to capture to compare. The wrapper in render.cyr
    # already delegates and the build links — covered structurally.
    var f = block_font_embed();
    assert(f != 0, "font built");
    # Smoke: rejects oversized like render does. Pass COLOR_NONE
    # explicitly so the bounds-rejection path returns before color
    # logic, but the test signature still matches the M5 fn surface.
    var big[1];
    assert_eq(render_layout(f, &big, 1025,   0, ALIGN_LEFT, 0, COLOR_NONE), 0 - 1, "over-cap -> -1");
    assert_eq(render_layout(f, &big, 0 - 1,  0, ALIGN_LEFT, 0, COLOR_NONE), 0 - 1, "negative len -> -1");
    assert_eq(render_layout(0, &big, 5,      0, ALIGN_LEFT, 0, COLOR_NONE), 0 - 2, "null font -> -2");
}

# ---- M5 color ----

fn t_color_parse_names() {
    test_group("color / parse_color named colors");
    # 8 base
    assert_eq(parse_color("black"),   TTY_FG_BLACK,   "black");
    assert_eq(parse_color("red"),     TTY_FG_RED,     "red");
    assert_eq(parse_color("green"),   TTY_FG_GREEN,   "green");
    assert_eq(parse_color("yellow"),  TTY_FG_YELLOW,  "yellow");
    assert_eq(parse_color("blue"),    TTY_FG_BLUE,    "blue");
    assert_eq(parse_color("magenta"), TTY_FG_MAGENTA, "magenta");
    assert_eq(parse_color("cyan"),    TTY_FG_CYAN,    "cyan");
    assert_eq(parse_color("white"),   TTY_FG_WHITE,   "white");
    # 8 bright (underscore form)
    assert_eq(parse_color("bright_red"),     TTY_FG_BRIGHT_RED,     "bright_red");
    assert_eq(parse_color("bright_cyan"),    TTY_FG_BRIGHT_CYAN,    "bright_cyan");
    assert_eq(parse_color("bright_white"),   TTY_FG_BRIGHT_WHITE,   "bright_white");
    # 8 bright (dash form)
    assert_eq(parse_color("bright-magenta"), TTY_FG_BRIGHT_MAGENTA, "bright-magenta");
    assert_eq(parse_color("bright-yellow"),  TTY_FG_BRIGHT_YELLOW,  "bright-yellow");
}

fn t_color_parse_special() {
    test_group("color / parse_color special values");
    # Sentinel for "no --color"
    assert_eq(parse_color(0),  COLOR_NONE, "null -> COLOR_NONE");
    assert_eq(parse_color(""), COLOR_NONE, "empty -> COLOR_NONE");
    # Rainbow mode
    assert_eq(parse_color("rainbow"), COLOR_RAINBOW, "rainbow -> COLOR_RAINBOW");
}

fn t_color_parse_unknown() {
    test_group("color / parse_color unknown names");
    assert_eq(parse_color("purple"),  0 - 3, "purple (not in 8/16 ANSI)");
    assert_eq(parse_color("CYAN"),    0 - 3, "CYAN (uppercase not accepted)");
    assert_eq(parse_color("cyann"),   0 - 3, "cyann (typo)");
    assert_eq(parse_color("12"),      0 - 3, "numeric string not accepted");
    assert_eq(parse_color("red green"), 0 - 3, "multi-word rejected");
}

fn t_color_rainbow_cycle() {
    test_group("color / rainbow_color_for_row cycle");
    assert_eq(rainbow_color_for_row(0), TTY_FG_RED,     "row 0 = red");
    assert_eq(rainbow_color_for_row(1), TTY_FG_YELLOW,  "row 1 = yellow");
    assert_eq(rainbow_color_for_row(2), TTY_FG_GREEN,   "row 2 = green");
    assert_eq(rainbow_color_for_row(3), TTY_FG_CYAN,    "row 3 = cyan");
    assert_eq(rainbow_color_for_row(4), TTY_FG_BLUE,    "row 4 = blue");
    assert_eq(rainbow_color_for_row(5), TTY_FG_MAGENTA, "row 5 = magenta");
    # Wraps at 6
    assert_eq(rainbow_color_for_row(6),  TTY_FG_RED,    "row 6 wraps to red");
    assert_eq(rainbow_color_for_row(13), TTY_FG_YELLOW, "row 13 -> idx 1 = yellow");
}

fn t_color_constants_are_distinct() {
    test_group("color / sentinel values don't collide with SGR codes");
    # All SGR codes are >= 30; sentinels are negative. No collision.
    assert(COLOR_NONE    < 0,  "COLOR_NONE is negative");
    assert(COLOR_RAINBOW < 0,  "COLOR_RAINBOW is negative");
    assert(COLOR_NONE != COLOR_RAINBOW, "sentinels distinct");
    assert(TTY_FG_BLACK >= 30, "first real SGR code >= 30");
}

# ---- M6: .flf legacy adapter ----

fn t_load_tiny_flf() {
    test_group("flf_load_file / tests/fixtures/tiny.flf");
    var f = flf_load_file("tests/fixtures/tiny.flf");
    assert(f != 0, "loaded");
    assert_eq(font_width(f),  1,  "tiny.flf width = 1");
    assert_eq(font_height(f), 1,  "tiny.flf height = 1");
    assert_eq(font_gap(f),    0,  "tiny.flf gap = 0");
    assert_eq(font_count(f),  95, "tiny.flf count = 95 (ASCII 32..126)");

    # Every ASCII char in 32..126 must resolve.
    var c = 32;
    while (c <= 126) {
        assert(font_glyph_index(f, c) >= 0, "ASCII char resolves");
        c = c + 1;
    }

    # Charmap mapping: ASCII 'A' (65) maps to glyph idx 65-32 = 33.
    assert_eq(font_glyph_index(f, 65), 33, "'A' -> idx 33");
    assert_eq(font_glyph_index(f, 32), 0,  "space -> idx 0");
    assert_eq(font_glyph_index(f, 126), 94, "'~' -> idx 94");

    # The fixture's glyph for 'A' (65) is the literal byte 'A'.
    # font_row gives the row pointer; row is 1 byte wide.
    assert_eq(load8(font_row(f, 33, 0)), 65, "'A' glyph row[0] = 'A'");

    # The fixture uses '$' as hardblank; the '$' glyph body is literally
    # '$', which gets substituted to space. Proves substitution works.
    # ASCII '$' is 36; idx = 36 - 32 = 4.
    assert_eq(load8(font_row(f, 4, 0)), 32, "'$' glyph row[0] = space (hardblank substituted)");

    # And the '@' glyph (ASCII 64, idx 32): the fixture uses '$' as its
    # body (avoiding endmark collision), so it too renders as space.
    assert_eq(load8(font_row(f, 32, 0)), 32, "'@' glyph row[0] = space (hardblank-bodied in fixture)");
}

fn t_load_flf_missing() {
    test_group("flf_load_file / missing");
    assert_eq(flf_load_file("tests/fixtures/__nope__.flf"), 0, "missing -> 0");
}

fn t_load_flf_malformed() {
    test_group("flf_load_file / malformed");
    assert_eq(flf_load_file("tests/fixtures/flf_bad_magic.flf"),  0, "bad magic -> 0");
    assert_eq(flf_load_file("tests/fixtures/flf_bad_height.flf"), 0, "bad height -> 0");
    assert_eq(flf_load_file("tests/fixtures/flf_truncated.flf"),  0, "truncated -> 0");
}

# 0.7.0 audit F-001 — a .flf whose glyph rows contain control bytes
# (e.g. ESC 0x1B) must NOT pass those bytes through to the rendered
# row. The loader sanitizes C0/C1/DEL → space, defeating the ANSI
# injection vector documented in docs/audit/2026-05-20-audit.md.
fn t_flf_strips_control_bytes() {
    test_group("flf_load_file / strips control bytes");
    var f = flf_load_file("tests/fixtures/flf_esc_glyph.flf");
    assert(f != 0, "loaded");
    # The space glyph (idx 0) was authored with a literal ESC (0x1B)
    # in its row. After load, that row byte must be the safe space (32).
    assert_eq(load8(font_row(f, 0, 0)), 32, "ESC in space-glyph row -> space");
    # A normal glyph ('A' at idx 33) survives unchanged.
    assert_eq(load8(font_row(f, 33, 0)), 65, "non-control byte ('A') preserved");
}

# Issue 0003 — CRLF-line .flf files must load with the same glyph row
# bytes as their LF counterparts. The fixture is tests/fixtures/tiny.flf
# byte-for-byte with every \n replaced by \r\n. Pre-fix, \r was
# mistaken for the endmark and the real endmark `@` bytes survived in
# the row data; post-fix the loader trims trailing \r before endmark
# detection so glyph row bytes match the LF fixture exactly.
fn t_flf_crlf_endmarks_stripped() {
    test_group("flf_load_file / CRLF endmark handling");
    var f = flf_load_file("tests/fixtures/flf_crlf.flf");
    assert(f != 0, "loaded CRLF fixture");
    assert_eq(font_width(f),  1,  "crlf width = 1");
    assert_eq(font_height(f), 1,  "crlf height = 1");
    assert_eq(font_count(f),  95, "crlf count = 95");

    # 'A' glyph (idx 33): the fixture stores literal 'A' (0x41). If
    # endmark detection had picked up '\r', the strip loop would have
    # left the '@' endmarks in place and the row byte would be '@'.
    assert_eq(load8(font_row(f, 33, 0)), 65, "'A' row[0] = 'A' (not '@')");
    # Cross-check a different glyph location for the same property.
    assert_eq(load8(font_row(f, 17, 0)), 49, "'1' row[0] = '1' (not '@')");

    # Byte-identical to the LF fixture: pure-LF behavior unchanged,
    # CRLF behavior now matches it.
    var lf = flf_load_file("tests/fixtures/tiny.flf");
    assert(lf != 0, "LF fixture still loads");
    var i = 0;
    var same = 1;
    while (i < 95) {
        if (load8(font_row(f, i, 0)) != load8(font_row(lf, i, 0))) {
            same = 0;
            i = 95;
        } else {
            i = i + 1;
        }
    }
    assert_eq(same, 1, "CRLF and LF fixtures produce identical glyph rows");
}

# ---- 1.1.4 P(-1) hardening regressions ----

fn t_header_strings_scrubbed() {
    test_group("font_header_load / control bytes scrubbed (F-011)");
    # `--list-fonts` prints `name` and `description` verbatim, so an ESC
    # in either is an ANSI-injection vector — the same CWE-150 class
    # F-001 closed for .flf glyph rows, on the CYML metadata path the
    # 0.7.0 audit did not cover.
    var h = font_header_load("tests/fixtures/ctl_header.cyml");
    assert(h != 0, "control-byte header fixture still loads");

    var nm = font_hdr_name(h);
    var i = 0;
    var n = strlen(nm);
    var clean = 1;
    while (i < n) {
        var b = load8(nm + i);
        if (b < 32) { clean = 0; }
        if (b == 127) { clean = 0; }
        if (b >= 128 && b <= 159) { clean = 0; }
        i = i + 1;
    }
    assert_eq(clean, 1, "name carries no control bytes");
    # Length-preserving: column alignment in --list-fonts is unaffected.
    assert_eq(n, 10, "name length preserved (ESC folded to space, not dropped)");

    var d = font_hdr_desc(h);
    var j = 0;
    var dn = strlen(d);
    var dclean = 1;
    while (j < dn) {
        var db = load8(d + j);
        if (db < 32) { dclean = 0; }
        if (db == 127) { dclean = 0; }
        if (db >= 128 && db <= 159) { dclean = 0; }
        j = j + 1;
    }
    assert_eq(dclean, 1, "description carries no control bytes");
}

fn t_columns_env_clamped() {
    test_group("layout / COLUMNS clamped at WS_COL_CAP (F-013)");
    # COLUMNS was the only frame-width source without a ceiling:
    # --width is rejected above WIDTH_CAP and the terminal width is
    # clamped by F-008, but the env leg could drive the frame 256x past
    # both. On AGNOS it is the frame source whenever the framebuffer
    # console is down (through 1.1.5, always — issue 0018).
    assert(WS_COL_CAP == 4096, "WS_COL_CAP is 4096");
    # parse_uint still rejects past PARSER_INT_CAP, so the clamp only
    # has to cover the band between the cap and PARSER_INT_CAP.
    assert_eq(parse_uint("1048577"), 0 - 1, "past PARSER_INT_CAP still rejected");
    assert_eq(parse_uint("5000"), 5000, "in-band value parses");
}

fn t_flf_control_hardblank() {
    test_group("flf_load_file / control-byte hardblank (F-014)");
    # FIGfont v2 allows any hardblank except NUL/LF/CR/space. The old
    # 33..126 window rejected 17 of 1052 reference fonts, including
    # three shipped with figlet itself. Widening only admits fonts.
    var f = flf_load_file("tests/fixtures/flf_c1_hardblank.flf");
    assert(f != 0, "C1 hardblank (0x85) font now loads");

    # And it must still be safe: the hardblank -> space substitution
    # runs before the F-001 scrub, so no control byte survives.
    var h = font_height(f);
    var c = font_count(f);
    var gi = 0;
    var clean = 1;
    while (gi < c) {
        var r = 0;
        while (r < h) {
            var row = font_row(f, gi, r);
            var k = 0;
            while (k < font_width(f)) {
                var b = load8(row + k);
                if (b < 32) { clean = 0; }
                if (b == 127) { clean = 0; }
                if (b >= 128 && b <= 159) { clean = 0; }
                k = k + 1;
            }
            r = r + 1;
        }
        gi = gi + 1;
    }
    assert_eq(clean, 1, "no control byte survives into any glyph row");
}

fn t_flf_space_hardblank_rejected() {
    test_group("flf_load_file / hardblank exclusions still hold");
    # The four bytes the spec forbids must still be rejected. tiny.flf
    # with byte 5 rewritten to a space is the canonical case.
    assert_eq(flf_load_file("tests/fixtures/flf_space_hardblank.flf"), 0,
      "space hardblank rejected");
}

fn t_header_load_malformed() {
    test_group("font_header_load / malformed");
    # The header loader validates schema + geometry — same gates as the
    # full loader — so the bad_schema fixture should be rejected. The
    # body-shape fixtures (bad_body_byte, wrong_row_count) only fail at
    # glyph decode, which the header loader skips, so they should pass
    # — that's by design (header preview shouldn't require body-shape
    # validity). Just cover the bad_schema rejection here.
    assert_eq(font_header_load("tests/fixtures/bad_schema.cyml"), 0, "bad schema -> 0");
}

# ---- reader gates (src/font.cyr _slurp, shared by all three readers) ----
#
# Through 1.1.3 a directory was the one input that separated the reader's
# two guards: the open succeeded and the read failed EISDIR, landing on
# `total <= 0`. That is what this test was written to cover. Since
# 1.1.4's regular-file gate a directory never reaches open(2): `_slurp`
# rejects anything that is not S_IFREG first. The test now pins that gate.
# The `total <= 0` return is covered by t_reader_empty_file.

fn t_reader_dir_path() {
    test_group("readers / directory path (rejected by the S_IFREG gate)");
    assert_eq(font_load_file("fonts"),   0, "font_load_file(dir) -> 0");
    assert_eq(font_header_load("fonts"), 0, "font_header_load(dir) -> 0");
    assert_eq(flf_load_file("fonts"),    0, "flf_load_file(dir) -> 0");
}

fn t_reader_empty_file() {
    test_group("readers / empty regular file (the total <= 0 return)");
    assert_eq(font_load_file("tests/fixtures/empty.cyml"),   0, "font_load_file(empty) -> 0");
    assert_eq(font_header_load("tests/fixtures/empty.cyml"), 0, "font_header_load(empty) -> 0");
    assert_eq(flf_load_file("tests/fixtures/empty.flf"),     0, "flf_load_file(empty) -> 0");
}

# ---- 1.4.1: parser fixtures (the cases the 1.1.4 audit found absent) ----
#
# Committed fixtures under tests/fixtures/ for the shapes worth naming,
# and fonts built in memory for the boundaries: a test that says "64
# loads and 65 does not" is the documentation of the limit. In-memory
# inputs go straight to the parse halves the readers were split into at
# 1.4.1 (_font_parse / _font_header_parse / _flf_parse).

# A small byte builder for in-memory fonts.
var _tb_buf = 0;
var _tb_len = 0;
fn _tb_reset(cap): i64 { _tb_buf = alloc(cap); _tb_len = 0; return _tb_buf; }
fn _tb_str(s): i64 {
    var n = strlen(s);
    memcpy(_tb_buf + _tb_len, s, n);
    _tb_len = _tb_len + n;
    return 0;
}
fn _tb_byte(b): i64 { store8(_tb_buf + _tb_len, b); _tb_len = _tb_len + 1; return 0; }
fn _tb_int(n): i64 { _tb_len = tty_dec_buf(_tb_buf, _tb_len, n); return 0; }
fn _tb_rep(b, n): i64 {
    var i = 0;
    while (i < n) { _tb_byte(b); i = i + 1; }
    return 0;
}

# [font] header for a schema-1 font with the given geometry.
fn _tb_cyml_header(schema, w, h, gap): i64 {
    _tb_str("[font]\nschema = "); _tb_int(schema);
    _tb_str("\nname = \"t\"\nwidth = "); _tb_int(w);
    _tb_str("\nheight = "); _tb_int(h);
    _tb_str("\ngap = "); _tb_int(gap);
    _tb_str("\n\n");
    return 0;
}

# One entry for char `ch`, w x h, all stroke.
fn _tb_cyml_entry(ch, w, h): i64 {
    _tb_str("[[entries]]\nchar = \"");
    if (ch == 34 || ch == 92) { _tb_byte(92); }
    _tb_byte(ch);
    _tb_str("\"\n---\n");
    var r = 0;
    while (r < h) {
        _tb_rep(35, w);
        _tb_byte(10);
        r = r + 1;
    }
    _tb_byte(10);
    return 0;
}

# A one-glyph font ('A') with this geometry, parsed by both CYML halves.
# Stores the full parse at *out_f and the header parse at *out_h.
fn _tb_geom(w, h, gap, out_f, out_h): i64 {
    _tb_reset(8192);
    _tb_cyml_header(1, w, h, gap);
    _tb_cyml_entry(65, w, h);
    store64(out_f, _font_parse(_tb_buf, _tb_len));
    store64(out_h, _font_header_parse(_tb_buf, _tb_len));
    return 0;
}

fn t_cyml_geometry_bounds() {
    test_group("CYML / schema-1 geometry bounds, both loaders");
    var p = "tests/fixtures/bad_width_65.cyml";
    assert_eq(font_load_file(p), 0, "width 65 -> font_load_file 0");
    assert_eq(font_header_load(p), 0, "width 65 -> font_header_load 0");
    p = "tests/fixtures/bad_width_0.cyml";
    assert_eq(font_load_file(p), 0, "width 0 -> font_load_file 0");
    assert_eq(font_header_load(p), 0, "width 0 -> font_header_load 0");
    p = "tests/fixtures/bad_height_33.cyml";
    assert_eq(font_load_file(p), 0, "height 33 -> font_load_file 0");
    assert_eq(font_header_load(p), 0, "height 33 -> font_header_load 0");
    p = "tests/fixtures/bad_gap_17.cyml";
    assert_eq(font_load_file(p), 0, "gap 17 -> font_load_file 0");
    assert_eq(font_header_load(p), 0, "gap 17 -> font_header_load 0");

    # The limits themselves load: MAX_WIDTH 64, MAX_HEIGHT 32, MAX_GAP 16.
    var f = 0;
    var h = 0;
    _tb_geom(64, 1, 0, &f, &h);
    assert(f != 0, "width 64 loads");
    assert(h != 0, "width 64 lists");
    if (f != 0) { assert_eq(font_width(f), 64, "width 64 -> font_width 64"); }
    _tb_geom(1, 32, 0, &f, &h);
    assert(f != 0, "height 32 loads");
    assert(h != 0, "height 32 lists");
    _tb_geom(1, 1, 16, &f, &h);
    assert(f != 0, "gap 16 loads");
    assert(h != 0, "gap 16 lists");
    _tb_geom(1, 1, 0, &f, &h);
    assert(f != 0, "1x1 gap 0 loads (the smallest legal font)");
    _tb_geom(0, 1, 0, &f, &h);
    assert_eq(f, 0, "height 1 width 0 -> 0 (geometry must be >= 1)");
    assert_eq(h, 0, "width 0 -> header 0");
    _tb_geom(1, 0, 0, &f, &h);
    assert_eq(f, 0, "height 0 -> 0");
    assert_eq(h, 0, "height 0 -> header 0");
}

fn t_cyml_entry_rules() {
    test_group("CYML / entry rules: the two loaders gate differently");
    # Duplicate char: the full loader rejects; the header loader never
    # decodes entries, so the same file lists clean.
    assert_eq(font_load_file("tests/fixtures/dup_char.cyml"), 0, "duplicate char -> font_load_file 0");
    assert(font_header_load("tests/fixtures/dup_char.cyml") != 0, "duplicate char -> font_header_load lists it");
    assert_eq(font_load_file("tests/fixtures/char_non_ascii.cyml"), 0, "non-ASCII char -> 0");
    # name over the 63-byte buffer. Since 1.6.0 name is optional in the
    # header loader too, and an over-long one is shortened with "...".
    assert(font_load_file("tests/fixtures/long_name.cyml") != 0, "64-byte name -> font_load_file loads");
    var lnh = font_header_load("tests/fixtures/long_name.cyml");
    assert(lnh != 0, "64-byte name -> font_header_load loads (1.6.0)");
    if (lnh != 0) {
        var lnn = font_hdr_name(lnh);
        assert_eq(strlen(lnn), 63, "shortened to 60 bytes + ...");
        assert_eq(memeq(lnn + 60, "...", 3), 1, "ends in ...");
    }
    # Issue 0008 (fixed 1.5.0): a body with more rows than `height` is
    # rejected. Through 1.4.2 it loaded and the surplus was ignored.
    assert_eq(font_load_file("tests/fixtures/extra_rows.cyml"), 0, "surplus rows -> 0 (issue 0008)");
    var xr = font_header_load("tests/fixtures/extra_rows.cyml");
    assert(xr != 0, "surplus rows -> still lists (bodies are not read)");
    # Trailing blank lines after the last row are not rows: still fine.
    _tb_reset(256);
    _tb_cyml_header(1, 1, 1, 0);
    _tb_str("[[entries]]\nchar = \"A\"\n---\n#\n\n\n\n");
    assert(_font_parse(_tb_buf, _tb_len) != 0, "trailing newlines after the last row -> loads");
    _tb_reset(256);
    _tb_cyml_header(1, 1, 1, 0);
    _tb_str("[[entries]]\nchar = \"A\"\n---\n#\n.");
    assert_eq(_font_parse(_tb_buf, _tb_len), 0, "one surplus row -> 0");
    # No entries: the header lists, the font does not load.
    _tb_reset(256);
    _tb_cyml_header(1, 3, 3, 1);
    assert_eq(_font_parse(_tb_buf, _tb_len), 0, "zero entries -> font 0");
    assert(_font_header_parse(_tb_buf, _tb_len) != 0, "zero entries -> header lists");
    # Schema other than 1, in memory.
    _tb_reset(256);
    _tb_cyml_header(2, 1, 1, 0);
    _tb_cyml_entry(65, 1, 1);
    assert_eq(_font_parse(_tb_buf, _tb_len), 0, "schema 2 -> 0");
    assert_eq(_font_header_parse(_tb_buf, _tb_len), 0, "schema 2 -> header 0");
}

# MAX_GLYPHS is 256, but the binding limit is CHARMAP_SIZE: every entry
# needs a distinct char below 128, so 128 is the most that can load.
fn t_cyml_entry_cap() {
    test_group("CYML / entry cap: 128 binds, not MAX_GLYPHS");
    _tb_reset(16384);
    _tb_cyml_header(1, 1, 1, 0);
    var c = 0;
    while (c < 128) { _tb_cyml_entry(c, 1, 1); c = c + 1; }
    var f = _font_parse(_tb_buf, _tb_len);
    assert(f != 0, "128 entries, chars 0..127 -> loads");
    if (f != 0) {
        assert_eq(font_count(f), 128, "count 128");
        var ok = 1;
        c = 0;
        while (c < 128) {
            if (font_glyph_index(f, c) != c) { ok = 0; }
            c = c + 1;
        }
        assert_eq(ok, 1, "char c -> glyph c for every c in 0..127");
    }
    # A 129th entry has to repeat a char (or leave ASCII): rejected.
    _tb_cyml_entry(65, 1, 1);
    assert_eq(_font_parse(_tb_buf, _tb_len), 0, "129 entries -> 0 (a char repeats)");
    # Past MAX_GLYPHS the count gate fires before any entry is decoded.
    _tb_reset(32768);
    _tb_cyml_header(1, 1, 1, 0);
    c = 0;
    while (c < 257) { _tb_cyml_entry(65, 1, 1); c = c + 1; }
    assert_eq(_font_parse(_tb_buf, _tb_len), 0, "257 entries -> 0");
}

# A valid one-glyph font padded with `#` comment lines to exactly `total`
# bytes. Leaves it in the builder.
fn _tb_padded_font(total): i64 {
    _tb_reset(total + 128);
    _tb_cyml_header(1, 1, 1, 0);
    _tb_cyml_entry(65, 1, 1);
    var body = _tb_buf;
    var blen = _tb_len;
    var out = alloc(total + 128);
    var o = 0;
    var left = total - blen;
    while (left > 0) {
        var line = left;
        if (line > 80) { line = 80; }
        if (line == 1) {
            store8(out + o, 10);
        } else {
            store8(out + o, 35);
            memset(out + o + 1, 120, line - 2);
            store8(out + o + line - 1, 10);
        }
        o = o + line;
        left = left - line;
    }
    memcpy(out + o, body, blen);
    _tb_buf = out;
    _tb_len = o + blen;
    return 0;
}

fn t_cyml_size_gate() {
    test_group("CYML / size gate: 65535 loads, 65536 does not");
    _tb_padded_font(65535);
    assert_eq(_tb_len, 65535, "padded to 65535");
    assert(_font_parse(_tb_buf, _tb_len) != 0, "65535 bytes -> loads");
    assert(_font_header_parse(_tb_buf, _tb_len) != 0, "65535 bytes -> lists");
    _tb_padded_font(65536);
    assert_eq(_tb_len, 65536, "padded to 65536");
    assert_eq(_font_parse(_tb_buf, _tb_len), 0, "65536 bytes -> 0 (>= MAX_FILE_BYTES)");
    assert_eq(_font_header_parse(_tb_buf, _tb_len), 0, "65536 bytes -> header 0");
}

# A .flf of `height` rows, every glyph row `w` copies of 'W', CL comments.
fn _tb_flf(height, w, comments): i64 {
    _tb_reset(200 + comments * 4 + 95 * height * (w + 3));
    _tb_str("flf2a$ "); _tb_int(height);
    _tb_str(" 0 "); _tb_int(w + 2);
    _tb_str(" 0 "); _tb_int(comments);
    _tb_byte(10);
    var c = 0;
    while (c < comments) { _tb_str("cm\n"); c = c + 1; }
    var g = 0;
    while (g < 95) {
        var r = 0;
        while (r < height) {
            _tb_rep(87, w);
            _tb_byte(64);
            if (r + 1 == height) { _tb_byte(64); }
            _tb_byte(10);
            r = r + 1;
        }
        g = g + 1;
    }
    return 0;
}

fn t_flf_header_gates() {
    test_group(".flf / the adapter's envelope (128 x 64) and header gates");
    assert_eq(flf_load_file("tests/fixtures/flf_too_many_comments.flf"), 0, "1025 comment lines -> 0");
    # 128 x 64 since 1.5.0 (was 64 x 32); schema 1's 64 x 32 is untouched.
    assert_eq(flf_load_file("tests/fixtures/flf_wide_129.flf"), 0, "129-column glyph rows -> 0");
    _tb_flf(1, 128, 0);
    var f = _flf_parse(_tb_buf, _tb_len);
    assert(f != 0, "128-column glyph rows -> loads (FLF_MAX_WIDTH)");
    if (f != 0) { assert_eq(font_width(f), 128, "width 128"); }
    _tb_flf(1, 65, 0);
    assert(_flf_parse(_tb_buf, _tb_len) != 0, "65 columns -> loads since 1.5.0 (was the first rejected width)");
    _tb_flf(1, 129, 0);
    assert_eq(_flf_parse(_tb_buf, _tb_len), 0, "129 columns, in memory -> 0");
    _tb_flf(64, 1, 0);
    f = _flf_parse(_tb_buf, _tb_len);
    assert(f != 0, "height 64 -> loads (FLF_MAX_HEIGHT)");
    if (f != 0) { assert_eq(font_height(f), 64, "height 64"); }
    _tb_flf(33, 1, 0);
    assert(_flf_parse(_tb_buf, _tb_len) != 0, "height 33 -> loads since 1.5.0");
    _tb_flf(65, 1, 0);
    assert_eq(_flf_parse(_tb_buf, _tb_len), 0, "height 65 -> 0");
    assert(FLF_MAX_WIDTH != MAX_WIDTH, "the .flf envelope is not schema 1's");
    _tb_flf(1, 1, 1024);
    assert(_flf_parse(_tb_buf, _tb_len) != 0, "1024 comment lines -> loads (FLF_MAX_COMMENTS)");
    _tb_flf(1, 1, 1025);
    assert_eq(_flf_parse(_tb_buf, _tb_len), 0, "1025 comment lines -> 0");
}

fn t_flf_size_gate() {
    test_group(".flf / size gate: FLF_MAX_FILE - 1 loads, FLF_MAX_FILE does not");
    # Bytes after the 95th glyph are ignored (the German block and any
    # code-tagged glyphs are skipped), so padding goes at the end.
    _tb_flf(1, 1, 0);
    var base = _tb_buf;
    var blen = _tb_len;
    var big = alloc(1048576);
    memcpy(big, base, blen);
    memset(big + blen, 10, 1048576 - blen);
    assert(_flf_parse(big, 1048575) != 0, "1048575 bytes -> loads");
    assert_eq(_flf_parse(big, 1048576), 0, "1048576 bytes -> 0");
}

fn t_font_construction() {
    test_group("font_new / font_set_char / font_set_row");
    var f = font_new(3, 2, 1, 2);
    assert(f != 0, "font_new");
    assert_eq(font_width(f), 3, "width");
    assert_eq(font_height(f), 2, "height");
    assert_eq(font_gap(f), 1, "gap");
    assert_eq(font_count(f), 2, "count");
    assert_eq(load8(font_row(f, 1, 1) + 2), 32, "rows start as spaces");
    assert_eq(font_glyph_index(f, 65), 0 - 1, "charmap starts empty");
    assert_eq(font_set_char(f, 0, 65), 0, "map A -> glyph 0");
    assert_eq(font_set_char(f, 1, 65), 0 - 1, "A again -> -1 (duplicate)");
    assert_eq(font_set_char(f, 1, 128), 0 - 1, "128 -> -1 (past CHARMAP_SIZE)");
    assert_eq(font_set_char(f, 1, 0 - 1), 0 - 1, "-1 -> -1");
    assert_eq(font_set_char(f, 1, 66), 0, "map B -> glyph 1");
    assert_eq(font_glyph_index(f, 66), 1, "B -> 1");
    assert_eq(font_glyph_index(f, 98), 1, "b folds to B");
    font_set_row(f, 1, 0, "#.#");
    assert_eq(memeq(font_row(f, 1, 0), "#.#", 3), 1, "font_set_row copies width bytes");
    assert_eq(load8(font_row(f, 0, 0)), 32, "glyph 0 untouched");
}

# ---- 1.4.1: src/cli.cyr, tested for the first time ----

fn t_cli_is_flf_path() {
    test_group("cli / _is_flf_path");
    assert_eq(_is_flf_path("a.flf"), 1, "a.flf");
    assert_eq(_is_flf_path("./modular.flf"), 1, "./modular.flf");
    assert_eq(_is_flf_path(".flf"), 0, ".flf alone is a CYML name (rejected there)");
    assert_eq(_is_flf_path("flf"), 0, "flf");
    assert_eq(_is_flf_path("a.FLF"), 0, "case-sensitive");
    assert_eq(_is_flf_path("a.flfx"), 0, "suffix must be last");
    assert_eq(_is_flf_path(""), 0, "empty");
}

fn t_fontpath_name_ok() {
    test_group("fontpath / font_name_ok + font_path_join (the --font containment)");
    assert_eq(font_name_ok("block"), 1, "block");
    assert_eq(font_name_ok("my-font_2"), 1, "dash, underscore, digit");
    assert_eq(font_name_ok(""), 0, "empty");
    assert_eq(font_name_ok(0), 0, "null");
    assert_eq(font_name_ok("a/b"), 0, "slash");
    assert_eq(font_name_ok("../block"), 0, "traversal");
    assert_eq(font_name_ok("a\\b"), 0, "backslash");
    assert_eq(font_name_ok("a.b"), 0, "dot");
    assert_eq(font_name_ok("a\x1bb"), 0, "ESC");
    assert_eq(font_name_ok("a\x7fb"), 0, "DEL");
    var n64[72];
    memset(&n64, 110, 64);
    store8(&n64 + 64, 0);
    assert_eq(font_name_ok(&n64), 1, "64 bytes (FONT_NAME_CAP)");
    store8(&n64 + 64, 110);
    store8(&n64 + 65, 0);
    assert_eq(font_name_ok(&n64), 0, "65 bytes");
    var out[96];
    assert_eq(font_path_join(&out, 96, "./fonts", "block"), 18, "./fonts/block.cyml");
    assert_eq(memeq(&out, "./fonts/block.cyml", 19), 1, "joined, NUL-terminated");
    assert_eq(font_path_join(&out, 18, "./fonts", "block"), 0, "19 bytes needed, 18 available -> 0");
    assert_eq(font_path_join(&out, 19, "./fonts", "block"), 18, "19 available -> fits");
    assert(FP_PATH_CAP >= FP_DIR_CAP + 1 + FONT_NAME_CAP + 6, "FP_PATH_CAP holds the longest dir and name");
}

fn t_fontpath_env_ok() {
    test_group("fontpath / font_env_ok (BNRMR_FONTS)");
    assert_eq(font_env_ok("/usr/share/bannermanor/fonts"), 1, "absolute");
    assert_eq(font_env_ok("my fonts"), 1, "relative, with a space");
    assert_eq(font_env_ok(""), 0, "empty");
    assert_eq(font_env_ok(0), 0, "null");
    assert_eq(font_env_ok("a\x1bb"), 0, "ESC");
    assert_eq(font_env_ok("a\x9bb"), 0, "C1 CSI");
    var big = alloc(1100);
    memset(big, 97, 1023);
    store8(big + 1023, 0);
    assert_eq(font_env_ok(big), 1, "1023 bytes");
    memset(big, 97, 1024);
    store8(big + 1024, 0);
    assert_eq(font_env_ok(big), 0, "1024 bytes (FP_ENV_CAP)");
}

fn t_fontpath_install_dir() {
    test_group("fontpath / install_dir_from_exe");
    var out[256];
    assert_eq(install_dir_from_exe("/usr/local/bin/bnrmr", &out, 256), 34, "/usr/local/bin -> /usr/local/share/...");
    assert_eq(streq(&out, "/usr/local/share/bannermanor/fonts"), 1, "the path");
    assert_eq(install_dir_from_exe("/bin/bnrmr", &out, 256), 24, "/bin (AGNOS) -> /share/...");
    assert_eq(streq(&out, "/share/bannermanor/fonts"), 1, "the AGNOS path");
    install_dir_from_exe("/opt/bnrmr-1.6.0/bin/bnrmr", &out, 256);
    assert_eq(streq(&out, "/opt/bnrmr-1.6.0/share/bannermanor/fonts"), 1, "an unpacked tarball");
    assert_eq(install_dir_from_exe("/home/u/repo/build/bnrmr", &out, 256), 0, "not in bin/ -> none (the golden suite)");
    assert_eq(install_dir_from_exe("/usr/sbin/bnrmr", &out, 256), 0, "sbin is not bin");
    assert_eq(install_dir_from_exe("/usr/xbin/bnrmr", &out, 256), 0, "xbin is not bin");
    assert_eq(install_dir_from_exe("bin/bnrmr", &out, 256), 0, "relative -> none");
    assert_eq(install_dir_from_exe("/bnrmr", &out, 256), 0, "root -> none");
    assert_eq(install_dir_from_exe(0, &out, 256), 0, "null -> none");
    assert_eq(install_dir_from_exe("/usr/local/bin/bnrmr", &out, 34), 0, "no room for the NUL -> none");
}

# The search path itself, from synthetic BNRMR_FONTS and executable
# values. Restores the process's real path at the end.
fn t_fontpath_resolve() {
    test_group("fontpath / fontpath_setup_from + font_resolve");
    var out[4200];
    assert_eq(fontpath_setup_from(0, 0), 0, "no env, no exe");
    assert_eq(fontpath_count(), 1, "just ./fonts");
    assert_eq(streq(fontpath_dir(0), "./fonts"), 1, "./fonts");
    assert_eq(font_resolve("slim", &out, 4200), FP_FOUND, "slim in ./fonts");
    assert_eq(streq(&out, "./fonts/slim.cyml"), 1, "its path");
    assert_eq(font_resolve("nosuch", &out, 4200), FP_MISSING, "nosuch -> missing");
    assert_eq(fontpath_setup_from("tests/golden/cwd/envfonts", "/opt/x/bin/bnrmr"), 0, "env and exe");
    assert_eq(fontpath_count(), 3, "env, ./fonts, install");
    assert_eq(streq(fontpath_dir(0), "tests/golden/cwd/envfonts"), 1, "env first");
    assert_eq(streq(fontpath_dir(1), "./fonts"), 1, "./fonts second");
    assert_eq(streq(fontpath_dir(2), "/opt/x/share/bannermanor/fonts"), 1, "install third");
    assert_eq(font_resolve("block", &out, 4200), FP_FOUND, "block: env shadows ./fonts");
    assert_eq(streq(&out, "tests/golden/cwd/envfonts/block.cyml"), 1, "the env copy");
    assert_eq(font_resolve("big", &out, 4200), FP_FOUND, "big falls through to ./fonts");
    assert_eq(streq(&out, "./fonts/big.cyml"), 1, "the ./fonts copy");
    assert_eq(fontpath_setup_from("", 0), 0, "empty env is unset");
    assert_eq(fontpath_count(), 1, "just ./fonts again");
    assert_eq(fontpath_setup_from("a\x1bb", 0), 0 - 1, "a control byte -> -1");
    var desc[512];
    fontpath_setup_from("no/such/dir", 0);
    var dn = fontpath_describe(&desc, 0, 512);
    store8(&desc + dn, 0);
    assert_eq(streq(&desc, "no/such/dir (missing), ./fonts"), 1, "describe marks the missing dir");
    #ifdef CYRIUS_TARGET_LINUX
    # From a directory with no fonts/: block is built in, slim is nowhere.
    if (sys_chdir("tests/golden/cwd/empty") == 0) {
        fontpath_setup_from(0, 0);
        var rb = font_resolve("block", &out, 4200);
        var rs = font_resolve("slim", &out, 4200);
        sys_chdir("../../../..");
        assert_eq(rb, FP_BUILTIN, "block with no block.cyml anywhere -> built in");
        assert_eq(rs, FP_MISSING, "slim -> missing");
    }
    #endif
    fontpath_setup();
}

fn t_cli_parse_align() {
    test_group("cli / parse_align");
    assert_eq(parse_align(0), ALIGN_LEFT, "absent -> left");
    assert_eq(parse_align("left"), ALIGN_LEFT, "left");
    assert_eq(parse_align("L"), ALIGN_LEFT, "L");
    assert_eq(parse_align("center"), ALIGN_CENTER, "center");
    assert_eq(parse_align("centre"), ALIGN_CENTER, "centre");
    assert_eq(parse_align("C"), ALIGN_CENTER, "C");
    assert_eq(parse_align("right"), ALIGN_RIGHT, "right");
    assert_eq(parse_align("R"), ALIGN_RIGHT, "R");
    assert_eq(parse_align(""), 0 - 1, "empty -> -1");
    assert_eq(parse_align("LEFT"), 0 - 1, "LEFT -> -1");
    assert_eq(parse_align("l"), 0 - 1, "l -> -1");
    assert_eq(parse_align("middle"), 0 - 1, "middle -> -1");
}

# The sentinels are exit-code contract: main() maps -2 to "bad integer
# value", -3 to "must be non-negative", -4 to the "max" message.
fn t_cli_parse_count_flag() {
    test_group("cli / _parse_count_flag (--width / --pad)");
    assert_eq(_parse_count_flag(0), 0, "absent -> 0");
    assert_eq(_parse_count_flag("0"), 0, "0");
    assert_eq(_parse_count_flag("5"), 5, "5");
    assert_eq(_parse_count_flag("007"), 7, "007 -> 7 (leading zeros kept working)");
    assert_eq(_parse_count_flag("-0"), 0, "-0 -> 0");
    assert_eq(_parse_count_flag("-00"), 0, "-00 -> 0");
    assert_eq(_parse_count_flag("4097"), 4097, "4097 parses; main applies WIDTH_CAP");
    assert_eq(_parse_count_flag("1048576"), 1048576, "PARSER_INT_CAP itself parses");
    assert_eq(_parse_count_flag("-5"), 0 - 3, "-5 -> COUNT_NEG");
    assert_eq(_parse_count_flag("1048577"), 0 - 4, "past PARSER_INT_CAP -> COUNT_OVER");
    assert_eq(_parse_count_flag("18446744073709551617"), 0 - 4, "u64 wrap -> COUNT_OVER (F-015)");
    assert_eq(_parse_count_flag("-1048577"), 0 - 4, "negative and huge -> COUNT_OVER");
    assert_eq(_parse_count_flag(""), 0 - 2, "empty -> COUNT_BAD");
    assert_eq(_parse_count_flag("-"), 0 - 2, "lone - -> COUNT_BAD");
    assert_eq(_parse_count_flag("abc"), 0 - 2, "abc -> COUNT_BAD");
    assert_eq(_parse_count_flag("+5"), 0 - 2, "+5 -> COUNT_BAD");
    assert_eq(_parse_count_flag(" 5"), 0 - 2, "leading space -> COUNT_BAD");
    assert_eq(_parse_count_flag("12a"), 0 - 2, "trailing junk -> COUNT_BAD");
}

# Parse a synthetic argv (bnrmr + `n` words from `words`) and join.
fn _jp(words, n, out, cap): i64 {
    var argv_arr[2048];
    store64(&argv_arr, "bnrmr");
    var i = 0;
    while (i < n) { store64(&argv_arr + (i + 1) * 8, load64(words + i * 8)); i = i + 1; }
    var fs = cli_flags();
    if (cmdit_parse_argv(fs, n + 1, &argv_arr) != CMDIT_OK) { return 0 - 99; }
    return join_positionals(out, cap, fs);
}

# Parse a synthetic command line with bnrmr's flag table. `line` is a
# cstring of words separated by single spaces (no word contains one).
# Returns the fresh handle; the cmdit_parse_argv result is stored at
# *out_r. argv[0] is "bnrmr".
fn _cf(line, out_r): i64 {
    var argv_arr[512];
    store64(&argv_arr, "bnrmr");
    var n = 1;
    var len = strlen(line);
    var buf = alloc(len + 1);
    memcpy(buf, line, len);
    store8(buf + len, 0);
    var start = 0;
    var i = 0;
    while (i <= len && len > 0) {
        if (i == len || load8(buf + i) == 32) {
            store8(buf + i, 0);
            store64(&argv_arr + n * 8, buf + start);
            n = n + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    var fs = cli_flags();
    store64(out_r, cmdit_parse_argv(fs, n, &argv_arr));
    return fs;
}

# The flag table on synthetic argv (1.4.2, cmdit). The golden suite pins
# what the binary prints; this pins what the parser hands main().
fn t_cli_flags() {
    test_group("cli / cli_flags + cmdit_parse_argv");
    var r = 0;
    var fs = _cf("-f slim --align=center -w 40 --pad 2 --color red HELLO WORLD", &r);
    assert_eq(r, CMDIT_OK, "a full command line parses");
    assert_eq(streq(cmdit_get_str(fs, CF_FONT), "slim"), 1, "-f slim");
    assert_eq(streq(cmdit_get_str(fs, CF_ALIGN), "center"), 1, "--align=center");
    assert_eq(streq(cmdit_get_str(fs, CF_WIDTH), "40"), 1, "-w 40 (a string: _parse_count_flag parses it)");
    assert_eq(streq(cmdit_get_str(fs, CF_PAD), "2"), 1, "--pad 2");
    assert_eq(streq(cmdit_get_str(fs, CF_COLOR), "red"), 1, "--color red");
    assert_eq(cmdit_positional_count(fs), 2, "two words");
    fs = _cf("HI", &r);
    assert_eq(cmdit_get_str(fs, CF_FONT), 0, "absent --font -> 0 (the embedded font)");
    assert_eq(cmdit_get_str(fs, CF_WIDTH), 0, "absent --width -> 0");
    assert_eq(cmdit_get_bool(fs, CF_LIST), 0, "absent --list-fonts -> 0");
    fs = _cf("HI --font slim --font big", &r);
    assert_eq(r, CMDIT_OK, "flags after text, repeated");
    assert_eq(streq(cmdit_get_str(fs, CF_FONT), "big"), 1, "the last --font wins");
    assert_eq(cmdit_positional_count(fs), 1, "HI is the only word");
    fs = _cf("--color= HI", &r);
    assert_eq(streq(cmdit_get_str(fs, CF_COLOR), ""), 1, "--color= is the empty string (no color, exit 0)");
    fs = _cf("-- --version -HI", &r);
    assert_eq(r, CMDIT_OK, "-- ends the flags");
    assert_eq(cmdit_positional_count(fs), 2, "both words after -- are text");
    _cf("--help", &r);
    assert_eq(r, CMDIT_HELP, "--help -> CMDIT_HELP");
    _cf("-h HI", &r);
    assert_eq(r, CMDIT_HELP, "-h -> CMDIT_HELP");
    _cf("--version", &r);
    assert_eq(r, CMDIT_VERSION, "--version -> CMDIT_VERSION");
    _cf("--version --help", &r);
    assert_eq(r, CMDIT_HELP, "help wins over version");
    fs = _cf("-V", &r);
    assert_eq(r, CMDIT_RESULT_ERR, "-V is not version: dropped, the freeze adds no flags");
    assert_eq(cmdit_error(fs), CMDIT_ERR_UNKNOWN, "-V -> UNKNOWN");
    fs = _cf("--help --bogus", &r);
    assert_eq(cmdit_error(fs), CMDIT_ERR_UNKNOWN, "an error anywhere beats --help");
    fs = _cf("--col red HI", &r);
    assert_eq(cmdit_error(fs), CMDIT_ERR_UNKNOWN, "no prefix matching");
    fs = _cf("-hf HI", &r);
    assert_eq(cmdit_error(fs), CMDIT_ERR_BUNDLED, "-hf -> BUNDLED");
    fs = _cf("-w=11 AG", &r);
    assert_eq(cmdit_error(fs), CMDIT_ERR_BUNDLED, "-w=11 -> BUNDLED");
    fs = _cf("HI --width", &r);
    assert_eq(cmdit_error(fs), CMDIT_ERR_MISSING_VALUE, "--width at the end -> MISSING_VALUE");
    fs = _cf("--list-fonts=0", &r);
    assert_eq(cmdit_error(fs), CMDIT_ERR_UNEXPECTED_VALUE, "a bool given =0 -> UNEXPECTED_VALUE, not set");
    fs = _cf("--font --list-fonts HI", &r);
    assert_eq(r, CMDIT_OK, "a value flag takes the next token even if it looks like a flag");
    assert_eq(streq(cmdit_get_str(fs, CF_FONT), "--list-fonts"), 1, "--font's value is --list-fonts");
    assert_eq(cmdit_get_bool(fs, CF_LIST), 0, "--list-fonts was consumed as a value, not set");
}

# The parse-error diagnostics (1.5.0): one line on stderr naming what was
# typed, a blank line, the usage block; nothing on stdout.
fn _rpe(line, buf, cap, out_n, out_rc): i64 {
    var r = 0;
    var fs = _cf(line, &r);
    var rd = 0;
    var wr = 0;
    var saved = _cap_begin_fd(2, &rd, &wr);
    if (saved < 0) { return 0 - 1; }
    var rc = report_parse_error(fs);
    var n = _cap_end_fd(2, saved, rd, wr, buf, cap);
    store64(out_n, n);
    store64(out_rc, rc);
    return 0;
}

fn t_cli_report_parse_error() {
    test_group("cli / report_parse_error (stderr, names the token)");
    #ifdef CYRIUS_TARGET_LINUX
    var buf = alloc(8192);
    var n = 0;
    var rc = 0;
    var lines[56];
    store64(&lines, "--bogus HI");
    store64(&lines + 8, "--font");
    store64(&lines + 16, "-HI");
    store64(&lines + 24, "--list-fonts=0");
    store64(&lines + 32, "--bogus\x1b[31m HI");
    store64(&lines + 40, "--bogus\x9bx HI");
    store64(&lines + 48, "--aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
    var want[56];
    store64(&want, "bnrmr: unknown flag: --bogus\n\n");
    store64(&want + 8, "bnrmr: --font: missing value\n\n");
    store64(&want + 16, "bnrmr: -HI: bundled short flags are not supported (write -x -y; put -- before");
    store64(&want + 24, "bnrmr: --list-fonts=0: this flag takes no value\n\n");
    store64(&want + 32, "bnrmr: unknown flag: --bogus?[31m\n\n");
    store64(&want + 40, "bnrmr: unknown flag: --bogus?x\n\n");
    store64(&want + 48, "bnrmr: unknown flag: --aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa...\n\n");
    var k = 0;
    while (k < 7) {
        if (_rpe(load64(&lines + k * 8), buf, 8192, &n, &rc) == 0) {
            var w = load64(&want + k * 8);
            var wl = strlen(w);
            assert_eq(rc, 1, "exit code 1");
            assert_eq(memeq(buf, w, wl), 1, "the line names the token, control bytes as '?', long ones cut");
            assert_eq(_has(buf, n, "Usage:"), 1, "the usage block follows on stderr");
        }
        k = k + 1;
    }
    #endif
}

fn t_cli_join_positionals() {
    test_group("cli / join_positionals (the 1 KB cap)");
    var out = alloc(2048);
    var w[64];
    store64(&w, "HELLO");
    store64(&w + 8, "WORLD");
    assert_eq(_jp(&w, 2, out, MAX_INPUT), 11, "HELLO WORLD -> 11 bytes");
    assert_eq(memeq(out, "HELLO WORLD", 11), 1, "joined with one space");
    assert_eq(_jp(&w, 0, out, MAX_INPUT), 0, "no words -> 0");
    var a1024 = alloc(1100);
    memset(a1024, 65, 1024);
    store8(a1024 + 1024, 0);
    store64(&w, a1024);
    assert_eq(_jp(&w, 1, out, MAX_INPUT), 1024, "one 1024-byte word -> 1024");
    store8(a1024 + 1024, 65);
    store8(a1024 + 1025, 0);
    assert_eq(_jp(&w, 1, out, MAX_INPUT), 0 - 1, "one 1025-byte word -> -1");
    var a512 = alloc(600);
    memset(a512, 65, 512);
    store8(a512 + 512, 0);
    var a511 = alloc(600);
    memset(a511, 65, 511);
    store8(a511 + 511, 0);
    store64(&w, a512);
    store64(&w + 8, a511);
    assert_eq(_jp(&w, 2, out, MAX_INPUT), 1024, "512 + space + 511 -> 1024");
    store64(&w + 8, a512);
    assert_eq(_jp(&w, 2, out, MAX_INPUT), 0 - 1, "512 + space + 512 -> -1");
    # 200 words: past the 128 the old flag parser kept (issue 0007).
    var many = alloc(256 * 8);
    var k = 0;
    while (k < 200) { store64(many + k * 8, "x"); k = k + 1; }
    assert_eq(_jp(many, 200, out, MAX_INPUT), 399, "200 one-letter words -> 399 bytes, none dropped");
}

fn t_cli_sort_paths() {
    test_group("cli / _str_lex_cmp + _sort_paths (--list-fonts order)");
    assert(_str_lex_cmp(str_from("a"), str_from("ab")) < 0, "prefix sorts first");
    assert(_str_lex_cmp(str_from("b"), str_from("a")) > 0, "b > a");
    assert_eq(_str_lex_cmp(str_from("big"), str_from("big")), 0, "equal");
    assert(_str_lex_cmp(str_from("B"), str_from("a")) < 0, "bytewise: B < a");
    var v = vec_new();
    vec_push(v, str_from("fonts/slim.cyml"));
    vec_push(v, str_from("fonts/big.cyml"));
    vec_push(v, str_from("fonts/block.cyml"));
    _sort_paths(v);
    assert_eq(memeq(str_data(vec_get(v, 0)), "fonts/big.cyml", 14), 1, "big first");
    assert_eq(memeq(str_data(vec_get(v, 1)), "fonts/block.cyml", 16), 1, "block second");
    assert_eq(memeq(str_data(vec_get(v, 2)), "fonts/slim.cyml", 15), 1, "slim third");
}

# ---- 1.2.0: stdout probes through darshana (issues 0018 / 0019) ----
#
# term_width_ioctl / stdout_is_tty now ride darshana's tty_winsize
# instead of a local TIOCGWINSZ ioctl. Nothing tested either probe
# before 1.2.0: the suite's own stdout is whatever the runner gave it,
# so a live call is not deterministic. The Linux tests below point
# fd 1 at a fd they control — /dev/null, a pipe, a pty slave with a
# window size they set — call the probes, and put fd 1 back BEFORE
# asserting (every assert writes to fd 1).

fn t_usable_cols() {
    test_group("layout / _usable_cols (tty_winsize answer -> width)");
    assert_eq(_usable_cols(0, 80),     80,         "80 cols -> 80");
    assert_eq(_usable_cols(0, 1),      1,          "1 col -> 1");
    assert_eq(_usable_cols(0, 0),      0,          "0 cols -> 0 (F-020: size unknown)");
    assert_eq(_usable_cols(0 - 1, 80), 0,          "failed query -> 0, whatever cols holds");
    assert_eq(_usable_cols(0, 4096),   4096,       "at WS_COL_CAP -> 4096");
    assert_eq(_usable_cols(0, 4097),   WS_COL_CAP, "past WS_COL_CAP -> clamped (F-008)");
    assert_eq(_usable_cols(0, 65535),  WS_COL_CAP, "u16 max -> clamped (F-008)");
    # 1.7.0 (ADR 0004): the AGNOS fd_kind gate is compiled out here.
    # Linux's answer is TIOCGWINSZ on fd 1 itself, so the gate must stay
    # open, or every Linux terminal would lose its width and its color.
    # The AGNOS arm runs only under scripts/agnos-smoke.py.
    #ifndef CYRIUS_TARGET_AGNOS
    assert_eq(_winsize_describes_stdout(), 1, "Linux: the per-fd ioctl decides, not the gate");
    #endif
}

# bannermanor keeps its own control-byte scrub (space, length-preserving)
# rather than darshana's tty_sanitize_buf, whose replacement byte is '?'
# — darshana ADR 0004 records that bannermanor's space was deliberately
# not reproduced. What the two must agree on is WHICH bytes are
# neutralized: darshana's TTY_SANITIZE_LATIN1 mode is modeled on this
# rule. Pin that, so neither can drift without this going red.
fn t_scrub_matches_darshana_latin1() {
    test_group("scrub / same byte set as darshana TTY_SANITIZE_LATIN1");
    var one[8];
    var b = 0;
    var disagree = 0;
    var replaced = 0;
    while (b < 256) {
        store64(&one, b);
        var ours = 0;
        if (_scrub_ctl(b) != b) { ours = 1; replaced = replaced + 1; }
        var theirs = tty_has_ctl(&one, 1, TTY_SANITIZE_LATIN1, 0);
        if (ours != theirs) { disagree = disagree + 1; }
        b = b + 1;
    }
    assert_eq(disagree, 0, "every byte 0..255: same verdict as tty_has_ctl(LATIN1)");
    assert_eq(replaced, 65, "65 bytes neutralized (32 C0 + DEL + 32 C1)");
    assert_eq(_scrub_ctl(27), 32, "ESC -> space (not darshana's '?')");
}

#ifdef CYRIUS_TARGET_LINUX

# ioctl requests and an open flag the stdlib does not define. All three
# requests are asm-generic, identical on x86_64 and aarch64 Linux;
# O_NOCTTY (0400) is not one of the four flags arm64 overrides.
var PT_O_NOCTTY   = 0x100;
var PT_TIOCGPTN   = 0x80045430;     # _IOR('T', 0x30, uint): slave number
var PT_TIOCSPTLCK = 0x40045431;     # _IOW('T', 0x31, int): (un)lock slave
var PT_TIOCSWINSZ = 0x5414;         # set window size

# Open a pty pair. Master is non-blocking. Writes both fds through the
# out-pointers; returns 0, or -1 if this host has no usable /dev/ptmx.
fn _pt_open(out_m, out_s): i64 {
    var m = sys_open("/dev/ptmx", O_RDWR | PT_O_NOCTTY | O_NONBLOCK, 0);
    if (m < 0) { return 0 - 1; }
    var lk = 0;
    var n = 0;
    if (sys_ioctl(m, PT_TIOCSPTLCK, &lk) < 0) { sys_close(m); return 0 - 1; }
    if (sys_ioctl(m, PT_TIOCGPTN, &n) < 0) { sys_close(m); return 0 - 1; }
    var path[32];
    memcpy(&path, "/dev/pts/", 9);
    var pend = tty_dec_buf(&path, 9, n & 0xFFFFFFFF);
    store8(&path + pend, 0);
    var s = sys_open(&path, O_RDWR | PT_O_NOCTTY, 0);
    if (s < 0) { sys_close(m); return 0 - 1; }
    store64(out_m, m);
    store64(out_s, s);
    return 0;
}

fn _pt_set_winsize(s, rows, cols): i64 {
    var ws[8];
    store64(&ws, 0);
    store16(&ws, rows);
    store16(&ws + 2, cols);
    return sys_ioctl(s, PT_TIOCSWINSZ, &ws);
}

# Point fd 1 at `fd`. Returns the saved fd 1 (for _pt_restore), or -1.
fn _pt_redirect(fd): i64 {
    var saved = syscall(SYS_DUP, 1);
    if (saved < 0) { return 0 - 1; }
    if (sys_dup2(fd, 1) < 0) { sys_close(saved); return 0 - 1; }
    return saved;
}

fn _pt_restore(saved): i64 {
    sys_dup2(saved, 1);
    sys_close(saved);
    return 0;
}

fn _pt_nap(): i64 {
    var ts[16];
    store64(&ts, 0);
    store64(&ts + 8, 1000000);          # 1 ms
    sys_nanosleep(&ts, 0);
    return 0;
}

# Read a non-blocking fd until 20 ms pass with nothing new (bounded at
# ~1 s, so a wedged pty cannot hang the suite). Returns bytes read.
fn _pt_drain(rd, buf, cap): i64 {
    var got = 0;
    var idle = 0;
    var it = 0;
    while (idle < 20 && it < 1000) {
        var n = sys_read(rd, buf + got, cap - got);
        if (n > 0) { got = got + n; idle = 0; }
        else { _pt_nap(); idle = idle + 1; }
        if (got >= cap) { idle = 20; }
        it = it + 1;
    }
    return got;
}

# term_width_ioctl() and stdout_is_tty() with fd 1 pointed at `fd`.
fn _pt_probe(fd, out_w, out_t): i64 {
    var saved = _pt_redirect(fd);
    if (saved < 0) { return 0 - 1; }
    var w = term_width_ioctl();
    var t = stdout_is_tty();
    _pt_restore(saved);
    store64(out_w, w);
    store64(out_t, t);
    return 0;
}

# render_layout with fd 1 on a fresh pipe; the bytes it wrote land in
# buf. Returns the count, or -1.
fn _pt_render_pipe(buf, cap, font, text, len, width, align, color): i64 {
    var fds[16];
    if (sys_pipe(&fds) < 0) { return 0 - 1; }
    var rd = load32(&fds);
    var wr = load32(&fds + 4);
    var saved = _pt_redirect(wr);
    if (saved < 0) { sys_close(rd); sys_close(wr); return 0 - 1; }
    render_layout(font, text, len, width, align, 0, color);
    _pt_restore(saved);
    sys_close(wr);                      # reader now sees EOF after the data
    var got = 0;
    var go = 1;
    while (go == 1) {
        var n = sys_read(rd, buf + got, cap - got);
        if (n > 0) { got = got + n; } else { go = 0; }
        if (got >= cap) { go = 0; }
    }
    sys_close(rd);
    return got;
}

# render_layout with fd 1 on pty slave `s`; collected off master `m`.
fn _pt_render_pty(m, s, buf, cap, font, text, len, width, align, color): i64 {
    var saved = _pt_redirect(s);
    if (saved < 0) { return 0 - 1; }
    render_layout(font, text, len, width, align, 0, color);
    _pt_restore(saved);
    return _pt_drain(m, buf, cap);
}

# Expected TTY bytes for a colored render: each '\n'-terminated row of
# the plain render `p[0..n)`, wrapped as ESC[<code>m row ESC[0m '\n'.
# `code` 0 means rainbow (rainbow_color_for_row). Every code bnrmr emits
# is two digits (30..37, 90..97). Returns the expected length.
fn _pt_expect_sgr(p, n, out, code): i64 {
    var o = 0;
    var row = 0;
    var start = 0;
    var i = 0;
    while (i < n) {
        if (load8(p + i) == 10) {
            var c = code;
            if (c == 0) { c = rainbow_color_for_row(row); }
            store8(out + o, 27); store8(out + o + 1, 91);       # ESC [
            store8(out + o + 2, 48 + c / 10);
            store8(out + o + 3, 48 + c % 10);
            store8(out + o + 4, 109);                           # m
            o = o + 5;
            memcpy(out + o, p + start, i - start);
            o = o + (i - start);
            memcpy(out + o, "\x1b[0m\n", 5);
            o = o + 5;
            row = row + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return o;
}

fn _pt_same(a, an, b, bn): i64 {
    if (an != bn) { return 0; }
    if (an < 0) { return 0; }
    return memeq(a, b, an);
}

# Point fd `target` at a fresh pipe; *rd_out / *wr_out get its ends.
# Returns the saved fd for _cap_end_fd, or -1.
fn _cap_begin_fd(target, rd_out, wr_out): i64 {
    var fds[16];
    if (sys_pipe(&fds) < 0) { return 0 - 1; }
    var rd = load32(&fds);
    var wr = load32(&fds + 4);
    var saved = syscall(SYS_DUP, target);
    if (saved < 0) { sys_close(rd); sys_close(wr); return 0 - 1; }
    if (sys_dup2(wr, target) < 0) { sys_close(saved); sys_close(rd); sys_close(wr); return 0 - 1; }
    store64(rd_out, rd);
    store64(wr_out, wr);
    return saved;
}

fn _cap_end_fd(target, saved, rd, wr, buf, cap): i64 {
    sys_dup2(saved, target);
    sys_close(saved);
    sys_close(wr);
    var got = 0;
    var go = 1;
    while (go == 1) {
        var n = sys_read(rd, buf + got, cap - got);
        if (n > 0) { got = got + n; } else { go = 0; }
        if (got >= cap) { go = 0; }
    }
    sys_close(rd);
    return got;
}

# Point fd 1 at a fresh pipe; *rd_out / *wr_out get its ends. Returns
# the saved fd 1 for _cap_end, or -1. Whatever is written before
# _cap_end must fit the pipe (64 KB on Linux).
fn _cap_begin(rd_out, wr_out): i64 {
    var fds[16];
    if (sys_pipe(&fds) < 0) { return 0 - 1; }
    var rd = load32(&fds);
    var wr = load32(&fds + 4);
    var saved = _pt_redirect(wr);
    if (saved < 0) { sys_close(rd); sys_close(wr); return 0 - 1; }
    store64(rd_out, rd);
    store64(wr_out, wr);
    return saved;
}

# Restore fd 1 and collect what was written into buf. Returns the count.
fn _cap_end(saved, rd, wr, buf, cap): i64 {
    _pt_restore(saved);
    sys_close(wr);
    var got = 0;
    var go = 1;
    while (go == 1) {
        var n = sys_read(rd, buf + got, cap - got);
        if (n > 0) { got = got + n; } else { go = 0; }
        if (got >= cap) { go = 0; }
    }
    sys_close(rd);
    return got;
}

# Does buf[0..n) contain the cstring s?
fn _has(buf, n, s): i64 {
    var sl = strlen(s);
    var i = 0;
    while (i + sl <= n) {
        if (memeq(buf + i, s, sl) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# "/tmp/bnrmr-t-<pid>-<tag>" into out, NUL-terminated.
fn _tmp_path(out, tag): i64 {
    memcpy(out, "/tmp/bnrmr-t-", 13);
    var e = tty_dec_buf(out, 13, sys_getpid());
    store8(out + e, 45);
    var tl = strlen(tag);
    memcpy(out + e + 1, tag, tl);
    store8(out + e + 1 + tl, 0);
    return 0;
}

# Write buf[0..n) to path (created or truncated). 0, or -1.
fn _tw_file(path, buf, n): i64 {
    var fd = file_open(path, O_WRONLY | O_CREAT | O_TRUNC, 420);
    if (fd < 0) { return 0 - 1; }
    var off = 0;
    var rc = 0;
    while (off < n && rc == 0) {
        var w = file_write(fd, buf + off, n - off);
        if (w <= 0) { rc = 0 - 1; } else { off = off + w; }
    }
    file_close(fd);
    return rc;
}

#endif

# ---- 1.4.1: reader gates and CLI output, through real descriptors ----

# A FIFO in a font path must not block any reader (1.1.4's S_IFREG gate,
# now in _slurp). git cannot hold a FIFO, so it is made here. If the gate
# regressed, open(2) would block and the suite would hit cyrius test's
# deadline, which fails the run.
fn t_reader_fifo() {
    test_group("readers / FIFO rejected before open");
    #ifdef CYRIUS_TARGET_LINUX
    var p[96];
    _tmp_path(&p, "fifo.cyml");
    xunlink(&p);
    var rc = sys_mknodat(0 - 100, &p, 4096 | 384, 0);       # S_IFIFO | 0600
    assert_eq(rc, 0, "mkfifo");
    if (rc == 0) {
        assert_eq(font_load_file(&p), 0, "font_load_file(FIFO) -> 0, no block");
        assert_eq(font_header_load(&p), 0, "font_header_load(FIFO) -> 0, no block");
        assert_eq(flf_load_file(&p), 0, "flf_load_file(FIFO) -> 0, no block");
        xunlink(&p);
    }
    #endif
}

# A FIFO where --list-fonts expects a directory (`mkfifo fonts`). Through
# 1.6.0 dir_list_checked opened it O_RDONLY and blocked until a writer
# came, so the listing hung; cyrius 6.7.11 opens with O_DIRECTORY and gets
# ENOTDIR at once (1.7.0). A regression hangs here, and the 300 s test
# deadline turns that into a failure.
fn t_list_dir_fifo() {
    test_group("cli / --list-fonts on a FIFO named like a directory");
    #ifdef CYRIUS_TARGET_LINUX
    var p[96];
    _tmp_path(&p, "fontsfifo");
    xunlink(&p);
    var rc = sys_mknodat(0 - 100, &p, 4096 | 384, 0);       # S_IFIFO | 0600
    assert_eq(rc, 0, "mkfifo");
    if (rc == 0) {
        var rows = vec_new();
        assert_eq(_lr_scan_dir(rows, &p), 0 - 1, "_lr_scan_dir(FIFO) -> -1, no block");
        assert_eq(vec_len(rows), 0, "no rows from a FIFO");
        xunlink(&p);
    }
    #endif
}

# The 64 KB gate through the real reader (_slurp), not just the parser.
fn t_reader_size_gate_file() {
    test_group("readers / 64 KB gate through font_load_file");
    #ifdef CYRIUS_TARGET_LINUX
    var p[96];
    _tmp_path(&p, "64k.cyml");
    _tb_padded_font(65535);
    assert_eq(_tw_file(&p, _tb_buf, _tb_len), 0, "wrote 65535 bytes");
    assert(font_load_file(&p) != 0, "65535-byte file -> loads");
    assert(font_header_load(&p) != 0, "65535-byte file -> lists");
    _tb_padded_font(65536);
    assert_eq(_tw_file(&p, _tb_buf, _tb_len), 0, "wrote 65536 bytes");
    assert_eq(font_load_file(&p), 0, "65536-byte file -> 0");
    assert_eq(font_header_load(&p), 0, "65536-byte file -> header 0");
    xunlink(&p);
    #endif
}

# F-012: the --list-fonts malformed branch echoes a filesystem path, so it
# goes through _write_scrubbed. Same byte set as _scrub_ctl, and length
# preserving.
fn t_cli_write_scrubbed() {
    test_group("cli / _write_scrubbed (F-012)");
    #ifdef CYRIUS_TARGET_LINUX
    var rd = 0;
    var wr = 0;
    var src = "ev\x1b[31mil\x07.cy\x7fml\x85!";
    var n = strlen(src);
    var buf = alloc(256);
    var saved = _cap_begin(&rd, &wr);
    assert(saved >= 0, "fd 1 on a pipe");
    if (saved >= 0) {
        _write_scrubbed(src, n);
        var got = _cap_end(saved, rd, wr, buf, 256);
        assert_eq(got, n, "length preserved");
        assert_eq(_pt_same(buf, got, "ev [31mil .cy ml !", 18), 1, "ESC, BEL, DEL, C1 -> space; the rest verbatim");
    }
    saved = _cap_begin(&rd, &wr);
    if (saved >= 0) {
        _write_scrubbed("plain.cyml", 10);
        var got2 = _cap_end(saved, rd, wr, buf, 256);
        assert_eq(_pt_same(buf, got2, "plain.cyml", 10), 1, "clean input -> verbatim");
    }
    #endif
}

fn t_cli_print_padded() {
    test_group("cli / _print_padded (--list-fonts name column)");
    #ifdef CYRIUS_TARGET_LINUX
    var rd = 0;
    var wr = 0;
    var buf = alloc(256);
    var saved = _cap_begin(&rd, &wr);
    if (saved >= 0) {
        _print_padded("abc", 6);
        _print_padded("abcdef", 6);
        _print_padded("abcdefgh", 6);
        var got = _cap_end(saved, rd, wr, buf, 256);
        assert_eq(_pt_same(buf, got, "abc   abcdef abcdefgh ", 22), 1, "pad to width; at or past it, one space");
    }
    #endif
}

# --list-fonts from the repo root: the header, then the three in-tree
# fonts in name order. The exact bytes are the golden snapshot tier's.
fn t_cli_list_fonts() {
    test_group("cli / cmd_list_fonts from the repo root");
    #ifdef CYRIUS_TARGET_LINUX
    var rd = 0;
    var wr = 0;
    var buf = alloc(8192);
    var saved = _cap_begin(&rd, &wr);
    if (saved >= 0) {
        var rc = cmd_list_fonts();
        var n = _cap_end(saved, rd, wr, buf, 8192);
        assert_eq(rc, 0, "exit 0");
        assert_eq(memeq(buf, "Available fonts (--font NAME):\n\n", 32), 1, "header line, blank line");
        assert_eq(_has(buf, n, "  big        7x7 gap=1  "), 1, "big: name column, geometry");
        assert_eq(_has(buf, n, "  block      5x5 gap=1  "), 1, "block");
        assert_eq(_has(buf, n, "  slim       4x5 gap=1  "), 1, "slim");
        assert_eq(_has(buf, n, "malformed"), 0, "no in-tree font is malformed");
        assert_eq(_has(buf, n, "\nSearched: ./fonts"), 1, "the directories searched, last");
        assert_eq(_has(buf, n, "built in"), 0, "./fonts/block.cyml shadows the built-in block");
    }
    #endif
}

# cmdit_argv on the real process: what main() does first. It replaced
# bnrmr's own build_argv_array at 1.4.2.
fn t_cli_argv() {
    test_group("cli / cmdit_argv reads the process argv");
    var fs = cli_flags();
    var ac = cmdit_argv(fs);
    assert_eq(cmdit_error(fs), CMDIT_ERR_NONE, "read whole, no error");
    assert(ac >= 1, "argv[0] at least");
    assert_eq(ac, argc(), "the same count lib/args reports");
}

# resolve_frame: an explicit width wins; otherwise the terminal, then
# COLUMNS, then 80. The terminal leg needs a pty, so it is Linux-only.
fn t_layout_resolve_frame() {
    test_group("layout / resolve_frame + term_width_env");
    assert_eq(resolve_frame(40), 40, "explicit width wins");
    assert_eq(resolve_frame(4096), 4096, "explicit 4096");
    var e = term_width_env();
    assert(e >= 0 && e <= WS_COL_CAP, "term_width_env is 0..WS_COL_CAP whatever the runner's COLUMNS");
    #ifdef CYRIUS_TARGET_LINUX
    var m = 0;
    var s = 0;
    if (_pt_open(&m, &s) == 0) {
        _pt_set_winsize(s, 24, 77);
        var saved = _pt_redirect(s);
        var fr = 0;
        if (saved >= 0) {
            fr = resolve_frame(0);
            _pt_restore(saved);
        }
        assert_eq(fr, 77, "no --width, 77-column pty -> 77");
        sys_close(s);
        sys_close(m);
    }
    #endif
}

# The --font NAME diagnostics (1.6.0): not found names the directories,
# malformed names the file, with control bytes as '?'.
fn t_cli_report_font_error() {
    test_group("cli / report_font_error");
    #ifdef CYRIUS_TARGET_LINUX
    var rd = 0;
    var wr = 0;
    var buf = alloc(8192);
    fontpath_setup_from("no/such/dir", 0);
    var saved = _cap_begin_fd(2, &rd, &wr);
    if (saved >= 0) {
        var rc = report_font_error("x", FP_MISSING, "");
        report_font_error("y", FP_FOUND, "./fonts/y\x1b.cyml");
        var n = _cap_end_fd(2, saved, rd, wr, buf, 8192);
        assert_eq(rc, 1, "returns 1");
        var want = alloc(256);
        var wn = _cat(want, 0, "bnrmr: font 'x' not found (searched: no/such/dir (missing), ./fonts)\n");
        wn = _cat(want, wn, "bnrmr: font 'y' is malformed: ./fonts/y?.cyml\n");
        store8(want + wn, 0);
        assert_eq(_pt_same(buf, n, want, strlen(want)), 1, "both lines, exactly");
    }
    fontpath_setup();
    #endif
}

# man/bnrmr.1 (1.6.0) must document every flag, the environment and the
# exit status. A doc-drift check, like the --help one below; the CI step
# runs groff -ww over it for the formatting.
fn t_man_page() {
    test_group("man/bnrmr.1 names every flag");
    var lb[8];
    store64(&lb, 0);
    var m = _slurp("man/bnrmr.1", 65536, &lb);
    assert(m != 0, "man/bnrmr.1 read");
    if (m != 0) {
        var n = load64(&lb);
        assert_eq(_has(m, n, "\\-\\-font"), 1, "--font");
        assert_eq(_has(m, n, "\\-\\-align"), 1, "--align");
        assert_eq(_has(m, n, "\\-\\-width"), 1, "--width");
        assert_eq(_has(m, n, "\\-\\-pad"), 1, "--pad");
        assert_eq(_has(m, n, "\\-\\-color"), 1, "--color");
        assert_eq(_has(m, n, "\\-\\-list\\-fonts"), 1, "--list-fonts");
        assert_eq(_has(m, n, "\\-\\-version"), 1, "--version");
        assert_eq(_has(m, n, "\\-\\-help"), 1, "--help");
        assert_eq(_has(m, n, ".B \\-\\-\n"), 1, "the -- terminator");
        assert_eq(_has(m, n, "BNRMR_FONTS"), 1, "BNRMR_FONTS");
        assert_eq(_has(m, n, "COLUMNS"), 1, "COLUMNS");
        assert_eq(_has(m, n, ".SH EXIT STATUS"), 1, "exit status");
        assert_eq(_has(m, n, "share/bannermanor/fonts"), 1, "the install directory");
        fl_free(m);
    }
}

# Every flag the parser registers must appear in --help, and so must the
# `--` terminator (1.4.1). A doc-drift check, not a byte check: the exact
# bytes are the golden snapshot tier's job.
fn t_cli_usage_names_every_flag() {
    test_group("cli / --help names every flag");
    #ifdef CYRIUS_TARGET_LINUX
    var rd = 0;
    var wr = 0;
    var buf = alloc(8192);
    var saved = _cap_begin(&rd, &wr);
    if (saved >= 0) {
        print_usage();
        var n = _cap_end(saved, rd, wr, buf, 8192);
        assert(n > 0, "usage printed");
        assert_eq(_has(buf, n, "-f, --font"), 1, "--font / -f");
        assert_eq(_has(buf, n, "--align"), 1, "--align");
        assert_eq(_has(buf, n, "-w, --width"), 1, "--width / -w");
        assert_eq(_has(buf, n, "--pad"), 1, "--pad");
        assert_eq(_has(buf, n, "--color"), 1, "--color");
        assert_eq(_has(buf, n, "--list-fonts"), 1, "--list-fonts");
        assert_eq(_has(buf, n, "--version"), 1, "--version");
        assert_eq(_has(buf, n, "-h, --help"), 1, "--help / -h");
        assert_eq(_has(buf, n, "  --  "), 1, "the -- terminator");
        assert_eq(_has(buf, n, "bright-<name>"), 1, "the bright- dash form");
    }
    #endif
}

# ---- 1.5.0: checked writes (issue 0009) and stderr (issue 0016) ----

# _emit with fd 1 on /dev/full: the write fails ENOSPC, the failure is
# recorded, nothing after it is attempted, and render_layout says so.
# Resets the process-wide flag afterwards: the rest of the suite writes.
fn t_emit_checked() {
    test_group("layout / _emit checks write(2) (issue 0009)");
    #ifdef CYRIUS_TARGET_LINUX
    var full = sys_open("/dev/full", O_WRONLY, 0);
    assert(full >= 0, "/dev/full opened");
    if (full >= 0) {
        var saved = _pt_redirect(full);
        var r1 = _emit("x", 1);
        var failed = out_failed();
        var r2 = _emit("y", 1);
        var rl = render_layout(block_font_embed(), "HI", 2, 0, ALIGN_LEFT, 0, COLOR_NONE);
        var why = write_error_text();
        _pt_restore(saved);
        sys_close(full);
        _out_err = 0;
        assert_eq(r1, 0 - 1, "a failed write returns -1");
        assert_eq(failed, 1, "out_failed() after a failed write");
        assert_eq(r2, 0 - 1, "and every write after it fails without trying");
        assert_eq(rl, 0 - 4, "render_layout -> -4 on a failed write");
        assert_eq(streq(why, "bnrmr: write error: no space left on device"), 1, "ENOSPC named");
    }
    var dn = sys_open("/dev/null", O_WRONLY, 0);
    if (dn >= 0) {
        var saved2 = _pt_redirect(dn);
        var big = alloc(200000);
        memset(big, 65, 200000);
        var r3 = _emit(big, 200000);
        var ok = out_failed();
        _pt_restore(saved2);
        sys_close(dn);
        _out_err = 0;
        assert_eq(r3, 0, "a large write to /dev/null succeeds");
        assert_eq(ok, 0, "no failure recorded");
    }
    assert_eq(out_failed(), 0, "flag reset for the rest of the suite");
    #endif
}

fn t_write_error_text() {
    test_group("layout / write_error_text");
    _out_err = 0 - 28;
    assert_eq(streq(write_error_text(), "bnrmr: write error: no space left on device"), 1, "ENOSPC");
    _out_err = 0 - 9;
    assert_eq(streq(write_error_text(), "bnrmr: write error: stdout is not open"), 1, "EBADF");
    _out_err = 0 - 5;
    assert_eq(streq(write_error_text(), "bnrmr: write error: I/O error"), 1, "EIO");
    _out_err = 0 - 1;
    assert_eq(streq(write_error_text(), "bnrmr: write error"), 1, "anything else: the bare line");
    _out_err = 0;
}

# _emit_line / _err_line: one write with the newline when it fits, two
# when it does not; _err_line and print_usage_err go to fd 2.
fn t_line_writers() {
    test_group("layout / _emit_line, _err_line, print_usage_err");
    #ifdef CYRIUS_TARGET_LINUX
    var rd = 0;
    var wr = 0;
    var buf = alloc(8192);
    var long = alloc(400);
    memset(long, 66, 300);
    store8(long + 300, 0);
    var saved = _cap_begin(&rd, &wr);
    if (saved >= 0) {
        _emit_line("short");
        _emit_line(long);
        var n = _cap_end(saved, rd, wr, buf, 8192);
        assert_eq(n, 6 + 301, "short + newline, 300-byte line + newline");
        assert_eq(memeq(buf, "short\n", 6), 1, "short line");
        assert_eq(load8(buf + 306), 10, "long line ends in a newline");
    }
    saved = _cap_begin_fd(2, &rd, &wr);
    if (saved >= 0) {
        _err_line("bnrmr: oops");
        print_usage_err();
        var m = _cap_end_fd(2, saved, rd, wr, buf, 8192);
        assert_eq(memeq(buf, "bnrmr: oops\n", 12), 1, "_err_line on stderr");
        assert_eq(_has(buf, m, "Usage:"), 1, "print_usage_err on stderr");
    }
    assert_eq(out_failed(), 0, "stderr writes never touch the stdout failure flag");
    #endif
}

# Non-TTY stdout: both probes say "not a terminal". The Linux contract
# that keeps `bnrmr ... | cat` untruncated and uncolored.
fn t_probes_non_tty() {
    test_group("layout / probes on a non-TTY stdout (darshana tty_winsize)");
    #ifdef CYRIUS_TARGET_LINUX
    var w = 0 - 9;
    var t = 0 - 9;
    var dn = sys_open("/dev/null", O_RDWR, 0);
    assert(dn >= 0, "/dev/null opened");
    if (dn >= 0) {
        var rc = _pt_probe(dn, &w, &t);
        sys_close(dn);
        assert_eq(rc, 0, "fd 1 redirected to /dev/null");
        assert_eq(w, 0, "/dev/null: term_width_ioctl -> 0");
        assert_eq(t, 0, "/dev/null: stdout_is_tty -> 0");
    }
    var fds[16];
    assert_eq(sys_pipe(&fds), 0, "pipe created");
    var rd = load32(&fds);
    var wr = load32(&fds + 4);
    w = 0 - 9;
    t = 0 - 9;
    var rc2 = _pt_probe(wr, &w, &t);
    sys_close(rd);
    sys_close(wr);
    assert_eq(rc2, 0, "fd 1 redirected to a pipe");
    assert_eq(w, 0, "pipe: term_width_ioctl -> 0");
    assert_eq(t, 0, "pipe: stdout_is_tty -> 0");
    #endif
}

# A real terminal on fd 1, at window sizes we set. Pins F-008 (clamp),
# F-020 (a 0-column pty is not a TTY — where darshana's tty_isatty would
# answer 1), and that only the COLUMN count matters (where
# tty_winsize_or would call a 0-row terminal "size unknown").
fn t_probes_pty() {
    test_group("layout / probes on a pty (darshana tty_winsize)");
    #ifdef CYRIUS_TARGET_LINUX
    var m = 0;
    var s = 0;
    if (_pt_open(&m, &s) != 0) {
        println("SKIP layout probes on a pty: /dev/ptmx unavailable");
        return 0;
    }
    # rows, cols, want width, want tty
    var cases[224];                     # 7 cases x 4 i64
    store64(&cases + 0,   24);  store64(&cases + 8,   80);   store64(&cases + 16,  80);   store64(&cases + 24,  1);
    store64(&cases + 32,  0);   store64(&cases + 40,  80);   store64(&cases + 48,  80);   store64(&cases + 56,  1);
    store64(&cases + 64,  0);   store64(&cases + 72,  0);    store64(&cases + 80,  0);    store64(&cases + 88,  0);
    store64(&cases + 96,  24);  store64(&cases + 104, 0);    store64(&cases + 112, 0);    store64(&cases + 120, 0);
    store64(&cases + 128, 24);  store64(&cases + 136, 1);    store64(&cases + 144, 1);    store64(&cases + 152, 1);
    store64(&cases + 160, 50);  store64(&cases + 168, 5000); store64(&cases + 176, 4096); store64(&cases + 184, 1);
    store64(&cases + 192, 24);  store64(&cases + 200, 4096); store64(&cases + 208, 4096); store64(&cases + 216, 1);
    var k = 0;
    while (k < 7) {
        var base = &cases + k * 32;
        var w = 0 - 9;
        var t = 0 - 9;
        var setrc = _pt_set_winsize(s, load64(base), load64(base + 8));
        var prc = _pt_probe(s, &w, &t);
        assert_eq(setrc, 0, "TIOCSWINSZ on the slave");
        assert_eq(prc, 0, "fd 1 redirected to the pty slave");
        assert_eq(w, load64(base + 16), "term_width_ioctl on the pty");
        assert_eq(t, load64(base + 24), "stdout_is_tty on the pty");
        k = k + 1;
    }
    sys_close(s);
    sys_close(m);
    #endif
}

# What the probes decide, end to end: render_layout on a pty against
# the same render on a pipe. Exact bytes, so this also pins darshana's
# SGR emission on the TTY path — never checked before 1.2.0.
fn t_render_pty_vs_pipe() {
    test_group("layout / render on a pty vs a pipe");
    #ifdef CYRIUS_TARGET_LINUX
    var m = 0;
    var s = 0;
    if (_pt_open(&m, &s) != 0) {
        println("SKIP render on a pty: /dev/ptmx unavailable");
        return 0;
    }
    assert_eq(tty_raw(s), 0, "slave raw (no OPOST: bytes arrive as written)");
    var f = block_font_embed();
    var p = alloc(4096);
    var q = alloc(4096);
    var e = alloc(4096);

    # 24x80, --color red: every row wrapped ESC[31m ... ESC[0m.
    var pn = _pt_render_pipe(p, 4096, f, "hi", 2, 0, ALIGN_LEFT, COLOR_NONE);
    assert_eq(pn, 60, "pipe: 'hi' plain = 5 rows x (11 cols + LF)");
    _pt_set_winsize(s, 24, 80);
    var qn = _pt_render_pty(m, s, q, 4096, f, "hi", 2, 0, ALIGN_LEFT, TTY_FG_RED);
    var en = _pt_expect_sgr(p, pn, e, TTY_FG_RED);
    assert_eq(_pt_same(q, qn, e, en), 1, "pty 24x80 --color red: plain rows wrapped in ESC[31m / ESC[0m");

    # Same pty, --color rainbow: the per-row cycle reaches the terminal.
    qn = _pt_render_pty(m, s, q, 4096, f, "hi", 2, 0, ALIGN_LEFT, COLOR_RAINBOW);
    en = _pt_expect_sgr(p, pn, e, 0);
    assert_eq(_pt_same(q, qn, e, en), 1, "pty 24x80 --color rainbow: rows 31/33/32/36/34");

    # 0-column pty: not a TTY (F-020) — no SGR, no truncation.
    _pt_set_winsize(s, 24, 0);
    qn = _pt_render_pty(m, s, q, 4096, f, "hi", 2, 0, ALIGN_LEFT, TTY_FG_RED);
    assert_eq(_pt_same(q, qn, p, pn), 1, "pty 24x0 --color red: byte-identical to the plain pipe render");

    # 11-column pty: issue 0004 truncation to 2 glyphs of "AGNOS".
    _pt_set_winsize(s, 24, 11);
    pn = _pt_render_pipe(p, 4096, f, "AG", 2, 0, ALIGN_LEFT, COLOR_NONE);
    qn = _pt_render_pty(m, s, q, 4096, f, "AGNOS", 5, 0, ALIGN_LEFT, COLOR_NONE);
    assert_eq(_pt_same(q, qn, p, pn), 1, "pty 24x11 'AGNOS': truncated to 'AG' at the glyph boundary");

    # Center on an 80-column pty == center in an explicit 80-col frame.
    _pt_set_winsize(s, 24, 80);
    pn = _pt_render_pipe(p, 4096, f, "hi", 2, 80, ALIGN_CENTER, COLOR_NONE);
    qn = _pt_render_pty(m, s, q, 4096, f, "hi", 2, 0, ALIGN_CENTER, COLOR_NONE);
    assert_eq(_pt_same(q, qn, p, pn), 1, "pty 24x80 --align center == pipe --width 80 --align center");

    tty_cooked();
    sys_close(s);
    sys_close(m);
    #endif
}

