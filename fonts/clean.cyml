# clean.cyml — BannerManor clean font (7×8), the first with lowercase.
#
# Schumacher "Clean" 7x8, from the X11 bitmap font clR7x8.bdf, the
# medium upright 8-pixel face of Dale Schumacher's Clean family. Full
# printable ASCII (32..126), 95 glyphs, with real lowercase: rows 0-6
# are the ascent and row 7 the descender (g j p q y , ; _).
#
# Provenance:
#   clR7x8.bdf  $XConsortium: clR7x8.bdf,v 1.2 94/04/11 12:08:41 gildea Exp $
#   -> clr7x8.flf, converted by bdf2flf (John Cowan), in the figlet font
#      collection (github.com/cmatsuoka/figlet-fonts, bdffonts/clr7x8.flf;
#      sha256 b2379dbd1d7f3eeacd6f0186c78de0e6a79a5104619d61e3a8664108f8d97e4c)
#   -> this file (BannerManor 1.8.0): glyphs 32..126 transcribed cell for
#      cell, '#' kept and ' ' written as '.'. The .flf cell is 8 columns,
#      of which column 8 is blank in every glyph; it is `gap = 1` here,
#      so the spacing is the original's. Nothing redrawn.
#
# License (SPDX HPND), reproduced as its terms require:
#
#   Copyright 1989 Dale Schumacher, dal@syntel.mn.org
#                  399 Beacon Ave.
#                  St. Paul, MN  55104-3527
#
#   Permission to use, copy, modify, and distribute this software and
#   its documentation for any purpose and without fee is hereby
#   granted, provided that the above copyright notice appear in all
#   copies and that both that copyright notice and this permission
#   notice appear in supporting documentation, and that the name of
#   Dale Schumacher not be used in advertising or publicity pertaining to
#   distribution of the software without specific, written prior
#   permission.  Dale Schumacher makes no representations about the
#   suitability of this software for any purpose.  It is provided "as
#   is" without express or implied warranty.
#
# Schema documented in docs/adr/0001-cyml-font-format.md. Body convention:
# '.' = background (rendered as space), '#' = stroke.

[font]
schema = 1
name = "clean"
description = "Schumacher Clean (X11 clR7x8): 8 rows tall, 7 cols wide. Real lowercase with descenders."
width = 7
height = 8
gap = 1
author = "Dale Schumacher (Schumacher Clean, X11 clR7x8); CYML transliteration by BannerManor"
license = "HPND"

