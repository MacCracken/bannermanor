# block.cyml — BannerManor block font (5×5).
#
# Canonical CYML font. Schema documented in docs/adr/0001-cyml-font-format.md.
# Body convention: '.' = background (rendered as space), '#' = stroke.
# Every glyph body is exactly 5 rows of exactly 5 bytes.

[font]
schema = 1
name = "block"
description = "BannerManor block font: 5 rows tall, 5 cols wide. Default font."
width = 5
height = 5
gap = 1
author = "BannerManor"
license = "GPL-3.0-only"

