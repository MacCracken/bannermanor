# slim.cyml — BannerManor slim font (4×5).
#
# Companion to block. Same height, one column narrower per glyph
# (5 char-cells per glyph at gap=1 vs block's 6) — useful when banner
# width matters and you want more text to fit. Schema documented in
# docs/adr/0001-cyml-font-format.md. Body convention: '.' = background
# (rendered as space), '#' = stroke.
#
# Coverage: full printable ASCII (32..126), 69 glyphs. Lowercase a-z
# folds to uppercase via the renderer's fold-fallback — no separate
# lowercase glyphs (4 cols is too narrow for legible distinct lowercase).

[font]
schema = 1
name = "slim"
description = "BannerManor slim font: 5 rows tall, 4 cols wide. Narrower companion to block."
width = 4
height = 5
gap = 1
author = "BannerManor"
license = "GPL-3.0-only"

